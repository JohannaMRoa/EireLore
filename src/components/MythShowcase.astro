---
const filters = ["All", "Heroes", "Creatures", "Spirits", "Places", "Gods", "Other"];

const myths = [
  {
    id: 1,
    title: "The Children of Lir",
    category: "Other",
    origin: "Mythological Cycle",
    summary: "Four siblings, transformed into swans by a cruel curse. A tragic tale of jealousy, endurance, and lost childhood.",
    link: "/ChildrenOfLir",
    image: "/myths/children-of-lir.jpeg",
    comingSoon: false,
    unlocked: true,
  },
  {
    id: 2,
    title: "The Giant's Causeway",
    category: "Heroes",
    origin: "Irish Folklore",
    summary: "An epic rivalry across the sea. A story of bravery, fear, and the colossal clash that created the Causeway.",
    link: "/GiantsCauseway",
    image: "/myths/giants-causeway.png",
    comingSoon: false,
    unlocked: true,
  },
  {
    id: 3,
    title: "The Banshee",
    category: "Spirits",
    origin: "Irish Folklore",
    summary: "A sorrowful spirit whose midnight cry is said to foretell death within a family.",
    link: "/Banshee",
    image: "/myths/banshee.jpeg",
    comingSoon: false,
    unlocked: true,
  },
  {
    id: 4,
    title: "Cú Chulainn",
    category: "Heroes",
    origin: "Ulster Cycle",
    summary: "A fierce young warrior remembered for his strength, loyalty, and tragic heroic fate.",
    link: "#",
    image: "/myths/coming-soon.jpeg",
    comingSoon: true,
    unlocked: true,
  },

  {
    id: 5,
    title: "Tír na nÓg",
    category: "Places",
    origin: "Fenian cycle",
    summary: "The legendary land of youth, beauty, and eternal life beyond the western sea.",
    link: "#",
    image: "/myths/coming-soon.jpeg",
    comingSoon: true,
    unlocked: true,
  },
  {
    id: 6,
    title: "The Púca",
    category: "Creatures",
    origin: "Irish Folklore",
    summary: "A mischievous shapeshifter known for tricks, omens, and strange encounters.",
    link: "#",
    image: "/myths/coming-soon.jpeg",
    comingSoon: true,
    unlocked: true,
  },


  {
    id: 7,
    title: "The Tuatha Dé Danann",
    category: "Gods",
    origin: "Mythological Cycle",
    summary: "A supernatural people of magic, wisdom, and ancient power in Irish mythology.",
    link: "#",
    image: "/myths/coming-soon.jpeg",
    comingSoon: true,
    unlocked: true,
  },
  {
    id: 8,
    title: "The Salmon of Knowledge",
    category: "Creatures",
    origin: "Fenian cycle",
    summary: "A magical salmon said to contain all the wisdom of the world.",
    link: "#",
    image: "/myths/coming-soon.jpeg",
    comingSoon: true,
    unlocked: true,
  },
  {
    id: 9,
    title: "The Salmon of Knowledge",
    category: "Creatures",
    origin: "Fenian cycle",
    summary: "A magical salmon said to contain all the wisdom of the world.",
    link: "#",
    image: "/myths/coming-soon.jpeg",
    comingSoon: true,
    unlocked: false,
  },
  {
    id: 10,
    title: "The Salmon of Knowledge",
    category: "Creatures",
    origin: "Fenian cycle",
    summary: "A magical salmon said to contain all the wisdom of the world.",
    link: "#",
    image: "/myths/coming-soon.jpeg",
    comingSoon: true,
    unlocked: false,
  },
  {
    id: 11,
    title: "The Salmon of Knowledge",
    category: "Creatures",
    origin: "Fenian cycle",
    summary: "A magical salmon said to contain all the wisdom of the world.",
    link: "#",
    image: "/myths/coming-soon.jpeg",
    comingSoon: true,
    unlocked: false,
  },
  {
    id: 12,
    title: "The Salmon of Knowledge",
    category: "Creatures",
    origin: "Fenian cycle",
    summary: "A magical salmon said to contain all the wisdom of the world.",
    link: "#",
    image: "/myths/coming-soon.jpeg",
    comingSoon: true,
    unlocked: false,
  },
];
---

<section class="myths-page px-6 pt-32 pb-24 md:px-10">
  <div class="mx-auto max-w-7xl">

    <div class="section-header mb-16 text-center">
      <div class="section-divider-line"></div>

      <p class="section-eyebrow">The Collection</p>

      <h1 class="section-title">
        Choose Your <span class="accent">Legend</span>
      </h1>

      <p class="mx-auto mt-5 max-w-2xl font-[var(--font-body)] text-base leading-relaxed text-sand/65">
        Explore Irish myths, legendary creatures, heroic tales, and ancient stories
        brought together as part of the Éire Lore experience.
      </p>
    </div>

    <!-- Filters -->
    <div class="myth-filters">
      {filters.map((filter) => (
        <button class="myth-filter-btn" data-filter={filter}>
          {filter}
        </button>
      ))}
    </div>

    <!-- Cards -->
    <div class="myths-grid">
      {myths.map((myth) => (
        <article
  class={`myth-flip-card 
  ${myth.comingSoon ? "is-coming-soon" : ""}
  ${!myth.unlocked ? "is-locked" : ""}`}
  data-category={myth.category}
>
  <div class="myth-flip-inner">

    <!-- Front -->
    <div class="myth-card-face myth-card-front">
      <img src={myth.image} alt={myth.title} />

      <div class="myth-front-overlay"></div>

      {myth.comingSoon && (
        <div class="coming-soon-label">
          Coming Soon
        </div>
      )}

      {myth.comingSoon && myth.unlocked && (
        <div class="myth-lock-icon myth-lock-icon-open">
          <svg  class="lock-svg" xmlns="http://www.w3.org/2000/svg" width="46" height="46" viewBox="0 0 256 256" fill="currentColor">
            <path d="M208,80H96V56a32,32,0,0,1,32-32c15.37,0,29.2,11,32.16,25.59a8,8,0,0,0,15.68-3.18C171.32,24.15,151.2,8,128,8A48.05,48.05,0,0,0,80,56V80H48A16,16,0,0,0,32,96V208a16,16,0,0,0,16,16H208a16,16,0,0,0,16-16V96A16,16,0,0,0,208,80Zm0,128H48V96H208V208Zm-80-96a28,28,0,0,0-8,54.83V184a8,8,0,0,0,16,0V166.83A28,28,0,0,0,128,112Zm0,40a12,12,0,1,1,12-12A12,12,0,0,1,128,152Z"/>
          </svg>
        </div>
      )}

      {!myth.unlocked && (
        <div class="myth-lock-icon myth-lock-icon-closed">
          <svg  class="lock-svg" xmlns="http://www.w3.org/2000/svg" width="52" height="52" viewBox="0 0 256 256" fill="currentColor">
            <path d="M128,112a28,28,0,0,0-8,54.83V184a8,8,0,0,0,16,0V166.83A28,28,0,0,0,128,112Zm0,40a12,12,0,1,1,12-12A12,12,0,0,1,128,152Zm80-72H176V56a48,48,0,0,0-96,0V80H48A16,16,0,0,0,32,96V208a16,16,0,0,0,16,16H208a16,16,0,0,0,16-16V96A16,16,0,0,0,208,80ZM96,56a32,32,0,0,1,64,0V80H96ZM208,208H48V96H208V208Z"/>
          </svg>
        </div>
      )}

      {!myth.comingSoon && (
        <div class="myth-front-content">
          <p>{myth.origin}</p>
          <h2>{myth.title}</h2>
        </div>
      )}
    </div>

    <!-- Back -->
    <div class="myth-card-face myth-card-back">
      <p class="myth-origin">{myth.origin}</p>

      <h2>{myth.title}</h2>

      <p class="myth-summary">
        {myth.summary}
      </p>

      {myth.comingSoon ? (
        <span class="myth-link myth-link-disabled">
          Coming Soon
        </span>
      ) : (
        <a href={myth.link} class="myth-link">
          Full story
          <span>→</span>
        </a>
      )}
    </div>

  </div>
</article>
      ))}
    </div>

  </div>
</section>

<style>


  .section-eyebrow {
    font-family: var(--font-body);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--color-gold);
  }

  .section-title {
    margin-top: 0.7rem;
    font-family: var(--font-title);
    font-weight: 700;
    font-size: clamp(2.2rem, 4.5vw, 3.2rem);
    line-height: 1.1;
    color: var(--color-sand);
  }

  .accent {
    font-style: italic;
    color: var(--color-gold);
  }

  .myth-filters {
    margin: 0 auto 3rem;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .myth-filter-btn {
    border: 1px solid rgba(216, 169, 27, 0.25);
    border-radius: 999px;
    background: rgba(0, 44, 35, 0.35);
    padding: 0.55rem 1rem;
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(241, 210, 152, 0.75);
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .myth-filter-btn:hover,
  .myth-filter-btn.is-active {
    background: var(--color-gold);
    color: var(--color-dark);
    border-color: var(--color-gold);
  }

  .myths-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem;
  }
  .myth-flip-card {
    aspect-ratio: 1 / 1.15;
    perspective: 1200px;
    -webkit-perspective: 1200px;
    transform-style: preserve-3d;
    -webkit-transform-style: preserve-3d;
    cursor: pointer;
  }

  .myth-flip-inner {
    position: relative;
    height: 100%;
    transform-style: preserve-3d;
    -webkit-transform-style: preserve-3d;
    transition: transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }

  .myth-flip-card:not(.is-locked):hover .myth-flip-inner,
  .myth-flip-card.is-flipped .myth-flip-inner {
  transform: rotateY(180deg);
  -webkit-transform: rotateY(180deg);
}

  .myth-card-face {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: 1.45rem;
    border: 1px solid rgba(216, 169, 27, 0.16);
    background: rgba(0, 44, 35, 0.55);
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    transform-style: preserve-3d;
    -webkit-transform-style: preserve-3d;
    box-shadow: 0 20px 48px -28px rgba(0, 0, 0, 0.6);
  }

  .myth-card-front {
    transform: rotateY(0deg);
    -webkit-transform: rotateY(0deg);
  }

  .myth-card-back {
    transform: rotateY(180deg);
    -webkit-transform: rotateY(180deg);
    padding: 1.4rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .myth-card-front img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    transform: translateZ(0);
    -webkit-transform: translateZ(0);
  }

  .myth-flip-card:hover .myth-card-front img {
    transform: scale(1.04) translateZ(0);
    -webkit-transform: scale(1.04) translateZ(0);
  }

  .myth-front-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0, 44, 35, 0.95),
      rgba(0, 44, 35, 0.15),
      transparent
    );
    transform: translateZ(1px);
    -webkit-transform: translateZ(1px);
  }

  .myth-front-content {
    position: absolute;
    left: 1.2rem;
    right: 1.2rem;
    bottom: 1.2rem;
    z-index: 3;
    transform: translateZ(2px);
    -webkit-transform: translateZ(2px);
  }

  .myth-front-content p,
  .myth-origin {
    font-family: var(--font-body);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-gold);
  }

  .myth-front-content h2,
  .myth-card-back h2 {
    margin-top: 0.5rem;
    font-family: var(--font-title);
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    font-weight: 700;
    line-height: 1.05;
    color: var(--color-sand);
  }

  .myth-summary {
    margin-top: 1rem;
    font-family: var(--font-body);
    font-size: 0.88rem;
    line-height: 1.65;
    color: rgba(241, 210, 152, 0.72);
  }

  .myth-link {
    margin-top: 1.4rem;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-gold);
    text-decoration: none;
    transition: color 0.25s ease, gap 0.25s ease;
  }

  .myth-link:hover {
    color: var(--color-sand);
    gap: 0.75rem;
  }

  .myth-link-disabled {
    opacity: 0.55;
    cursor: default;
  }

  .is-coming-soon .myth-card-front img {
    filter: blur(4px) brightness(0.65);
    transform: scale(1.04) translateZ(0);
    -webkit-transform: scale(1.04) translateZ(0);
  }

  .coming-soon-label {
    position: absolute;
    inset: 0;
    z-index: 4;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-gold);
    background: rgba(0, 44, 35, 0.25);
    transform: translateZ(3px);
    -webkit-transform: translateZ(3px);
  }

  @media (max-width: 1100px) {
    .myths-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 780px) {
    .myths-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 520px) {
    .myths-grid {
      grid-template-columns: 1fr;
    }
  }

  .myth-lock-icon {
  position: absolute;
  inset: 0;
  z-index: 8;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-gold);
  pointer-events: none;
  transform: translateY(-2.4rem) translateZ(5px);
  -webkit-transform: translateY(-2.4rem) translateZ(5px);
}

.myth-lock-icon-open {
  opacity: 0.85;
}

.myth-lock-icon-closed {
  opacity: 0.95;
}

.is-locked {
  cursor: not-allowed;
}

.lock-svg {
  width: 2.2rem;
  height: 2.2rem;
}

.is-locked .myth-card-front img {
  filter: blur(5px) brightness(0.45);
}
</style>

<script>
  const filterButtons = document.querySelectorAll(".myth-filter-btn");
  const mythCards = document.querySelectorAll(".myth-flip-card");

  filterButtons[0]?.classList.add("is-active");

  filterButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const selected = button.dataset.filter;

      filterButtons.forEach((btn) => btn.classList.remove("is-active"));
      button.classList.add("is-active");

      mythCards.forEach((card) => {
        const category = card.dataset.category;

        card.classList.remove("is-flipped");

        if (selected === "All" || category === selected) {
          card.style.display = "block";
        } else {
          card.style.display = "none";
        }
      });
    });
  });

mythCards.forEach((card) => {
  card.addEventListener("click", (e) => {

    if (e.target.closest("a")) return;


    if (card.classList.contains("is-locked")) return;

    card.classList.toggle("is-flipped");
  });
});
</script>