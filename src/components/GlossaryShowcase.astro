    link: "/ChildrenOfLir"
  },
  {
    term: "Aodh",
    pronunciation: "AY",
    meaning: "One of the three sons of Lir transformed into a swan. His name means 'fire'. He was the elder of the three brothers.",
    related_story: "Children of Lir",
    link: "/ChildrenOfLir"
  },
  {
    term: "Fiachra",
    pronunciation: "FEE-a-khra",
    meaning: "One of the twin sons of Lir, transformed into a swan for 900 years alongside his siblings. His name is possibly derived from 'fiach' meaning 'raven'.",
    related_story: "Children of Lir",
    link: "/ChildrenOfLir"
  },
  {
    term: "Conn",
    pronunciation: "KON",
    meaning: "The youngest of the four Children of Lir. One of the twin sons transformed into a swan by their stepmother Aoife.",
    related_story: "Children of Lir",
    link: "/ChildrenOfLir"
  },
  {
    term: "Aoibh",
    pronunciation: "EEV",
    meaning: "The first wife of Lir and beloved mother of his four children. She died after the birth of the twins Fiachra and Conn.",
    related_story: "Children of Lir",
    link: "/ChildrenOfLir"
  },
  {
    term: "Bodb Derg",
    pronunciation: "BOV derg",
    meaning: "High King of the Tuatha Dé Danann and father of both Aoibh and Aoife. When he discovered Aoife's treachery, he cursed her to become a demon of the air for eternity.",
    related_story: "Children of Lir",
    link: "/ChildrenOfLir"
  },
  {
    term: "Lough Dairbhreach",
    pronunciation: "lokh DAR-vrakh",
    meaning: "Lake of the Oaks — the first of three locations where the Children of Lir spent 300 years of their enchantment, located near Mullingar.",
    related_story: "Children of Lir",
    link: "/ChildrenOfLir"
  },

  // BANSHEE
  {
    term: "Bean Sí",
    pronunciation: "ban SHEE",
    meaning: "Woman of the Fairy Mound — the Irish name for the Banshee, a female spirit whose mournful wail heralds the death of a member of an ancient Irish family.",
    related_story: "The Banshee",
    link: "/Banshee"
  },
  {
    term: "Caoineadh",
    pronunciation: "KEEN-ya",
    meaning: "To weep, to wail. The mournful funeral lament traditionally sung by women at Irish wakes, closely linked to the cry of the Banshee.",
    related_story: "The Banshee",
    link: "/Banshee"
  },
  {
    term: "Clíodhna",
    pronunciation: "KLEE-o-na",
    meaning: "A principal goddess and queen of the Tuatha Dé Danann, sometimes described as Queen of the Banshees and a guardian spirit connected to certain Irish families.",
    related_story: "The Banshee",
    link: "/Banshee"
  },
  {
    term: "Sídhe",
    pronunciation: "SHEE",
    meaning: "The fairy mounds or fairy folk of Irish mythology. Ancient burial mounds across the Irish countryside were believed to be entrances to the Otherworld, home of the Tuatha Dé Danann.",
    related_story: "The Banshee",
    link: "/Banshee"
  },

  // GIANT'S CAUSEWAY
  {
    term: "Oonagh",
    pronunciation: "OO-na",
    meaning: "The clever wife of Fionn mac Cumhaill. In the Giant's Causeway legend, she saved her husband by disguising him as an enormous baby, tricking Benandonner into fleeing Scotland.",
    related_story: "Giant's Causeway",
    link: "/GiantsCauseway"
  },
  {
    term: "Benandonner",
    pronunciation: "ben-AN-don-er",
    meaning: "The fearsome Scottish giant who challenged Fionn mac Cumhaill to battle. His name means 'Mountain of Thunder'. He fled back to Scotland after being tricked by Fionn's wife.",
    related_story: "Giant's Causeway",
    link: "/GiantsCauseway"
  },
  {
    term: "Lough Neagh",
    pronunciation: "lokh NAY",
    meaning: "Ireland's largest lake, said to have been created when Fionn mac Cumhaill scooped up a massive chunk of earth and hurled it at Benandonner, leaving a great hollow that filled with water.",
    related_story: "Giant's Causeway",
    link: "/GiantsCauseway"
  },

  // CÚ CHULAINN
  {
    term: "Sétanta",
    pronunciation: "SHAY-dan-ta",
    meaning: "The birth name of Cú Chulainn. As a child, he killed the fierce guard dog of the smith Culann and offered to take its place, earning his legendary name.",
    related_story: "Cú Chulainn",
    link: "#"
  },
  {
    term: "Conchobar mac Nessa",
    pronunciation: "KON-a-var mac NESS-a",
    meaning: "The King of Ulster and maternal uncle of Cú Chulainn. A powerful ruler who oversaw the great warriors of the Red Branch, he played a central role in the Ulster Cycle.",
    related_story: "Cú Chulainn",
    link: "#"
  },
  {
    term: "Scáthach",
    pronunciation: "SKAW-hakh",
    meaning: "The Shadow — a legendary female warrior who ran a school for heroes on the Isle of Skye (Dún Scáith). She trained Cú Chulainn in all the arts of war and gifted him the Gáe Bulg.",
    related_story: "Cú Chulainn",
    link: "#"
  },
  {
    term: "Emer",
    pronunciation: "EE-ver",
    meaning: "The wife of Cú Chulainn and daughter of the chieftain Forgall Monach. She was renowned for her beauty, wisdom, and fierce loyalty to her husband.",
    related_story: "Cú Chulainn",
    link: "#"
  },
  {
    term: "Gáe Bulg",
    pronunciation: "GAY BUL-og",
    meaning: "Spear of Death — the terrible barbed spear gifted to Cú Chulainn by Scáthach. Made from the bones of a sea monster, it created thirty wounds upon entering the body and could never be pulled out.",
    related_story: "Cú Chulainn",
    link: "#"
  },
  {
    term: "Ríastrad",
    pronunciation: "REE-as-trad",
    meaning: "The warp spasm or battle frenzy — a terrifying transformation that overtook Cú Chulainn in battle, twisting his body into a monstrous shape that knew neither friend nor foe.",
    related_story: "Cú Chulainn",
    link: "#"
  },
  {
    term: "Táin Bó Cúailnge",
    pronunciation: "TAWN boh KOO-lin-ya",
    meaning: "The Cattle Raid of Cooley — the greatest epic of the Ulster Cycle, in which Cú Chulainn single-handedly defended Ulster against the armies of Queen Medb of Connacht.",
    related_story: "Cú Chulainn",
    link: "#"
  },
  {
    term: "Medb",
    pronunciation: "MAYV",
    meaning: "The powerful and ruthless Queen of Connacht. She launched the invasion of Ulster to seize the great Brown Bull of Cooley, setting off the epic Táin Bó Cúailnge.",
    related_story: "Cú Chulainn",
    link: "#"
  },
  {
    term: "Ferdiad",
    pronunciation: "FER-dee-ad",
    meaning: "Cú Chulainn's closest foster brother and fellow trainee under Scáthach. Tragically manipulated by Medb into fighting his best friend, their three-day duel became one of Irish mythology's most heartbreaking episodes.",
    related_story: "Cú Chulainn",
    link: "#"
  },
  {
    term: "Emain Macha",
    pronunciation: "EV-in MAH-kha",
    meaning: "The great royal fort and seat of the Kings of Ulster, today known as Navan Fort in County Armagh. Cú Chulainn spent much of his youth and warrior life here.",
    related_story: "Cú Chulainn",
    link: "#"
  },
  {
    term: "Deichtine",
    pronunciation: "DEK-ti-neh",
    meaning: "The mortal mother of Cú Chulainn and sister of King Conchobar mac Nessa. According to legend, the god Lugh was his divine father.",
    related_story: "Cú Chulainn",
    link: "#"
  },
  {
    term: "Láeg",
    pronunciation: "LAY",
    meaning: "The loyal charioteer and trusted companion of Cú Chulainn. He drove the hero's chariot into battle and was one of the few who remained by his side throughout his legendary feats.",
    related_story: "Cú Chulainn",
    link: "#"
  },
  {
    term: "Liath Macha",
    pronunciation: "LEE-a MAH-kha",
    meaning: "The Grey of Macha — one of Cú Chulainn's two magical horses, said to be a supernatural being. On the day of his death, the horse shed tears of blood.",
    related_story: "Cú Chulainn",
    link: "#"
  },
  {
    term: "Dún Scáith",
    pronunciation: "DOON SKAW",
    meaning: "Fortress of Shadows — the impregnable stronghold of the warrior-woman Scáthach on the Isle of Skye, where Cú Chulainn went to receive his martial training.",
    related_story: "Cú Chulainn",
    link: "#"
  },

  // TÍR NA NÓG
  {
    term: "Oisín",
    pronunciation: "UH-sheen",
    meaning: "Son of Fionn mac Cumhaill and legendary poet-warrior of the Fianna. He fell in love with Niamh and spent 300 years in Tír na nÓg, returning only to find his whole world gone.",
    related_story: "Tír na nÓg",
    link: "#"
  },
  {
    term: "Niamh Chinn Óir",
    pronunciation: "NEEV hin OR",
    meaning: "Niamh of the Golden Hair — a queen of Tír na nÓg and daughter of Manannán mac Lir. She crossed the sea on her magical white horse to find and bring Oisín to the Land of Eternal Youth.",
    related_story: "Tír na nÓg",
    link: "#"
  },
  {
    term: "Embarr",
    pronunciation: "EM-bar",
    meaning: "The magical white horse of Niamh, able to gallop across the surface of the sea. She lent it to Oisín to return to Ireland, warning him never to let his feet touch the ground.",
    related_story: "Tír na nÓg",
    link: "#"
  },
  {
    term: "Manannán mac Lir",
    pronunciation: "MAN-a-nawn mac LEER",
    meaning: "The great god of the sea and ruler of the Otherworld. Father of Niamh and keeper of Tír na nÓg. He often travelled on a magical horse across the waves and granted safe passage to the dead.",
    related_story: "Tír na nÓg",
    link: "#"
  },
  {
    term: "Fianna",
    pronunciation: "FEE-a-na",
    meaning: "The legendary band of Irish warrior-hunters led by Fionn mac Cumhaill, who defended Ireland from supernatural threats and foreign invaders during the third century.",
    related_story: "Tír na nÓg",
    link: "#"
  },
  {
    term: "Gleann na Smol",
    pronunciation: "GLAN na SMULL",
    meaning: "Valley of the Thrushes — the valley through which Oisín passed on his return to Ireland, where he encountered men struggling with a stone and fell from his horse.",
    related_story: "Tír na nÓg",
    link: "#"
  },

  // THE PÚCA
  {
    term: "Púca",
    pronunciation: "POO-ka",
    meaning: "A mischievous shapeshifting spirit of Irish folklore, feared as the most troublesome of the fairy folk. It can take the form of a black horse, goat, hare, dog, or goblin, always with jet-black fur.",
    related_story: "The Púca",
    link: "#"
  },

  // THE TUATHA DÉ DANANN
  {
    term: "Tuatha Dé Danann",
    pronunciation: "TOO-a-ha day DAN-un",
    meaning: "Tribe of the Goddess Danu — the supernatural divine race who ruled Ireland before the arrival of the Gaels. Masters of magic, wisdom, and craftsmanship, they later retreated underground into the fairy mounds.",
    related_story: "The Tuatha Dé Danann",
    link: "#"
  },
  {
    term: "Dagda",
    pronunciation: "DAH-da",
    meaning: "The Good God — the supreme chieftain of the Tuatha Dé Danann. A mighty warrior, druid, and harper, he owned a cauldron that could feed an entire army and a magical club that could kill or restore life.",
    related_story: "The Tuatha Dé Danann",
    link: "#"
  },
  {
    term: "Lugh",
    pronunciation: "LOO",
    meaning: "Lugh of the Long Arm — the solar hero-god of the Tuatha Dé Danann, master of all crafts and skills. He led his people to victory against the Fomorians and is the divine father of Cú Chulainn.",
    related_story: "The Tuatha Dé Danann",
    link: "#"
  },
  {
    term: "An Morrígan",
    pronunciation: "an MOR-ee-gan",
    meaning: "The Great Queen or Phantom Queen — the fearsome goddess of war, fate, and death. A shapeshifter who often appeared as a crow over battlefields, she could bring victory or doom to warriors.",
    related_story: "The Tuatha Dé Danann",
    link: "#"
  },
  {
    term: "Nuada Airgetlám",
    pronunciation: "NOO-a-da AR-get-lawv",
    meaning: "Nuada of the Silver Arm — the first king of the Tuatha Dé Danann. After losing his arm in battle, a magical silver limb was crafted for him, allowing him to reclaim his throne.",
    related_story: "The Tuatha Dé Danann",
    link: "#"
  },
  {
    term: "Brigid",
    pronunciation: "BREED",
    meaning: "Daughter of the Dagda and beloved goddess of poetry, fire, healing, and craftsmanship. Her festival Imbolc marks the beginning of spring. Her legacy later merged with the Christian Saint Brigid.",
    related_story: "The Tuatha Dé Danann",
    link: "#"
  },
  {
    term: "Aengus Óg",
    pronunciation: "ANG-us OHG",
    meaning: "The Young Son — the god of love, youth, and poetry among the Tuatha Dé Danann. Charming and passionate, he was son of the Dagda and resided at Newgrange on the River Boyne.",
    related_story: "The Tuatha Dé Danann",
    link: "#"
  },
  {
    term: "Fomorians",
    pronunciation: "fo-MOR-ee-ans",
    meaning: "A race of monstrous, primordial beings who represented the destructive forces of nature. Ancient enemies of the Tuatha Dé Danann, they were finally defeated at the Second Battle of Mag Tuired.",
    related_story: "The Tuatha Dé Danann",
    link: "#"
  },
  {
    term: "Balor",
    pronunciation: "BAH-lor",
    meaning: "The last and most terrifying king of the Fomorians, whose single eye could kill anyone it looked upon. He was eventually slain by his own grandson, the hero-god Lugh.",
    related_story: "The Tuatha Dé Danann",
    link: "#"
  },
  {
    term: "Dian Cécht",
    pronunciation: "DEE-an KAYKT",
    meaning: "The master healer of the Tuatha Dé Danann. He crafted Nuada's silver arm and possessed the Well of Health (Slane), which could revive the dead.",
    related_story: "The Tuatha Dé Danann",
    link: "#"
  },
  {
    term: "Mag Tuired",
    pronunciation: "MAH TEER-ad",
    meaning: "Plain of Pillars — the legendary battlefield where the Tuatha Dé Danann fought two great battles: first against the Fir Bolg, then against the Fomorians.",
    related_story: "The Tuatha Dé Danann",
    link: "#"
  },
  {
    term: "Lia Fáil",
    pronunciation: "LEE-a FAWL",
    meaning: "Stone of Destiny — one of the four great treasures of the Tuatha Dé Danann. Said to cry out when the rightful High King of Ireland stood upon it. Still said to reside on the Hill of Tara.",
    related_story: "The Tuatha Dé Danann",
    link: "#"
  },
  {
    term: "Tara",
    pronunciation: "TAR-a",
    meaning: "The sacred Hill of Tara in County Meath — the ancient seat of the High Kings of Ireland and spiritual heart of the land, home to the Lia Fáil and site of great assemblies.",
    related_story: "The Tuatha Dé Danann",
    link: "#"
  },

  // SALMON OF KNOWLEDGE
  {
    term: "Finnegas",
    pronunciation: "FIN-e-gas",
    meaning: "Also known as Finn Eces — a wise druid-poet who spent seven years fishing the River Boyne for the Salmon of Knowledge. He was the teacher and foster-father of the young Fionn mac Cumhaill.",
    related_story: "The Salmon of Knowledge",
    link: "#"
  },
  {
    term: "Deimne",
    pronunciation: "DEV-na",
    meaning: "The birth name of Fionn mac Cumhaill before he gained his legendary name. He was raised in secret to protect him from the enemies who had killed his father.",
    related_story: "The Salmon of Knowledge",
    link: "#"
  },
  {
    term: "Tobar Segais",
    pronunciation: "TUH-bar SHEG-ish",
    meaning: "The Well of Wisdom — a sacred spring at the source of the River Boyne, surrounded by nine magical hazel trees. The hazelnuts that fell into its waters gave all wisdom to the Salmon of Knowledge.",
    related_story: "The Salmon of Knowledge",
    link: "#"
  },
  {
    term: "An Bhóinn",
    pronunciation: "an VOHN",
    meaning: "The River Boyne — one of Ireland's most sacred rivers, flowing through County Meath. Home of the Salmon of Knowledge and named after the goddess Boann. Site of the ancient complex of Brú na Bóinne.",
    related_story: "The Salmon of Knowledge",
    link: "#"
  },
  {
    term: "Teinm Láida",
    pronunciation: "CHEN-im LAW-da",
    meaning: "The gift of illumination through chanting — the form of mystical knowledge that Fionn mac Cumhaill could access for the rest of his life simply by biting his thumb.",
    related_story: "The Salmon of Knowledge",
    link: "#"
  },
  
];

// Lógica automática para ordenar y agrupar (No necesitas modificar esto)
glossaryData.sort((a, b) => a.term.localeCompare(b.term));

const groupedGlossary = glossaryData.reduce((acc, item) => {
  const letter = item.term.charAt(0).toUpperCase();
  if (!acc[letter]) {
    acc[letter] = [];
  }
  acc[letter].push(item);
  return acc;
}, {} as Record<string, typeof glossaryData>);

const alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZ".split("");
---

<section class="px-6 pt-40 pb-24 md:px-10">
  <div class="mx-auto max-w-7xl">
    
    <div class="mb-12 border-b border-gold/20 pb-8 text-center md:text-left">
      <h2 class="text-4xl font-semibold text-sand md:text-5xl">Irish Glossary</h2>
      <p class="mt-4 max-w-2xl text-lg text-sand/70">
        A guide to the magic and myths of ancient Ireland
      </p>
    </div>

    <div class="grid grid-cols-1 gap-12 lg:grid-cols-[280px_1fr]">

      <aside>
        <div class="mb-4 flex items-center justify-between border-b border-gold/10 pb-2">
          <h2 class="text-lg font-medium text-sand">Filters</h2>
        </div>

        <div class="mt-6">
          <div class="mb-3 flex items-center justify-between">
            <h3 class="text-sm font-semibold uppercase tracking-widest text-gold/80">Alphabetical</h3>
            <button id="clear-filter" class="hidden text-xs text-sand/60 transition hover:text-gold">Clear</button>
          </div>
          
          <div class="flex flex-wrap gap-2">
            <button class="letter-btn is-active flex h-9 w-9 items-center justify-center rounded bg-gold/20 text-sm font-semibold text-sand transition hover:bg-gold/30" data-letter="ALL">
              All
            </button>
            {alphabet.map((letter) => (
              <button
                class="letter-btn flex h-9 w-9 items-center justify-center rounded border border-transparent bg-dark/40 text-sm font-medium text-sand/60 transition hover:border-gold/30 hover:text-sand"
                data-letter={letter}
              >
                {letter}
              </button>
            ))}
          </div>
        </div>
      </aside>


      <main>
        <div class="mb-8 flex flex-col-reverse justify-between gap-4 border-b border-gold/10 pb-4 sm:flex-row sm:items-end">
          <p class="text-sand/80">
            Results: <span id="results-count" class="text-lg font-bold text-sand">{glossaryData.length}</span>
          </p>
          
          <div class="relative w-full sm:w-72">
            <input
              type="text"
              id="search-input"
              placeholder="Search glossary..."
              class="w-full rounded border border-gold/20 bg-dark/50 px-4 py-2 text-sand placeholder-sand/40 focus:border-gold/60 focus:outline-none focus:ring-1 focus:ring-gold/60"
            />
            <svg class="absolute right-3 top-2.5 h-5 w-5 text-sand/40" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
        </div>

        <div id="glossary-list" class="space-y-12">
          {Object.keys(groupedGlossary).map((letter) => (
            <div class="letter-group" data-letter={letter}>
              <h2 class="mb-6 text-4xl font-bold text-gold">{letter}.</h2>
              
              <div class="space-y-8 pl-2 md:pl-4">
                {groupedGlossary[letter].map((item) => (
                  <div class="term-item group grid grid-cols-1 gap-1 md:grid-cols-[1fr_2fr]">
                    <div class="pr-4">
                      <h3 class="text-xl font-bold text-sand">{item.term}</h3>
                      <p class="mt-1 font-mono text-sm tracking-wide text-sand/50">/{item.pronunciation}/</p>
                    </div>
                    
                    <div>
                      <p class="leading-relaxed text-sand/80">{item.meaning}</p>
                      {item.related_story && (
                        <div class="mt-3 flex items-center gap-2 text-sm font-medium">
                          <span class="text-gold/70">Related Story:</span>
                          <a href={item.link} class="text-sand underline decoration-gold/40 underline-offset-4 transition hover:text-gold">
                            {item.related_story}
                          </a>
                        </div>
                      )}
                    </div>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
        
        <div id="no-results" class="hidden py-12 text-center text-sand/60">
          No terms found matching your search criteria.
        </div>
      </main>
    </div>
  </div>
</section>

<script src="../scripts/glossary-showcase.js"></script>