---
// nuevas palabras
const glossaryData = [

  // CHILDREN OF LIR / CHILDREN OF AIR

    {
    term: "Aoife",
    pronunciation: "EE-fa",
    meaning: "A mythical princess and the second wife of King Lir.",
    related_story: "The Children of Lir",
    link: "/ChildrenOfLir"
  },
  {
    term: "Lir",
    pronunciation: "LEER",
    meaning: "Ancient sea god and noble lord of the Tuatha Dé Danann.",
    related_story: "Children of Lir",
    link: "/ChildrenOfLir"
  },
  {
    term: "Fionnuala",
    pronunciation: "fin-NOO-la",
    meaning: "Daughter of Lir. The eldest and most protective of the four children.",
    related_story: "Children of Lir",
    link: "/ChildrenOfLir"
  },
  {
    term: "Aodh",
    pronunciation: "AY",
    meaning: "One of the three sons of Lir. His name means 'fire'. He was the elder of the three brothers.",
    related_story: "Children of Lir",
    link: "/ChildrenOfLir"
  },
  {
    term: "Fiachra",
    pronunciation: "fee-ak-ra",
    meaning: "One of the twin sons of Lir. His name is possibly derived from 'fiach' meaning 'raven'.",
    related_story: "Children of Lir",
    link: "/ChildrenOfLir"
  },
  {
    term: "Conn",
    pronunciation: "KON",
    meaning: "The youngest of the four Children of Lir. One of the twin sons.",
    related_story: "Children of Lir",
    link: "/ChildrenOfLir"
  },
  {
    term: "Aoibh",
    pronunciation: "EEV",
    meaning: "The first wife of Lir and beloved mother of his four children. She died after the birth of the twins Fiachra and Conn.",
    related_story: "Children of Lir",
    link: "/ChildrenOfLir"
  },
  {
    term: "Bodb Derg",
    pronunciation: "BOV jar-ag",
    meaning: "High King of the Tuatha Dé Danann and father of both Aoibh and Aoife. When he discovered Aoife's treachery, he cursed her to become a demon of the air for eternity.",
    related_story: "Children of Lir",
    link: "/ChildrenOfLir"
  },
  {
    term: "Lough Dairbhreach",
    pronunciation: "lokh DAR-vrakh",
    meaning: "Lake of the Oaks, the first of three locations where the Children of Lir spent 300 years of their enchantment, located near Mullingar.",
    related_story: "Children of Lir",
    link: "/ChildrenOfLir"
  },

  // BANSHEE
  {
    term: "Bean Sí",
    pronunciation: "ban SHEE",
    meaning: "Woman of the Fairy Mound, the Irish name for the Banshee, a female spirit whose mournful wail heralds the death.",
    related_story: "The Banshee",
    link: "/Banshee"
  },
  {
    term: "Caoineadh",
    pronunciation: "KEEN-ya",
    meaning: "To weep, to wail. The mournful funeral lament traditionally sung by women at Irish wakes, closely linked to the cry of the Banshee.",
    related_story: "The Banshee",
    link: "/Banshee"
  },
  {
    term: "Clíodhna",
    pronunciation: "KLEE-o-na",
    meaning: "A principal goddess and queen of the Tuatha Dé Danann, sometimes described as Queen of the Banshees.",
    related_story: "The Banshee",
    link: "/Banshee"
  },
  {
    term: "Sídhe",
    pronunciation: "SHEE",
    meaning: "The fairy mounds or fairy folk of Irish mythology. ",
    related_story: "The Banshee",
    link: "/Banshee"
  },

  // GIANT'S CAUSEWAY
    {
    term: "Fionn mac Cumhaill",
    pronunciation: "FIN mac COOL",
    meaning: "A mythical hunter-warrior and leader of the Fianna. He is said to have built the Giant's Causeway.",
    related_story: "The Giant's Causeway",
    link: "/GiantsCauseway"
  },
  {
    term: "Oonagh",
    pronunciation: "OO-nah",
    meaning: "The clever wife of Fionn mac Cumhaill.",
    related_story: "Giant's Causeway",
    link: "/GiantsCauseway"
  },
  {
    term: "Benandonner",
    pronunciation: "ben-AN-don-er",
    meaning: "The fearsome Scottish giant who challenged Fionn mac Cumhaill to battle.",
    related_story: "Giant's Causeway",
    link: "/GiantsCauseway"
  },
  {
    term: "Lough Neagh",
    pronunciation: "lokh NAY",
    meaning: "Ireland's largest lake, said to have been created when Fionn mac Cumhaill scooped up a massive chunk of earth and hurled it at Benandonner, leaving a great hollow that filled with water.",
    related_story: "Giant's Causeway",
    link: "/GiantsCauseway"
  },

  // CÚ CHULAINN
    {
    term: "Cú Chulainn",
    pronunciation: "koo HULL-in",
    meaning: "An Irish mythological demigod and hero of the Ulster Cycle.",
    related_story: "The Ulster Cycle",
    link: "#"
  },
  {
    term: "Sétanta",
    pronunciation: "shay-DAN-dah",
    meaning: "The birth name of Cú Chulainn. As a child, he killed the fierce guard dog of the smith Culann and offered to take its place, earning his legendary name.",
    related_story: "Cú Chulainn",
    link: "#"
  },
  {
    term: "Conor Mac Nessa",
    pronunciation: "KON-or mac NESS-a",
    meaning: "The King of Ulster and maternal uncle of Cú Chulainn. A powerful ruler who oversaw the great warriors of the Red Branch.",
    related_story: "Cú Chulainn",
    link: "#"
  },
  {
    term: "Scathach",
    pronunciation: "Scou-ha/skaw-thach",
    meaning: "The Shadow, a legendary female warrior who ran a school for heroes on the Isle of Skye (Dún Scáith). She trained Cú Chulainn in all the arts of war and gifted him the Gáe Bulg.",
    related_story: "Cú Chulainn",
    link: "#"
  },
  {
    term: "Emer",
    pronunciation: "Ay-mer",
    meaning: "The wife of Cú Chulainn and daughter of the chieftain Forgall Monach. She was renowned for her beauty, wisdom, and fierce loyalty to her husband.",
    related_story: "Cú Chulainn",
    link: "#"
  },
  {
    term: "Gáe Bolga",
    pronunciation: "GAY Boolga",
    meaning: "Spear of Death, the terrible barbed spear gifted to Cú Chulainn by Scáthach. Made from the bones of a sea monster.",
    related_story: "Cú Chulainn",
    link: "#"
  },
  {
    term: "Ríastrad",
    pronunciation: "REE-uh-strad",
    meaning: "The warp spasm or battle frenzy, a terrifying transformation that overtook Cú Chulainn in battle.",
    related_story: "Cú Chulainn",
    link: "#"
  },
  {
    term: "Táin Bó Cúailnge",
    pronunciation: "TOYN bo hOO-ling-eh",
    meaning: "The Cattle Raid of Cooley, the greatest epic of the Ulster Cycle.",
    related_story: "Cú Chulainn",
    link: "#"
  },
  {
    term: "Medb",
    pronunciation: "Maeve",
    meaning: "The powerful and ruthless Queen of Connacht. She launched the invasion of Ulster to seize the great Brown Bull of Cooley.",
    related_story: "Cú Chulainn",
    link: "#"
  },
  {
    term: "Ferdiad",
    pronunciation: "FER-dee-ad",
    meaning: "Cú Chulainn's closest foster brother and fellow trainee under Scáthach.",
    related_story: "Cú Chulainn",
    link: "#"
  },
  {
    term: "Emain Macha",
    pronunciation: "EV-in MAH-khah",
    meaning: "The great royal fort and seat of the Kings of Ulster, today known as Navan Fort in County Armagh.",
    related_story: "Cú Chulainn",
    link: "#"
  },
  {
    term: "Dechtire",
    pronunciation: "DECK-tir-a",
    meaning: "The mortal mother of Cú Chulainn and sister of King Conor Mac Nessa.",
    related_story: "Cú Chulainn",
    link: "#"
  },
  {
    term: "Láeg",
    pronunciation: "LOY-ug",
    meaning: "The loyal charioteer and trusted companion of Cú Chulainn. He drove the hero's chariot into battle and remained by his side.",
    related_story: "Cú Chulainn",
    link: "#"
  },
  {
    term: "Liath Macha",
    pronunciation: "LEE-ah MAH-khah",
    meaning: "The Grey of Macha, one of Cú Chulainn's two magical horses, said to be a supernatural being.",
    related_story: "Cú Chulainn",
    link: "#"
  },
  {
    term: "Dún Scáith",
    pronunciation: "DOON SKAH",
    meaning: "Fortress of Shadows, the impregnable stronghold of the warrior-woman Scáthach on the Isle of Skye.",
    related_story: "Cú Chulainn",
    link: "#"
  },

  // TÍR NA NÓG
    {
    term: "Tír na nÓg",
    pronunciation: "TEER na NOG",
    meaning: "The Land of Eternal Youth in Irish mythology, an otherworldly realm where illness and death do not exist.",
    related_story: "Oisín in Tír na nÓg",
    link: "#"
  },
  {
    term: "Oisín",
    pronunciation: "USH-een",
    meaning: "Son of Fionn mac Cumhaill and legendary poet-warrior of the Fianna. He fell in love with Niamh and spent 300 years in Tír na nÓg.",
    related_story: "Tír na nÓg",
    link: "#"
  },
  {
    term: "Niamh Chinn Óir",
    pronunciation: "NEEV Keen OR",
    meaning: "Niamh of the Golden Hair, a queen of Tír na nÓg and daughter of Manannán mac Lir. She crossed the sea on her magical white horse.",
    related_story: "Tír na nÓg",
    link: "#"
  },
  {
    term: "Enbarr",
    pronunciation: "ON-var",
    meaning: "The magical white horse of Niamh, able to gallop across the surface of the sea. She lent it to Oisín to return to Ireland.",
    related_story: "Tír na nÓg",
    link: "#"
  },
  {
    term: "Manannán mac Lir",
    pronunciation: "MA-naw-nan mac LIR",
    meaning: "The great god of the sea and ruler of the Otherworld. Father of Niamh and keeper of Tír na nÓg.",
    related_story: "Tír na nÓg",
    link: "#"
  },
  {
    term: "Fianna",
    pronunciation: "FEE-a-na",
    meaning: "The legendary Irish warrior-hunters led by Fionn mac Cumhaill",
    related_story: "Tír na nÓg",
    link: "#"
  },
  {
    term: "Gleann na Smol",
    pronunciation: "GLAN uh SMULL",
    meaning: "Valley of the Thrushes — the valley through which Oisín passed on his return to Ireland.",
    related_story: "Tír na nÓg",
    link: "#"
  },

  // THE PÚCA
  {
    term: "Púca",
    pronunciation: "POO-ka",
    meaning: "A mischievous shapeshifting spirit of Irish folklore, feared as the most troublesome of the fairy folk.",
    related_story: "The Púca",
    link: "#"
  },



  // SALMON OF KNOWLEDGE
  {
    term: "Finnegas",
    pronunciation: "FIN-ay-gas",
    meaning: "Also known as Finn Eces, a wise druid-poet who spent seven years fishing the River Boyne for the Salmon of Knowledge. He was the teacher and foster-father of the young Fionn mac Cumhaill.",
    related_story: "The Salmon of Knowledge",
    link: "#"
  },
  {
    term: "Deimne",
    pronunciation: "Dim-nah",
    meaning: "The birth name of Fionn mac Cumhaill before he gained his legendary name.",
    related_story: "The Salmon of Knowledge",
    link: "#"
  },
  {
    term: "Tobar Segais",
    pronunciation: "TUH-bar SHEG-ish",
    meaning: "The Well of Wisdom — a sacred spring at the source of the River Boyne, surrounded by nine magical hazel trees.",
    related_story: "The Salmon of Knowledge",
    link: "#"
  },
  {
    term: "An Bhóinn",
    pronunciation: "un VOY-n",
    meaning: "The River Boyne — one of Ireland's most sacred rivers, flowing through County Meath. Home of the Salmon of Knowledge and named after the goddess Boann.",
    related_story: "The Salmon of Knowledge",
    link: "#"
  },
  {
    term: "Teinm Láida",
    pronunciation: "TEN-im LAW-ih-dah",
    meaning: "The gift of illumination through chanting.",
    related_story: "The Salmon of Knowledge",
    link: "#"
  },
  
];

// Lógica automática para ordenar y agrupar (No necesitas modificar esto)
glossaryData.sort((a, b) => a.term.localeCompare(b.term));

const groupedGlossary = glossaryData.reduce((acc, item) => {
  const letter = item.term.charAt(0).toUpperCase();
  if (!acc[letter]) {
    acc[letter] = [];
  }
  acc[letter].push(item);
  return acc;
}, {} as Record<string, typeof glossaryData>);

const alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZ".split("");
---

<section class="px-6 pt-40 pb-24 md:px-10">
  <div class="mx-auto max-w-7xl">
    
<div class="section-header mb-16 text-center">
  <div class="section-divider-line"></div>
  <p class="section-eyebrow">Reference</p>
  <h1 class="section-title">
    Irish <span class="accent">Glossary</span>
  </h1>
  <p class="mx-auto mt-5 max-w-2xl font-[var(--font-body)] text-base leading-relaxed text-sand/65">
    A guide to the magic and myths of ancient Ireland
  </p>
</div>
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-[280px_1fr]">

      <aside>
        <div class="mb-4 flex items-center justify-between border-b border-gold/10 pb-2">
          <h2 class="text-lg font-medium text-sand">Filters</h2>
        </div>

        <div class="mt-6">
          <div class="mb-3 flex items-center justify-between">
            <h3 class="text-sm font-semibold uppercase tracking-widest text-gold/80">Alphabetical</h3>
            <button id="clear-filter" class="hidden text-xs text-sand/60 transition hover:text-gold">Clear</button>
          </div>
          
          <div class="flex flex-wrap gap-2">
            <button class="letter-btn is-active flex h-9 w-9 items-center justify-center rounded bg-gold/20 text-sm font-semibold text-sand transition hover:bg-gold/30" data-letter="ALL">
              All
            </button>
            {alphabet.map((letter) => (
              <button
                class="letter-btn flex h-9 w-9 items-center justify-center rounded border border-transparent bg-dark/40 text-sm font-medium text-sand/60 transition hover:border-gold/30 hover:text-sand"
                data-letter={letter}
              >
                {letter}
              </button>
            ))}
          </div>
        </div>
      </aside>


      <main>
        <div class="mb-8 flex flex-col-reverse justify-between gap-4 border-b border-gold/10 pb-4 sm:flex-row sm:items-end">
          <p class="text-sand/80">
            Results: <span id="results-count" class="text-lg font-bold text-sand">{glossaryData.length}</span>
          </p>
          
          <div class="relative w-full sm:w-72">
            <input
              type="text"
              id="search-input"
              placeholder="Search glossary..."
              class="w-full rounded border border-gold/20 bg-dark/50 px-4 py-2 text-sand placeholder-sand/40 focus:border-gold/60 focus:outline-none focus:ring-1 focus:ring-gold/60"
            />
            <svg class="absolute right-3 top-2.5 h-5 w-5 text-sand/40" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
        </div>

        <div id="glossary-list" class="space-y-12">
          {Object.keys(groupedGlossary).map((letter) => (
            <div class="letter-group" data-letter={letter}>
              <h2 class="mb-6 text-4xl font-bold text-gold">{letter}.</h2>
              
              <div class="space-y-8 pl-2 md:pl-4">
                {groupedGlossary[letter].map((item) => (
                  <div class="term-item group grid grid-cols-1 gap-1 md:grid-cols-[1fr_2fr]">
                    <div class="pr-4">
                      <h3 class="text-xl font-bold text-sand">{item.term}</h3>
                      <p class="mt-1 font-mono text-sm tracking-wide text-sand/50">/{item.pronunciation}/</p>
                    </div>
                    
                    <div>
                      <p class="leading-relaxed text-sand/80">{item.meaning}</p>
                      {item.related_story && (
                        <div class="mt-3 flex items-center gap-2 text-sm font-medium">
                          <span class="text-gold/70">Related Story:</span>
                          <a href={item.link} class="text-sand underline decoration-gold/40 underline-offset-4 transition hover:text-gold">
                            {item.related_story}
                          </a>
                        </div>
                      )}
                    </div>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
        
        <div id="no-results" class="hidden py-12 text-center text-sand/60">
          No terms found matching your search criteria.
        </div>
      </main>
    </div>
  </div>
</section>

<style>

  .section-eyebrow {
    font-family: var(--font-body);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--color-gold);
  }
  .section-title {
    margin-top: 0.7rem;
    font-family: var(--font-title);
    font-weight: 700;
    font-size: clamp(2.2rem, 4.5vw, 3.2rem);
    line-height: 1.1;
    color: var(--color-sand);
  }
  .accent {
    font-style: italic;
    color: var(--color-gold);
  }
</style>

<script src="../scripts/glossary-showcase.js"></script>