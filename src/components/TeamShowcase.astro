---
const team = [
  {
    id: 1,
    name: "Johanna Montiel",
    role: "UI / UX & Visual Concept Designer",
    bio: "Focused on interface design, visual concept, and user experience, creating cohesive layouts, interactive sections, and a strong visual identity to support the storytelling of Irish legends.",
    skills: ["UI Design", "Visual Concept", "Interface Systems","Front-end Development"],
    contact: "nadiajohanna.montielroa@student.griffith.ie",
    image: "/team/Johanna.jpg",
  },
  {
    id: 2,
    name: "Fabiana Banegas",
    role: "UX Researcher & Content Lead",
    bio: "Focused on the structural planning of the project, helping research Irish myths, shape the site map, organise content, and guide the overall user experience.",
    skills: ["Project Planning", "Content Strategy", "Information Architecture", "Front-end Development"],
    contact: "laurafabiana.banegasrivero@student.griffith.ie",
    image: "/team/Fabiana.png",
  },
  {
    id: 3,
    name: "Sumeyye Yilmaz",
    role: "Lead Designer & UI Specialist",
    bio: "Led the visual direction of the project, designing the logo, establishing the brand identity, and creating key interface elements and visual assets.",
    skills: ["Brand Identity", "UI Design", "Graphic Design"],
    contact: "teammate3@email.com",
    image: "/team/Sumeyye.png",
  },
  {
    id: 4,
    name: "Denilson Madeira",
    role: "Product Designer & 3D Artist",
    bio: "Led the physical side of the project, designing and modelling the 3D characters, preparing them for resin printing, and managing post-processing, painting, NFC integration, and technical documentation.",
    skills: ["3D Art", "Product Design", "Creative Direction"],
    contact: "denilson.americosantosmadeira@student.griffith.ie",
    image: "/team/Denilson.png",
  },
];
---

<section class="team-page px-6 pt-32 md:px-10">
  <div class="mx-auto max-w-7xl">

    <!-- Intro -->
    <section class="team-intro text-center">

      <div class="team-intro-inner mx-auto">
        <div class="section-divider-line"></div>
        <p class="team-eyebrow anim-item">The Team</p>

        <h1 class="team-title anim-item">
          Meet the people behind <br />
          <span class="team-title-accent">Éire Lore</span>
        </h1>

        <p class="team-lead anim-item mx-auto">
          We are a diverse team of creatives from different countries, now living in
          Ireland. With backgrounds in design, digital media, and storytelling, we
          created Éire Lore as part of our Master’s in Interactive Digital Media.
        </p>

        <p class="team-lead anim-item mx-auto">
          After more than three years in Ireland, we have come to see the quiet magic
          of this country,in its landscapes, its people, and especially its myths.
          As newcomers once ourselves, we want these stories to be more visible and
          accessible, not only for Irish audiences, but also for those discovering
          <span class="team-title-accent">Ireland</span> for the first time.
        </p>
      </div>
    </section>
    
    <div class="section-divider-line">
       <span></span>
    </div>

    <!-- Static flip cards -->
    <div class="team-grid pt-0 pb-30">
      {team.map((member) => (
        <article class="team-flip-card anim-card">
          <div class="team-flip-inner">

            <!-- Front -->
            <div class="team-card-face team-card-front">
              <img src={member.image} alt={member.name} />

              <div class="team-card-caption">
                <h3>{member.name}</h3>
                <p>{member.role}</p>
              </div>
            </div>

            <!-- Back -->
            <div class="team-card-face team-card-back">
              <p class="team-card-role">{member.role}</p>
              <h3>{member.name}</h3>

              <p class="team-card-bio">
                {member.bio}
              </p>

              <div class="team-skills">
                {member.skills.map((skill) => (
                  <span>{skill}</span>
                ))}
              </div>

              <a href={`mailto:${member.contact}`} class="team-contact">
                Contact
              </a>
            </div>

          </div>
        </article>
      ))}
    </div>
    

  </div>
</section>

<style>


  .team-intro {
    padding-top: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .team-intro-inner {
    max-width: 760px;
    margin: 0 ;
    text-align: center;
    padding-top: 70px;
  }

  .team-eyebrow {
    font-family: var(--font-body);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin-bottom: 1.25rem;
  }

  .team-title {
    font-family: var(--font-title);
    font-weight: 700;
    font-size: clamp(2.2rem, 4.5vw, 3.2rem);
    line-height: 1.1;
    color: var(--color-sand);
    text-align: center;
  }

  .team-title-accent {
    font-style: italic;
    color: var(--color-gold);
  }

  .team-lead {
    margin-top: 1.5rem;
    max-width: 62ch;
    font-family: var(--font-body);
    font-size: clamp(0.95rem, 1.5vw, 1.08rem);
    line-height: 1.85;
    color: rgba(241, 210, 152, 0.72);
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .team-flip-card {
    height: 430px;
    perspective: 1200px;
    cursor: pointer;
  }

  .team-flip-inner {
    position: relative;
    height: 100%;
    transform-style: preserve-3d;
    transition: transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .team-flip-card:hover .team-flip-inner {
  transform: rotateY(180deg);
}

  .team-card-face {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: 1.6rem;
    border: 1px solid rgba(216, 169, 27, 0.16);
    background: rgba(0, 44, 35, 0.55);
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    box-shadow: 0 20px 48px -28px rgba(0, 0, 0, 0.6);
  }

  .team-card-front img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .team-card-caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 1.1rem;
    background: linear-gradient(to top, rgba(0, 44, 35, 0.96), transparent);
  }

  .team-card-caption h3,
  .team-card-back h3 {
    font-family: var(--font-title);
    color: var(--color-sand);
    font-weight: 700;
    font-size: 1.35rem;
    line-height: 1.15;
  }

  .team-card-caption p,
  .team-card-role {
    margin-top: 0.45rem;
    color: var(--color-gold);
    font-family: var(--font-body);
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .team-card-back {
    transform: rotateY(180deg);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .team-card-bio {
    margin-top: 1rem;
    color: rgba(241, 210, 152, 0.72);
    font-family: var(--font-body);
    line-height: 1.65;
    font-size: 0.85rem;
  }

  .team-skills {
    margin-top: 1.2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .team-skills span {
    border: 1px solid rgba(216, 169, 27, 0.22);
    border-radius: 999px;
    padding: 0.35rem 0.7rem;
    color: rgba(241, 210, 152, 0.85);
    font-family: var(--font-body);
    font-size: 0.7rem;
  }

  .team-contact {
    margin-top: 1.4rem;
    color: var(--color-gold);
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-decoration: underline;
    text-underline-offset: 0.25rem;
  }

  @media (max-width: 1000px) {
    .team-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .team-grid {
      grid-template-columns: 1fr;
    }

    .team-flip-card {
      height: 460px;
    }
  }
.team-page {
  position: relative;
}


.team-flip-card {
  position: relative;
  z-index: 1;
}

/* hover normal */
.team-flip-card:hover .team-flip-inner {
  transform: rotateY(180deg);
}

/* card abierta como modal */
.team-flip-card.is-active {
  position: fixed;
  top: 50%;
  left: 50%;
  width: min(90vw, 420px);
  height: 520px;
  z-index: 50;
  transform: translate(-50%, -50%) !important;
}

/* cuando está abierta, queda girada */
.team-flip-card.is-active .team-flip-inner {
  transform: rotateY(180deg);
}

/* cuando está abierta, que no dependa del hover */
.team-flip-card.is-active:hover .team-flip-inner {
  transform: rotateY(180deg);
}

.team-contact {
  margin-top: 1.4rem;
  color: var(--color-gold);
  font-family: var(--font-body);
  font-size: 0.78rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  text-decoration: underline;
  text-underline-offset: 0.25rem;

  transition:
    color 0.25s ease,
    opacity 0.25s ease,
    transform 0.25s ease;
}

.team-contact:hover {
  color: var(--color-sand);
  opacity: 1;
  transform: translateX(2px);
}
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // ── Intro animation ───────────────────────
  const teamHeroItems = document.querySelectorAll(".team-intro .anim-item");

  teamHeroItems.forEach((el, i) => {
    gsap.fromTo(
      el,
      { opacity: 0, y: 40, scale: 0.97, filter: "blur(6px)" },
      {
        opacity: 1,
        y: 0,
        scale: 1,
        filter: "blur(0px)",
        duration: 1,
        delay: 0.15 + i * 0.13,
        ease: "power3.out",
      }
    );
  });

  // ── Cards animation ───────────────────────
  const teamCards = document.querySelectorAll(".anim-card");

  teamCards.forEach((card, i) => {
    gsap.fromTo(
      card,
      { opacity: 0, y: 60, scale: 0.93, filter: "blur(8px)" },
      {
        opacity: 1,
        y: 0,
        scale: 1,
        filter: "blur(0px)",
        duration: 1,
        delay: i * 0.12,
        ease: "power3.out",
        scrollTrigger: {
          trigger: card,
          start: "top 78%",
          once: true, // 👈 evita re-animaciones raras
        },
      }
    );
  });

  // ── Flip cards (estable) ──────────────────
const flipCards = document.querySelectorAll(".team-flip-card");

flipCards.forEach((card) => {
  card.addEventListener("click", () => {
    card.classList.toggle("is-flipped");
  });
});

  // ── Fix general de layout ─────────────────
  window.addEventListener("load", () => {
    ScrollTrigger.refresh();
  });

  window.addEventListener("resize", () => {
    ScrollTrigger.refresh();
  });
</script>