---
const team = [
  {
    id: 2,
    name: "Fabiana Banegas",
    role: "UX Researcher & Content Lead",
    bio: "Focused on the project’s structural planning, helping research Irish myths, design the site map, and guide the overall user experience.",
    skills: ["Project planning", "Content strategy", "Information architecture"],
    contact: "laurafabiana.banegasrivero@student.griffith.ie",
    image: "/team/member-2.png",
  },
  {
    id: 1,
    name: "Johanna Montiel",
    role: "UI / UX & Visual Concept Designer",
    bio: "Focused on interface design, visual concept, and user experience, creating cohesive layouts, interactive sections, and a strong visual identity that supports the storytelling of Irish legends.",
    skills: ["UI design", "Visual concept", "Interface systems"],
    contact: "nadiajohanna.montielroa@student.griffith.ie",
    image: "/team/member-1.png",
  },
  {
    id: 4,
    name: "Denilson Madeira",
    role: "Product Designer & 3D Artist",
    bio: "Led the physical side of the project, designing and modelling the 3D characters, preparing them for resin printing, and managing the full production process, including post-processing and painting. He also worked on integrating NFC technology into the objects and contributed to the technical structure and documentation of the project.",
    skills: ["3D Art", "Product Design", "Creative Direction"],
    contact: "denilson.americosantosmadeira@student.griffith.ie",
    image: "/team/member-4.png",
  },
  {
    id: 3,
    name: "Sumeyye Yilmaz",
    role: "Lead Designer & UI Specialist",
    bio: "Led the visual direction of the project, designing the logo, establishing the brand identity, and creating the user interface and visual assets.",
    skills: ["Brand identity", "UI design", "Graphic design"],
    contact: "teammate3@email.com",
    image: "/team/member-3.png",
  },
].sort((a, b) => a.name.localeCompare(b.name));
---

<section class="px-6 pt-40 pb-24 md:px-10">
  <div class="mx-auto max-w-6xl">
    <div class="grid overflow-hidden rounded-[2.4rem] border border-gold/15 bg-dark/45 shadow-[0_25px_80px_-45px_rgba(0,0,0,0.85)] backdrop-blur-md md:grid-cols-[320px_1fr]">
      
      <!-- Member menu -->
      <div class="border-b border-gold/10 bg-dark/50 p-4 md:border-b-0 md:border-r md:p-5">
        <div class="flex gap-3 overflow-x-auto md:flex-col md:overflow-visible">
          {team.map((member, index) => (
            <button
              type="button"
              class={`team-btn min-w-[230px] rounded-[1.4rem] border px-5 py-4 text-left transition duration-300 md:min-w-0 ${
                index === 0
                  ? "is-active border-gold/40 bg-forest/45 shadow-[0_12px_30px_-22px_rgba(0,0,0,0.8)]"
                  : "border-gold/5 bg-sand/[0.03] hover:border-gold/25 hover:bg-forest/25"
              }`}
              data-name={member.name}
              data-role={member.role}
              data-bio={member.bio}
              data-contact={member.contact}
              data-image={member.image}
              data-skills={JSON.stringify(member.skills)}
            >
              <p class="text-lg font-semibold text-sand">
                {member.name}
              </p>

              <p class="mt-2 text-xs uppercase leading-relaxed tracking-[0.12em] text-gold/75">
                {member.role}
              </p>
            </button>
          ))}
        </div>
      </div>

      <!-- Expanded details -->
      <div class="grid bg-gradient-to-br from-dark/40 via-dark/60 to-forest/25 lg:grid-cols-[360px_1fr]">
        <div class="relative min-h-[420px] overflow-hidden bg-forest/25">
          <div class="absolute inset-0 bg-gradient-to-t from-dark/60 via-transparent to-transparent"></div>

          <img
            id="member-image"
            src={team[0].image}
            alt={team[0].name}
            class="h-full w-full object-cover transition duration-500"
          />
        </div>

        <div class="p-7 md:p-10">
          <p id="member-role" class="text-sm uppercase tracking-[0.18em] text-gold">
            {team[0].role}
          </p>

          <h3 id="member-name" class="mt-4 text-3xl font-semibold text-sand md:text-5xl">
            {team[0].name}
          </h3>

          <div class="mt-6 h-px w-full bg-gradient-to-r from-gold/40 via-gold/10 to-transparent"></div>

          <p id="member-bio" class="mt-7 max-w-3xl text-base leading-relaxed text-sand/75 md:text-lg">
            {team[0].bio}
          </p>

          <div class="mt-9">
            <p class="text-sm uppercase tracking-[0.14em] text-gold">
              Skills
            </p>

            <div id="member-skills" class="mt-4 flex flex-wrap gap-3">
              {team[0].skills.map((skill) => (
                <span class="rounded-full border border-gold/20 bg-dark/45 px-4 py-2 text-sm text-sand/85">
                  {skill}
                </span>
              ))}
            </div>
          </div>

          <div class="mt-9">
            <p class="text-sm uppercase tracking-[0.14em] text-gold">
              Contact
            </p>

            <a
              id="member-contact"
              href={`mailto:${team[0].contact}`}
              class="mt-3 inline-block break-all text-sand/80 underline decoration-gold/50 underline-offset-4 transition hover:text-gold"
            >
              {team[0].contact}
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const buttons = document.querySelectorAll(".team-btn");

  const image = document.getElementById("member-image");
  const name = document.getElementById("member-name");
  const role = document.getElementById("member-role");
  const bio = document.getElementById("member-bio");
  const skills = document.getElementById("member-skills");
  const contact = document.getElementById("member-contact");

  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      buttons.forEach((btn) => {
        btn.classList.remove(
          "is-active",
          "border-gold/40",
          "bg-forest/45",
          "shadow-[0_12px_30px_-22px_rgba(0,0,0,0.8)]"
        );

        btn.classList.add(
          "border-gold/5",
          "bg-sand/[0.03]"
        );
      });

      button.classList.add(
        "is-active",
        "border-gold/40",
        "bg-forest/45",
        "shadow-[0_12px_30px_-22px_rgba(0,0,0,0.8)]"
      );

      button.classList.remove(
        "border-gold/5",
        "bg-sand/[0.03]"
      );

      const memberSkills = JSON.parse(button.dataset.skills || "[]");

      image.src = button.dataset.image;
      image.alt = button.dataset.name;
      name.textContent = button.dataset.name;
      role.textContent = button.dataset.role;
      bio.textContent = button.dataset.bio;
      contact.textContent = button.dataset.contact;
      contact.href = `mailto:${button.dataset.contact}`;

      skills.innerHTML = "";

      memberSkills.forEach((skill) => {
        const span = document.createElement("span");
        span.className =
          "rounded-full border border-gold/20 bg-dark/45 px-4 py-2 text-sm text-sand/85";
        span.textContent = skill;
        skills.appendChild(span);
      });
    });
  });
</script>