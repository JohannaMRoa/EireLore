---
const navLinks = [
  { href: "/about", label: "About" },
  { href: "/myths", label: "Myths" },
  { href: "/glossary", label: "Glossary" },
  { href: "/store", label: "Store" },
  { href: "/team", label: "Team" },
];

const currentPath = Astro.url.pathname;

const isActiveLink = (href: string) =>
  currentPath === href || currentPath.startsWith(`${href}/`);
---

<header
  id="main-nav"
  class="fixed left-0 top-0 z-50 w-full bg-dark/45 backdrop-blur-sm transition-all duration-500"
>
  <nav
    id="nav-inner"
    class="mx-auto flex max-w-7xl items-center justify-between bg-[radial-gradient(circle_at_center,rgba(30,140,120,0.18),transparent_70%)] px-6 py-4 transition-all duration-300 md:px-10"
    aria-label="Main navigation"
  >
    <a href="/" class="flex items-center no-underline" aria-label="Éire Lore Home">
      <img
        id="nav-logo"
        src="/logo-2.svg"
        alt="Éire Lore"
        class="h-12 w-auto object-contain transition-all duration-300 md:h-14"
      />
    </a>

    <ul class="hidden list-none items-center gap-9 md:flex">
      {navLinks.map((link) => {
        const isActive = isActiveLink(link.href);

        return (
          <li>
            <a
              href={link.href}
              class={`text-xs font-bold uppercase tracking-[0.18em] no-underline transition-all duration-300 ${
                isActive
                  ? "text-gold"
                  : ":text-sand/65 hover:text-gold hover:drop-shadow-[0_0_12px_rgba(220,180,90,0.28)]"
              }`}
            >
              {link.label}
            </a>
          </li>
        );
      })}
    </ul>

    <button
      id="menu-btn"
      type="button"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      class="flex h-11 w-11 items-center justify-center border border-gold/25 bg-sand/5 text-sand transition hover:bg-sand/10 hover:text-gold md:hidden"
    >
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" class="h-6 w-6">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"/>
      </svg>
    </button>
  </nav>

  <div
    id="mobile-menu"
    class="hidden border-t border-gold/10 bg-dark/95 px-6 py-5 backdrop-blur-2xl md:hidden"
  >
    <ul class="flex list-none flex-col gap-4">
      {navLinks.map((link) => {
        const isActive = isActiveLink(link.href);

        return (
          <li>
            <a
              href={link.href}
              class={`block text-sm font-bold uppercase tracking-[0.16em] no-underline transition ${
                isActive ? "text-gold drop-shadow-[0_0_10px_rgba(220,180,90,0.35)]" : "text-sand/70 hover:text-gold"
              }`}
            >
              {link.label}
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</header>

<script>
  const nav = document.getElementById("main-nav");
  const logo = document.getElementById("nav-logo");
  const menuBtn = document.getElementById("menu-btn");
  const mobileMenu = document.getElementById("mobile-menu");

  let lastScrollY = window.scrollY;

  function showNav() {
    if (!nav) return;
    nav.style.transform = "translateY(0)";
    nav.style.opacity = "1";
  }

  function hideNav() {
    if (!nav) return;
    nav.style.transform = "translateY(-100%)";
    nav.style.opacity = "0";
  }

  function closeMobileMenu() {
    mobileMenu?.classList.add("hidden");
    menuBtn?.setAttribute("aria-expanded", "false");
  }

  window.addEventListener("scroll", () => {
    if (!nav || !logo) return;

    const currentScrollY = window.scrollY;
    const menuIsOpen = !mobileMenu?.classList.contains("hidden");

    if (currentScrollY > lastScrollY && currentScrollY > 90 && !menuIsOpen) {
      hideNav();
    } else {
      showNav();
    }

    if (currentScrollY > 50) {
      nav.classList.add("bg-dark/70");
      logo.style.height = "40px";
    } else {
      nav.classList.remove("bg-dark/70");
      logo.style.height = "";
    }

    lastScrollY = currentScrollY;
  });

  menuBtn?.addEventListener("click", () => {
    mobileMenu?.classList.toggle("hidden");
    const isOpen = !mobileMenu?.classList.contains("hidden");
    menuBtn.setAttribute("aria-expanded", String(isOpen));
  });

  mobileMenu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", closeMobileMenu);
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeMobileMenu();
  });
</script>