---
import Layout from "../layouts/Layout.astro";

const categories = [
  "All",
  "T-Shirts",
  "Tote Bags",
  "Figures",
  "Accesories",
  "Keychains",
  "Posters",
  
];

const storyCollections = [
  "All",
  "The Children of Lir",
  "Giant's Causeway",
  "The Banshee",
  "Éire Lore",
];

const products = [
    {
    title: "The Giant's Causeway - 3D Printed",
    category: "Figures",
    collection: "Giant's Causeway",
    price: "€34.99",
    image: "/shop/giant-figure.png",
  },
      {
    title: "The Children of Lir - 3D Printed",
    category: "Figures",
    collection: "The Children of Lir",
    price: "€34.99",
    image: "/shop/swan-figure.png",
  },
    {
    title: "The Banshee - 3D Printed",
    category: "Figures",
    collection: "The Banshee",
    price: "€34.99",
    image: "/shop/banshee-figure.png",
  },


    {
    title: "Set of Pins",
    category: "Accesories",
    collection: "Éire Lore",
    price: "€10.99",
    image: "/shop/pin-set.png",
  },
    {
    title: "Legendary Tote",
    category: "Tote Bags",
    collection: "Éire Lore",
    price: "€12.99",
    image: "/shop/tote-bag.png",
  },
    {
    title: "Set of cards",
    category: "Games",
    collection: "Éire Lore",
    price: "€8.99",
    image: "/shop/card-set.png",
  },


  {
    title: "Giant’s Causeway Keychain",
    category: "Keychains",
    collection: "Giant's Causeway",
    price: "€10.99",
    image: "/shop/fionn-keychain.jpg",
  },
  {
    title: "Children of Lir Keychain",
    category: "Keychains",
    collection: "The Children of Lir",
    price: "€10.99",
    image: "/shop/swan-keychain.jpg",
  },
  {
    title: "The Banshee Keychain",
    category: "Keychains",
    collection: "The Banshee",
    price: "€8.99",
    image: "/shop/banshee-keychain.jpg",

  },


    {
    title: "Phone case",
    category: "Accesories",
    collection: "Éire Lore",
    price: "€15.99",
    image: "/shop/phone-case.png",
  },
  {
    title: "Airpods case",
    category: "Accesories",
    collection: "Éire Lore",
    price: "€15.99",
    image: "/shop/airpods-case.png",
  },
  {
    title: "Legend Keeper - NFC",
    category: "Keychains",
    collection: "Éire Lore",
    price: "€12.99",
    image: "/shop/eire-lore-keychain.png",
  },

];
---

<Layout title="Éire Lore — Shop">
  <main class="shop-page">
    <button
        id="cart-open"
        type="button"
        aria-label="Open cart"
        class="store-cart-button"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="1.7"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M15.75 10.5V6a3.75 3.75 0 1 0-7.5 0v4.5m11.356-1.993 1.263 12A1.5 1.5 0 0 1 19.376 22H4.624a1.5 1.5 0 0 1-1.493-1.493l1.263-12A1.5 1.5 0 0 1 5.887 7.125h12.226a1.5 1.5 0 0 1 1.493 1.382Z"
          />
        </svg>
      </button>

    <!-- HERO CAROUSEL -->
    <section class="shop-hero-carousel">
  <div class="shop-slide is-active">
    <div class="shop-slide-content">
      <p class="shop-eyebrow">First Collection</p>
      <h1>The Legends<br /><span>Collection</span></h1>
      <p class="shop-lead">
        Merch inspired by The Children of Lir, The Giant’s Causeway, and The Banshee.
      </p>
      <a href="#products" class="shop-btn">Shop Collection</a>
    </div>

    <div class="shop-slide-art">
      <img src="/myths/children-of-lir.jpeg" alt="Children of Lir" />
      <img src="/myths/giants-causeway.png" alt="Giant's Causeway" />
      <img src="/myths/banshee.jpeg" alt="The Banshee" />
    </div>
  </div>

  <div class="shop-slide">
    <div class="shop-slide-content">
      <p class="shop-eyebrow">Collectible Figures</p>
      <h1>Bring myths<br /><span>to your shelf</span></h1>
      
      <a href="#products" class="shop-btn">View Figures</a>
    </div>
     <div class="shop-slide-banner">
    <img src="/myths/banner1.png" alt="Collectible Figures" />
  </div>
  </div>

  <div class="shop-slide">
    <div class="shop-slide-content">
      <p class="shop-eyebrow">Posters & Prints</p>
      <h1>Frame the<br /><span>Otherworld</span></h1>
      
      <a href="#products" class="shop-btn">Explore Prints</a>
    </div>
     <div class="shop-slide-banner">
    <img src="/myths/banner2.png" alt="Collectible Figures" />
  </div>
  </div>

  <div class="shop-carousel-controls">
    <button id="shop-prev" type="button" aria-label="Previous slide">‹</button>

    <div class="shop-dots">
      <button class="shop-dot is-active" data-slide="0" aria-label="Slide 1"></button>
      <button class="shop-dot" data-slide="1" aria-label="Slide 2"></button>
      <button class="shop-dot" data-slide="2" aria-label="Slide 3"></button>
    </div>

    <button id="shop-next" type="button" aria-label="Next slide">›</button>
  </div>
</section>

    <!-- COLLECTION FILTERS -->
    <!-- STORE CONTENT -->
<section id="products" class="shop-section">
  <div class="section-header">
    <div class="section-divider-line"></div>
    
    <h2>Éire Lore Store</h2>
  </div>

  <div class="store-layout">

    <!-- LEFT FILTERS -->
    <aside class="store-sidebar">
      <h3>Filters</h3>

      <div class="shop-filter-group">
        <p class="filter-label">Product type</p>

        <div class="shop-filters vertical">
          {categories.map((item) => (
            <button class="shop-filter-btn is-category" data-category-filter={item}>
              {item}
            </button>
          ))}
        </div>
      </div>
    </aside>

    <!-- RIGHT CONTENT -->
    <div class="store-products-area">
      <div class="collections-bar">
        <p class="filter-label">Story collection</p>

        <div class="shop-filters collections-row">
          {storyCollections.map((item) => (
            <button class="shop-filter-btn is-collection" data-collection-filter={item}>
              {item}
            </button>
          ))}
        </div>
      </div>

      <div class="product-grid">
        {products.map((product) => (
          <article
            class="product-card"
            data-category={product.category}
            data-collection={product.collection}
          >
            <div class="product-image">
              <span class="product-tag">{product.tag}</span>
              <img src={product.image} alt={product.title} />
            </div>

            <div class="product-info">
              <p>{product.category}</p>
              <span class="product-collection">{product.collection}</span>

              <h3>{product.title}</h3>
              <span>{product.price}</span>

              <button
                type="button"
                class="add-to-cart-btn"
                data-title={product.title}
                data-category={product.category}
                data-price={product.price}
                data-image={product.image}
              >
                Add to cart
              </button>
            </div>
          </article>
        ))}
      </div>
    </div>

  </div>
</section>

  </main>

  <!-- CART DRAWER -->
<div id="cart-overlay" class="cart-overlay"></div>

<aside id="cart-drawer" class="cart-drawer">
  <div class="cart-header">
    <h2>Shopping Bag</h2>
    <button id="cart-close" type="button">Close ×</button>
  </div>

  <div id="cart-items" class="cart-items">
    <p class="cart-empty">Your cart is empty</p>
  </div>

  <div class="cart-footer">
    <div class="cart-total-row">
      <span>Subtotal</span>
      <strong id="cart-total">€0.00</strong>
    </div>

    <p class="cart-note">Prototype only — payment is not connected.</p>

    <button class="checkout-btn" type="button">
      Checkout
    </button>
  </div>
</aside>

</Layout>




<style>
  .shop-page {
    min-height: 100vh;
    padding-top: 7rem;
  }

  /* HERO */
  .shop-hero-carousel {
    position: relative;
    min-height: 78vh;
    margin: 0 clamp(1rem, 3vw, 2rem);
    overflow: hidden;
    border-radius: 1.6rem;
    background:
      radial-gradient(circle at 80% 20%, rgba(216, 169, 27, 0.18), transparent 35%),
      linear-gradient(135deg, rgba(0, 68, 53, 0.95), rgba(16, 107, 102, 0.8));
  }

  .shop-slide {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    align-items: center;
    gap: clamp(2rem, 5vw, 4rem);
    padding: clamp(2rem, 7vw, 6rem);
    opacity: 0;
    pointer-events: none;
    transform: scale(1.02);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  .shop-slide.is-active {
    opacity: 1;
    pointer-events: auto;
    transform: scale(1);
  }

  .shop-slide h1 {
    margin-top: 1rem;
    font-family: var(--font-title);
    font-size: clamp(3rem, 7vw, 6rem);
    line-height: 0.95;
    color: var(--color-sand);
  }

  .shop-slide h1 span {
    color: var(--color-gold);
    font-style: italic;
  }

  .shop-lead {
    margin-top: 1.5rem;
    max-width: 48ch;
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.8;
    color: rgba(241, 210, 152, 0.72);
  }

  .shop-btn,
  .checkout-btn,
  .product-info button {
    border: 0;
    border-radius: 999px;
    font-family: var(--font-body);
    font-weight: 900;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    transition: 0.25s ease;
  }

  .shop-btn {
    display: inline-flex;
    margin-top: 2rem;
    padding: 0.8rem 1.5rem;
    background: var(--color-gold);
    color: var(--color-dark);
    font-size: 0.72rem;
    text-decoration: none;
  }

  .shop-btn:hover,
  .checkout-btn:hover,
  .product-info button:hover,
  .store-cart-button:hover {
    background: var(--color-sand);
    color: var(--color-dark);
    transform: translateY(-2px);
  }

  .shop-slide-art {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
  }

  .shop-slide-art img {
    width: min(28vw, 260px);
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: 1.6rem;
    border: 1px solid rgba(216, 169, 27, 0.18);
    box-shadow: 0 30px 70px -35px rgba(0, 0, 0, 0.7);
  }

  .shop-slide-art img:nth-child(1) {
    transform: rotate(-5deg) translateY(20px);
  }

  .shop-slide-art img:nth-child(2) {
    transform: scale(1.08);
  }

  .shop-slide-art img:nth-child(3) {
    transform: rotate(5deg) translateY(20px);
  }

  .shop-carousel-controls {
    position: absolute;
    left: 50%;
    bottom: 1.6rem;
    z-index: 5;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .shop-carousel-controls button {
    border: 0;
    background: transparent;
    color: var(--color-sand);
    cursor: pointer;
  }

  #shop-prev,
  #shop-next {
    font-size: 2.5rem;
    line-height: 1;
  }

  .shop-dots {
    display: flex;
    gap: 0.6rem;
  }

  .shop-dot {
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 999px;
    border: 1px solid rgba(216, 169, 27, 0.35);
    background: rgba(241, 210, 152, 0.35);
  }

  .shop-dot.is-active {
    width: 1.7rem;
    background: var(--color-gold);
    border-color: var(--color-gold);
  }

  /* STORE */
  .shop-section {
    max-width: 1280px;
    margin: 0 auto;
    padding: 5rem clamp(1.5rem, 6vw, 3rem) 6rem;
  }

  .section-header {
    margin-bottom: 2rem;
    text-align: center;
  }

  .section-divider-line {
    width: 1px;
    height: 54px;
    margin: 0 auto 1.5rem;
    background: linear-gradient(var(--color-gold), transparent);
    opacity: 0.45;
  }

  .section-header h2,
  .store-sidebar h3 {
    font-family: var(--font-title);
    color: var(--color-sand);
  }

  .section-header h2 {
    font-size: clamp(2.2rem, 4vw, 3.3rem);
  }

  .store-layout {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .store-sidebar h3 {
    margin-bottom: 1.4rem;
    font-size: 1.8rem;
  }

  .collections-bar {
    margin-bottom: 2.4rem;
    padding-bottom: 1.4rem;
    border-bottom: 1px solid rgba(216, 169, 27, 0.16);
  }

  .filter-label {
    margin-bottom: 0.8rem;
    font-family: var(--font-body);
    font-size: 0.65rem;
    font-weight: 900;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-gold);
  }

  .shop-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }

  .shop-filters.vertical {
    flex-direction: column;
    align-items: flex-start;
  }

  .shop-filters.collections-row {
    margin-bottom: 0;
  }

  .shop-filter-btn {
    border: 1px solid rgba(216, 169, 27, 0.25);
    border-radius: 999px;
    background: rgba(0, 44, 35, 0.35);
    padding: 0.55rem 1rem;
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(241, 210, 152, 0.75);
    cursor: pointer;
    transition: 0.25s ease;
  }

  .shop-filter-btn:hover,
  .shop-filter-btn.is-active {
    background: var(--color-gold);
    color: var(--color-dark);
  }

  /* PRODUCTS */
  .product-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .product-card {
    overflow: hidden;
    border-radius: 1.6rem;
    border: 1px solid rgba(216, 169, 27, 0.14);
    background: rgba(0, 44, 35, 0.55);
    box-shadow: 0 20px 48px -28px rgba(0, 0, 0, 0.6);
  }

  .product-image {
    position: relative;
    aspect-ratio: 1 / 1;
    background: rgba(241, 210, 152, 0.08);
  }

  .product-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }


  .product-info {
    padding: 1.3rem;
  }

  .product-info p {
    font-family: var(--font-body);
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-gold);
  }

  .product-collection {
    display: block;
    margin-top: 0.35rem;
    font-family: var(--font-body);
    font-size: 0.75rem;
    color: rgba(241, 210, 152, 0.58);
  }

  .product-info h3 {
    margin-top: 0.5rem;
    min-height: 3rem;
    font-family: var(--font-title);
    font-size: 1.45rem;
    line-height: 1.1;
    color: var(--color-sand);
  }

  .product-info span:not(.product-collection) {
    display: block;
    margin-top: 1rem;
    font-family: var(--font-body);
    color: rgba(241, 210, 152, 0.8);
  }

  .product-info button {
    width: 100%;
    margin-top: 1.3rem;
    padding: 0.8rem 1rem;
    background: rgba(241, 210, 152, 0.1);
    color: var(--color-sand);
    font-size: 0.72rem;
  }

  /* CART */
  .store-cart-button {
    position: fixed;
    right: 1.4rem;
    bottom: 1.4rem;
    z-index: 70;
    width: 3.5rem;
    height: 3.5rem;
    display: grid;
    place-items: center;
    border: 1px solid rgba(216, 169, 27, 0.35);
    border-radius: 999px;
    background: var(--color-gold);
    color: var(--color-dark);
    box-shadow: 0 18px 45px -18px rgba(0, 0, 0, 0.75);
    cursor: pointer;
  }

  .store-cart-button svg {
    width: 1.4rem;
    height: 1.4rem;
  }

  .cart-overlay {
    position: fixed;
    inset: 0;
    z-index: 80;
    background: rgba(0, 0, 0, 0.55);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .cart-overlay.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  .cart-drawer {
    position: fixed;
    inset: 0 0 0 auto;
    z-index: 90;
    width: min(100vw, 430px);
    display: flex;
    flex-direction: column;
    background: var(--color-sand);
    color: var(--color-dark);
    transform: translateX(100%);
    transition: transform 0.35s ease;
  }

  .cart-drawer.is-open {
    transform: translateX(0);
  }

  .cart-header,
  .cart-footer {
    background: var(--color-dark);
  }

  .cart-header {
    min-height: 82px;
    padding: 1.4rem 1.6rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--color-gold);
  }

  .cart-header h2 {
    font-family: var(--font-title);
    font-size: 1.8rem;
    text-transform: uppercase;
  }

  .cart-header button,
  .cart-remove {
    border: 0;
    background: transparent;
    font-family: var(--font-body);
    font-weight: 900;
    text-transform: uppercase;
    cursor: pointer;
  }

  .cart-header button {
    color: var(--color-gold);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
  }

  .cart-items {
    flex: 1;
    overflow-y: auto;
    padding: 1.6rem;
  }

  .cart-empty {
    margin-top: 30vh;
    text-align: center;
    font-family: var(--font-title);
    font-size: 1.6rem;
    text-transform: uppercase;
  }

  .cart-item {
    display: grid;
    grid-template-columns: 92px 1fr;
    gap: 1rem;
    margin-bottom: 1.4rem;
    padding-bottom: 1.4rem;
    border-bottom: 1px solid rgba(0, 56, 48, 0.15);
  }

  .cart-item img {
    width: 92px;
    height: 92px;
    object-fit: cover;
    border-radius: 1rem;
  }

  .cart-item-info p {
    font-family: var(--font-body);
    font-size: 0.62rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(0, 56, 48, 0.65);
  }

  .cart-item-info h3 {
    margin-top: 0.3rem;
    font-family: var(--font-title);
    font-size: 1.1rem;
  }

  .cart-item-info span {
    display: block;
    margin-top: 0.4rem;
    font-family: var(--font-body);
    font-weight: 700;
  }

  .cart-qty {
    margin-top: 0.7rem;
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }

  .cart-qty button {
    width: 28px;
    height: 28px;
    border: 1px solid rgba(0, 56, 48, 0.25);
    background: transparent;
    color: var(--color-dark);
    cursor: pointer;
  }

  .cart-remove {
    grid-column: 2;
    width: max-content;
    color: rgba(0, 56, 48, 0.6);
    font-size: 0.7rem;
  }

  .cart-footer {
    padding: 1.6rem;
    color: var(--color-sand);
  }

  .cart-total-row {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-title);
    font-size: 1.6rem;
    color: var(--color-gold);
    text-transform: uppercase;
  }

  .cart-note {
    margin-top: 0.6rem;
    font-family: var(--font-body);
    font-size: 0.78rem;
    color: rgba(241, 210, 152, 0.65);
  }

  .checkout-btn {
    width: 100%;
    margin-top: 1.2rem;
    padding: 1rem;
    background: var(--color-gold);
    color: var(--color-dark);
    font-size: 0.8rem;
  }

  /* RESPONSIVE */
  @media (max-width: 1050px) {
    .store-layout {
      grid-template-columns: 1fr;
    }

    .shop-filters.vertical {
      flex-direction: row;
    }

    .product-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 900px) {
    .shop-slide {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .shop-lead {
      margin-inline: auto;
    }

    .shop-slide-art img {
      width: min(30vw, 180px);
    }
  }

  @media (max-width: 600px) {
    .shop-page {
      padding-top: 5.5rem;
    }

    .shop-hero-carousel {
      min-height: 92vh;
      margin: 0 1rem;
    }

    .shop-slide {
      padding: 2rem 1.4rem 5rem;
    }

    .shop-slide-art {
      flex-direction: column;
      gap: 0.8rem;
    }

    .shop-slide-art img {
      width: min(68vw, 220px);
      transform: none !important;
    }

    .product-grid {
      grid-template-columns: 1fr;
    }

    .store-cart-button {
      right: 1rem;
      bottom: 1rem;
    }
  }
</style>

<script>
  // HERO CAROUSEL
  const slides = document.querySelectorAll(".shop-slide");
  const dots = document.querySelectorAll(".shop-dot");
  const prevBtn = document.getElementById("shop-prev");
  const nextBtn = document.getElementById("shop-next");

  let currentSlide = 0;

  function showSlide(index) {
    currentSlide = (index + slides.length) % slides.length;

    slides.forEach((slide) => slide.classList.remove("is-active"));
    dots.forEach((dot) => dot.classList.remove("is-active"));

    slides[currentSlide]?.classList.add("is-active");
    dots[currentSlide]?.classList.add("is-active");
  }

  prevBtn?.addEventListener("click", () => showSlide(currentSlide - 1));
  nextBtn?.addEventListener("click", () => showSlide(currentSlide + 1));

  dots.forEach((dot) => {
    dot.addEventListener("click", () => {
      showSlide(Number(dot.dataset.slide));
    });
  });

  // FILTERS
  const categoryButtons = document.querySelectorAll("[data-category-filter]");
  const collectionButtons = document.querySelectorAll("[data-collection-filter]");
  const productCards = document.querySelectorAll(".product-card");

  let activeCategory = "All";
  let activeCollection = "All";

  categoryButtons[0]?.classList.add("is-active");
  collectionButtons[0]?.classList.add("is-active");

  function applyFilters() {
    productCards.forEach((card) => {
      const cardCategory = card.dataset.category;
      const cardCollection = card.dataset.collection;

      const categoryMatch =
        activeCategory === "All" || cardCategory === activeCategory;

      const collectionMatch =
        activeCollection === "All" || cardCollection === activeCollection;

      card.style.display = categoryMatch && collectionMatch ? "block" : "none";
    });
  }

  categoryButtons.forEach((button) => {
    button.addEventListener("click", () => {
      activeCategory = button.dataset.categoryFilter;

      categoryButtons.forEach((btn) => btn.classList.remove("is-active"));
      button.classList.add("is-active");

      applyFilters();
    });
  });

  collectionButtons.forEach((button) => {
    button.addEventListener("click", () => {
      activeCollection = button.dataset.collectionFilter;

      collectionButtons.forEach((btn) => btn.classList.remove("is-active"));
      button.classList.add("is-active");

      applyFilters();
    });
  });

  // CART
  const cartOpen = document.getElementById("cart-open");
  const addButtons = document.querySelectorAll(".add-to-cart-btn");
  const cartDrawer = document.getElementById("cart-drawer");
  const cartOverlay = document.getElementById("cart-overlay");
  const cartClose = document.getElementById("cart-close");
  const cartItems = document.getElementById("cart-items");
  const cartTotal = document.getElementById("cart-total");

  let cart = JSON.parse(localStorage.getItem("eire-cart")) || [];

  function openCart() {
    cartDrawer?.classList.add("is-open");
    cartOverlay?.classList.add("is-open");
  }

  function closeCart() {
    cartDrawer?.classList.remove("is-open");
    cartOverlay?.classList.remove("is-open");
  }

  function saveCart() {
    localStorage.setItem("eire-cart", JSON.stringify(cart));
  }

  function getPriceNumber(price) {
    return Number(String(price).replace("€", ""));
  }

  function renderCart() {
    if (!cartItems || !cartTotal) return;

    if (cart.length === 0) {
      cartItems.innerHTML = `<p class="cart-empty">Your cart is empty</p>`;
      cartTotal.textContent = "€0.00";
      return;
    }

    cartItems.innerHTML = "";

    cart.forEach((item, index) => {
      const row = document.createElement("div");
      row.className = "cart-item";

      row.innerHTML = `
        <img src="${item.image}" alt="${item.title}" />

        <div class="cart-item-info">
          <p>${item.category}</p>
          <h3>${item.title}</h3>
          <span>${item.price}</span>

          <div class="cart-qty">
            <button type="button" data-action="decrease" data-index="${index}">−</button>
            <strong>${item.quantity}</strong>
            <button type="button" data-action="increase" data-index="${index}">+</button>
          </div>
        </div>

        <button class="cart-remove" type="button" data-action="remove" data-index="${index}">
          Remove
        </button>
      `;

      cartItems.appendChild(row);
    });

    const total = cart.reduce((sum, item) => {
      return sum + getPriceNumber(item.price) * item.quantity;
    }, 0);

    cartTotal.textContent = `€${total.toFixed(2)}`;
  }

  cartOpen?.addEventListener("click", openCart);

  addButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const product = {
        title: button.dataset.title,
        category: button.dataset.category,
        price: button.dataset.price,
        image: button.dataset.image,
        quantity: 1,
      };

      const existing = cart.find((item) => item.title === product.title);

      if (existing) {
        existing.quantity += 1;
      } else {
        cart.push(product);
      }

      saveCart();
      renderCart();
      openCart();
    });
  });

  cartItems?.addEventListener("click", (e) => {
    const button = e.target.closest("button");
    if (!button) return;

    const index = Number(button.dataset.index);
    const action = button.dataset.action;

    if (action === "increase") cart[index].quantity += 1;

    if (action === "decrease") {
      cart[index].quantity -= 1;
      if (cart[index].quantity <= 0) cart.splice(index, 1);
    }

    if (action === "remove") cart.splice(index, 1);

    saveCart();
    renderCart();
  });

  cartClose?.addEventListener("click", closeCart);
  cartOverlay?.addEventListener("click", closeCart);

  renderCart();
</script>
