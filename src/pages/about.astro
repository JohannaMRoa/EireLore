---
import Layout from "../layouts/Layout.astro";
---

<Layout title="About">
  <section class="relative overflow-hidden px-6 pt-32 pb-20 md:px-10">
    <img
      src="/assets/candle-2.gif"
      alt=""
      class="fixed inset-0 -z-20 h-full w-full object-cover"
    />

    <div class="fixed inset-0 -z-10 bg-black/55"></div>

    <div class="mx-auto max-w-7xl">

            <img
              src="/logo.svg"
              alt="Éire Lore"
              class="relative h-36 w-auto md:h-115"
            />
          </div>
        </h1>

        <p class="text-box mx-auto mt-8 max-w-2xl text-base leading-relaxed text-sand/75 md:text-lg">
          Discover the ideas, goals, and cultural motivations behind a digital
          heritage project that reimagines Irish legends through interactive storytelling.
        </p>
      </div>

      <!-- INTRO -->
      <section class="story-block flex min-h-[70vh] items-center py-16">
        <div class="text-box mx-auto max-w-4xl rounded-[2rem] border border-white/8 bg-dark/30 p-8 text-center backdrop-blur-sm md:p-10">
          <p class="mx-auto max-w-2xl leading-relaxed text-sand/75 md:text-lg">
            Éire Lore is an interactive digital heritage project that brings Irish
            legends to life through 3D-printed figures and QR-based storytelling.
            Each collectible object connects users to immersive legend pages with
            narration, visuals, and animated story moments.
          </p>
        </div>
      </section>

      <!-- GOALS -->
      <section class="story-block py-20">
        <div class="mx-auto max-w-7xl">
          <div class="text-box mx-auto max-w-3xl text-center">
            <h2 class="text-4xl font-semibold text-sand md:text-5xl">
              Goals
            </h2>

            <p class="mt-6 text-base leading-relaxed text-sand/75 md:text-lg">
              The project aims to make Irish mythology more engaging, accessible, and
              memorable through digital storytelling, visual design, and immersive interaction.
            </p>
          </div>

          <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
            <div class="text-box rounded-[1.6rem] border border-white/8 bg-dark/30 p-6 transition duration-300 hover:-translate-y-1 hover:bg-dark/40">
              <p class="text-sm uppercase tracking-[0.14em] text-gold/75">01</p>
              <h3 class="mt-4 text-2xl font-semibold text-sand">Preserve Folklore</h3>
              <p class="mt-4 text-sm leading-relaxed text-sand/65">
                Keep traditional stories visible and meaningful for new audiences.
              </p>
            </div>

            <div class="text-box rounded-[1.6rem] border border-white/8 bg-dark/30 p-6 transition duration-300 hover:-translate-y-1 hover:bg-dark/40">
              <p class="text-sm uppercase tracking-[0.14em] text-gold/75">02</p>
              <h3 class="mt-4 text-2xl font-semibold text-sand">Engage Through Design</h3>
              <p class="mt-4 text-sm leading-relaxed text-sand/65">
                Use visual storytelling to make legends more emotional and memorable.
              </p>
            </div>

            <div class="text-box rounded-[1.6rem] border border-white/8 bg-dark/30 p-6 transition duration-300 hover:-translate-y-1 hover:bg-dark/40">
              <p class="text-sm uppercase tracking-[0.14em] text-gold/75">03</p>
              <h3 class="mt-4 text-2xl font-semibold text-sand">Improve Access</h3>
              <p class="mt-4 text-sm leading-relaxed text-sand/65">
                Allow users to explore legends easily through a simple web experience.
              </p>
            </div>

            <div class="text-box rounded-[1.6rem] border border-white/8 bg-dark/30 p-6 transition duration-300 hover:-translate-y-1 hover:bg-dark/40">
              <p class="text-sm uppercase tracking-[0.14em] text-gold/75">04</p>
              <h3 class="mt-4 text-2xl font-semibold text-sand">Create Interaction</h3>
              <p class="mt-4 text-sm leading-relaxed text-sand/65">
                Connect physical figures with digital stories through QR access.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- PURPOSE -->
      <section class="story-block flex min-h-[75vh] items-center py-20">
        <div class="mx-auto grid max-w-7xl items-center gap-10 lg:grid-cols-[1.1fr_0.9fr]">
          <div class="text-box">
            <p class="text-sm uppercase tracking-[0.18em] text-gold/75">
              Project Direction
            </p>

            <h2 class="mt-4 text-5xl font-semibold leading-none text-sand md:text-7xl">
              Purpose
            </h2>

            <p class="mt-8 max-w-2xl text-lg leading-relaxed text-sand/75">
              Éire Lore reconnects modern audiences with Irish mythology through
              accessible, portable, and emotionally engaging digital storytelling.
              By combining physical artefacts with responsive web experiences, the
              project bridges heritage and contemporary interaction.
            </p>
          </div>

          <div class="grid gap-5">
            <div class="text-box rounded-[1.6rem] border border-white/8 bg-dark/30 p-6 backdrop-blur-sm">
              <h3 class="text-lg font-semibold text-sand">Accessible</h3>
              <p class="mt-2 text-sm leading-relaxed text-sand/68">
                Web-based and QR-driven, without the need for a dedicated app.
              </p>
            </div>

            <div class="text-box rounded-[1.6rem] border border-white/8 bg-dark/30 p-6 backdrop-blur-sm">
              <h3 class="text-lg font-semibold text-sand">Portable</h3>
              <p class="mt-2 text-sm leading-relaxed text-sand/68">
                Designed to move beyond museums and exist in everyday spaces.
              </p>
            </div>

            <div class="text-box rounded-[1.6rem] border border-white/8 bg-dark/30 p-6 backdrop-blur-sm">
              <h3 class="text-lg font-semibold text-sand">Immersive</h3>
              <p class="mt-2 text-sm leading-relaxed text-sand/68">
                Uses narration, visuals, and interaction to create emotional connection.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- CULTURE -->
      <section class="story-block flex min-h-[75vh] items-center py-20">
        <div class="w-full max-w-7xl">
          <div class="text-box mx-auto max-w-3xl text-center">
            <h2 class="text-4xl font-semibold text-sand md:text-5xl">
              Culture & Nostalgia
            </h2>

            <p class="mt-6 leading-relaxed text-sand/75">
              Many people first encounter Irish legends during childhood, but rarely
              revisit them later in life. This project reintroduces those stories
              through nostalgia, cultural identity, and digital immersion.
            </p>
          </div>

          <div class="mt-16 grid gap-8 md:grid-cols-3">
            <div class="text-box rounded-[2rem] border border-white/8 bg-dark/30 p-8 text-center backdrop-blur-sm transition duration-300 hover:-translate-y-1">
              <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full border border-gold/30 bg-gold/10 text-2xl text-gold">
                01
              </div>

              <h3 class="mt-6 text-2xl font-semibold text-sand">Cultural Identity</h3>

              <p class="mx-auto mt-4 max-w-xs text-sm leading-relaxed text-sand/68">
                Irish myths reflect a shared cultural identity, connecting landscape,
                history, and imagination across generations.
              </p>
            </div>

            <div class="text-box rounded-[2rem] border border-white/8 bg-dark/30 p-8 text-center backdrop-blur-sm transition duration-300 hover:-translate-y-1">
              <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full border border-gold/30 bg-gold/10 text-2xl text-gold">
                02
              </div>

              <h3 class="mt-6 text-2xl font-semibold text-sand">Living Memory</h3>

              <p class="mx-auto mt-4 max-w-xs text-sm leading-relaxed text-sand/68">
                These stories can bring back memories of school, storytelling,
                family traditions, and childhood discovery.
              </p>
            </div>

            <div class="text-box rounded-[2rem] border border-white/8 bg-dark/30 p-8 text-center backdrop-blur-sm transition duration-300 hover:-translate-y-1">
              <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full border border-gold/30 bg-gold/10 text-2xl text-gold">
                03
              </div>

              <h3 class="mt-6 text-2xl font-semibold text-sand">Modern Rediscovery</h3>

              <p class="mx-auto mt-4 max-w-xs text-sm leading-relaxed text-sand/68">
                Digital interaction gives familiar legends a new presence, making
                them feel contemporary, accessible, and alive again.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- FINAL SECTION -->
      <section class="story-block flex min-h-[65vh] items-center py-20">
        <div class="text-box mx-auto max-w-4xl rounded-[2rem] border border-white/8 bg-dark/30 p-8 text-center backdrop-blur-sm md:p-10">
          <h2 class="text-4xl font-semibold text-sand md:text-5xl">
            A New Way to Experience Legends
          </h2>

          <p class="mt-6 leading-relaxed text-sand/75">
            Éire Lore transforms passive reading into active discovery. Through
            design, storytelling, and interaction, the project invites users to
            experience Irish legends as something visual, emotional, and memorable.
          </p>
        </div>
      </section>
    </div>
  </section>
</Layout>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const boxes = document.querySelectorAll(".text-box");

  boxes.forEach((box, index) => {
    gsap.fromTo(
      box,
      {
        opacity: 0,
        y: 60,
        scale: 0.95,
        filter: "blur(6px)",
      },
      {
        opacity: 1,
        y: 0,
        scale: 1,
        filter: "blur(0px)",
        duration: 1,
        delay: (index % 3) * 0.1,
        ease: "power3.out",
        scrollTrigger: {
          trigger: box,
          start: "top 75%",
          toggleActions: "play none none reverse",
        },
      }
    );
  });
</script>