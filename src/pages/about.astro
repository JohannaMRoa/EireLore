---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Éire Lore — About">
  <img src="/assets/candle-1.gif" alt="" class="page-bg" />
  <div class="page-overlay"></div>

  <main class="about-page">

    <section class="about-video-section">
      <div class="video-frame anim-item">
        <video src="/about/about-banner.mp4" autoplay muted loop playsinline></video>
        <div class="video-overlay"></div>

        <div class="video-content">
          <p class="about-eyebrow">Video content</p>
        </div>
      </div>
    </section>

    <section class="about-intro">
      <div class="about-intro-inner">
        <p class="about-main-text anim-item">
          Éire Lore is an interactive digital heritage project that brings Irish
          legends out of the archive and into the everyday.
        </p>

        <p class="about-quote anim-item">
          The legends were always here.<br />
          <span>We just built a key.</span>
        </p>
      </div>
    </section>

    <section class="goals-section">
      <div class="goals-layout">
        <div class="goals-copy anim-item">
          <p>
            Our goal is to make Irish folklore easier to discover, more engaging
            to experience, and more meaningful for new audiences.
          </p>
        </div>

        <div class="goals-cards">
          <article class="goal-flip-card anim-item">
            <div class="goal-flip-inner">
              <div class="goal-card-face goal-card-front">
                <div class="goal-icon">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <path d="M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z"/>
                    <path d="M20 2v4"/><path d="M22 4h-4"/><circle cx="4" cy="20" r="2"/>
                  </svg>
                </div>
                <h3>Engage</h3>
              </div>

              <div class="goal-card-face goal-card-back">
                <p>
                  We use design, narration, and visual storytelling to make every
                  legend something you don't just read — you feel.
                </p>
              </div>
            </div>
          </article>

          <article class="goal-flip-card anim-item">
            <div class="goal-flip-inner">
              <div class="goal-card-face goal-card-front">
                <div class="goal-icon">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <path d="M10.638 20H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3.9a2 2 0 0 1 1.69.9l.81 1.2a2 2 0 0 0 1.67.9H20a2 2 0 0 1 2 2v3.417"/>
                    <path d="M14.62 18.8A2.25 2.25 0 1 1 18 15.836a2.25 2.25 0 1 1 3.38 2.966l-2.626 2.856a.998.998 0 0 1-1.507 0z"/>
                  </svg>
                </div>
                <h3>Preserve</h3>
              </div>

              <div class="goal-card-face goal-card-back">
                <p>Folklore lives in the telling. We give it a digital home.</p>
              </div>
            </div>
          </article>

          <article class="goal-flip-card anim-item">
            <div class="goal-flip-inner">
              <div class="goal-card-face goal-card-front">
                <div class="goal-icon">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <path d="M2 20h20"/>
                    <path d="m9 10 2 2 4-4"/>
                    <rect x="3" y="4" width="18" height="12" rx="2"/>
                  </svg>
                </div>
                <h3>Access</h3>
              </div>

              <div class="goal-card-face goal-card-back">
                <p>
                  We shaped every format and channel so nothing stands between you
                  and the lore.
                </p>
              </div>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="culture-banner anim-item">
      <div>
        <p class="about-eyebrow">Culture & Nostalgia</p>
        <h2>Stories carried through memory</h2>
        <p>
          Most people met these stories as children in classrooms, in bedtime
          retellings, in the names of places we passed on long drives.
        </p>
      </div>
    </section>

  </main>
</Layout>

<style>
  :root {
    --dark: #003830;
    --teal: #106b66;
    --gold: #d8a91b;
    --sand: #f1d298;
    --font-title: "Playfair Display", Georgia, serif;
    --font-body: "Montserrat", "Segoe UI", sans-serif;
    --ease: cubic-bezier(0.22, 1, 0.36, 1);
  }

  .page-bg {
    position: fixed;
    inset: 0;
    z-index: -20;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .page-overlay {
    position: fixed;
    inset: 0;
    z-index: -10;
    background: rgba(0, 0, 0, 0.6);
  }

  .about-page {
    min-height: 100vh;
    overflow-x: hidden;
  }

  .about-eyebrow {
    font-family: var(--font-body);
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--gold);
  }

  .about-video-section {
    padding: clamp(6rem, 14vh, 9rem) clamp(1.25rem, 5vw, 3rem) 4rem;
  }

  .video-frame {
    position: relative;
    min-height: 68vh;
    overflow: hidden;
    border-radius: 2rem;
    border: 1px solid rgba(216, 169, 27, 0.18);
    background: rgba(0, 44, 35, 0.6);
    box-shadow: 0 30px 80px -45px rgba(0, 0, 0, 0.8);
  }

  .video-frame video,
  .video-overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .video-frame video {
    object-fit: cover;
  }

  .video-overlay {
    background:
      radial-gradient(circle at 70% 30%, rgba(216, 169, 27, 0.15), transparent 35%),
      linear-gradient(to top, rgba(0, 30, 24, 0.95), rgba(0, 30, 24, 0.2));
  }

  .video-content {
    position: absolute;
    left: 50%;
    bottom: 12%;
    width: min(900px, 90%);
    transform: translateX(-50%);
    text-align: center;
  }

  .about-intro {
    padding: 3rem clamp(1.5rem, 6vw, 3rem) 5rem;
  }

  .about-intro-inner {
    max-width: 900px;
    margin: 0 auto;
    text-align: center;
  }

  .about-main-text {
    font-family: var(--font-body);
    font-size: clamp(1.05rem, 2vw, 1.35rem);
    line-height: 1.85;
    color: rgba(241, 210, 152, 0.72);
  }

  .about-quote {
    margin-top: 2.5rem;
    font-family: var(--font-title);
    font-size: clamp(2rem, 5vw, 4rem);
    line-height: 1.08;
    color: var(--sand);
  }

  .about-quote span {
    color: var(--gold);
    font-style: italic;
  }

  .goals-section {
    max-width: 1280px;
    margin: 0 auto;
    padding: clamp(5rem, 10vw, 9rem) clamp(1.5rem, 6vw, 3rem);
  }

  .goals-layout {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4rem;
    text-align: center;
  }

  .goals-copy p {
    max-width: 34ch;
    margin: 0 auto;
    font-family: var(--font-body);
    font-size: clamp(1.25rem, 2.4vw, 2rem);
    line-height: 1.9;
    color: rgba(241, 210, 152, 0.78);
  }

  .goals-copy p::first-line {
    color: var(--sand);
    font-weight: 600;
  }

  .goals-cards {
    display: grid;
    width: 100%;
    max-width: 980px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.4rem;
  }

  .goal-flip-card {
    aspect-ratio: 1 / 1;
    perspective: 1200px;
    cursor: pointer;
  }

  .goal-flip-inner {
    position: relative;
    height: 100%;
    transform-style: preserve-3d;
    transition: transform 0.8s var(--ease);
  }

  .goal-flip-card:hover .goal-flip-inner,
  .goal-flip-card.is-flipped .goal-flip-inner {
    transform: rotateY(180deg);
  }

  .goal-card-face {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 2rem 1.4rem;
    border: 1px solid rgba(216, 169, 27, 0.28);
    border-radius: 1.5rem;
    background: rgba(0, 44, 35, 0.18);
    box-shadow: 0 24px 60px -35px rgba(0, 0, 0, 0.7);
    text-align: center;
    backdrop-filter: blur(14px);
    backface-visibility: hidden;
  }

  .goal-card-back {
    transform: rotateY(180deg);
  }

  .goal-icon {
    margin-bottom: 1.4rem;
    color: var(--gold);
  }

  .goal-icon svg {
    width: 48px;
    height: 48px;
    stroke-width: 1.7;
  }

  .goal-card-front h3 {
    font-family: var(--font-title);
    font-size: clamp(2rem, 3vw, 2.8rem);
    line-height: 1;
    color: var(--sand);
  }

  .goal-card-back p {
    max-width: 20ch;
    font-family: var(--font-body);
    font-size: clamp(0.9rem, 1.2vw, 1rem);
    line-height: 1.7;
    color: rgba(241, 210, 152, 0.8);
  }

  .culture-banner {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: clamp(4rem, 8vw, 7rem) clamp(1.5rem, 5vw, 3rem);
    background: var(--gold);
    text-align: center;
  }

  .culture-banner > div {
    max-width: 950px;
  }

  .culture-banner .about-eyebrow,
  .culture-banner h2 {
    color: var(--dark);
  }

  .culture-banner h2 {
    margin-top: 1rem;
    font-family: var(--font-title);
    font-size: clamp(3rem, 7vw, 6rem);
    line-height: 0.98;
  }

  .culture-banner p {
    max-width: 42ch;
    margin: 2rem auto 0;
    font-family: var(--font-body);
    font-size: clamp(1.05rem, 2vw, 1.3rem);
    line-height: 1.9;
    color: rgba(0, 56, 48, 0.85);
  }

  .anim-item {
    opacity: 0;
    transform: translateY(40px) scale(0.97);
    filter: blur(6px);
  }

  @media (max-width: 900px) {
    .goals-cards {
      max-width: 760px;
      grid-template-columns: 1fr;
    }

    .goal-flip-card {
      width: min(100%, 340px);
      margin: 0 auto;
    }
  }

  @media (max-width: 600px) {
    .about-video-section {
      padding-top: 5.5rem;
    }

    .video-frame {
      min-height: 56vh;
      border-radius: 1.25rem;
    }

    .about-intro {
      padding-bottom: 3rem;
    }

    .goals-layout {
      gap: 3rem;
    }

    .culture-banner h2 {
      font-size: clamp(2.6rem, 14vw, 4rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .anim-item {
      opacity: 1;
      transform: none;
      filter: none;
    }

    .goal-flip-inner {
      transition: none;
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  document.querySelectorAll(".anim-item").forEach((el, i) => {
    gsap.fromTo(
      el,
      { opacity: 0, y: 45, scale: 0.97, filter: "blur(6px)" },
      {
        opacity: 1,
        y: 0,
        scale: 1,
        filter: "blur(0px)",
        duration: 1,
        delay: (i % 3) * 0.12,
        ease: "power3.out",
        scrollTrigger: {
          trigger: el,
          start: "top 78%",
          once: true,
        },
      }
    );
  });

  document.querySelectorAll(".goal-flip-card").forEach((card) => {
    card.addEventListener("click", () => {
      card.classList.toggle("is-flipped");
    });
  });
</script>