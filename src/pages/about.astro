---
import Layout from "../layouts/Layout.astro";
---

<Layout title="About — Éire Lore">

  <img
    src="/assets/candle-1.gif"
    alt=""
    class="fixed inset-0 -z-20 h-full w-full object-cover"
  />
  <div class="fixed inset-0 -z-10 bg-black/55"></div>

  <main class="about-page">
<!-- ── HERO ── -->
<section class="about-hero">
  <div class="about-hero-inner">
        <p class="hero-eyebrow anim-item"> Welcome</p>

    <h1 class="hero-title anim-item">
      Irish mythology wasn't<br/>
      meant to be <span class="hero-title-accent">archived.</span><br/>
      It was meant to be <span class="hero-title-accent">felt.</span>
    </h1>
<br>


    <img
      src="/logo.svg"
      alt="Éire Lore"
      class="hero-logo anim-item"
    />

  </div>

</section>

    <!-- ── PROJECT INTRO ── -->
    <section class="about-block intro-block">
      <div class="intro-card anim-item">
        <p class="intro-body">
          Éire Lore is an interactive digital heritage project that brings Irish
          legends out of the archive and into the everyday.
        </p>
        <p class="intro-key anim-item">
          The legends were always here.<br/>
          <em>We just built a key.</em>
        </p>
      </div>
    </section>

    <!-- ── GOALS ── -->
    <section class="about-block goals-block">
      <div class="goals-inner">

        <div class="goals-header anim-item">
          <p class="section-eyebrow">Our</p>
          <h2 class="section-title">Mission</h2>
        </div>

        <div class="goals-grid">

          <div class="goal-card anim-item">
            <span class="goal-num">01</span>
            <h3 class="goal-title">Engage</h3>
            <p class="goal-body">
              We use design, narration, and visual storytelling to make every
              legend something you don't just read — you feel.
            </p>
          </div>

          <div class="goal-card anim-item">
            <span class="goal-num">02</span>
            <h3 class="goal-title">Preserve</h3>
            <p class="goal-body">
              Folklore lives in the telling. We give it a digital home.
            </p>
          </div>

          <div class="goal-card anim-item">
            <span class="goal-num">03</span>
            <h3 class="goal-title">Access</h3>
            <p class="goal-body">
              We shaped every format and channel so nothing stands between
              you and the lore.
            </p>
          </div>

        </div>
      </div>
    </section>

    <!-- ── CULTURE & NOSTALGIA ── -->
    <section class="about-block culture-block">
      <div class="culture-inner">

        <div class="culture-text anim-item">
          <p class="section-eyebrow">Culture &amp; Nostalgia</p>
          <h2 class="section-title culture-title">
            Stories you <span class="hero-title-accent">already know.</span>
          </h2>
          <p class="culture-body">
            Most people encounter these stories as children — in classrooms, in
            bedtime retellings, in the places we passed on long drives. 
          </p>
        </div>


      </div>
    </section>

    <!-- ── CLOSING ── -->
    <section class="about-block closing-block">
      <div class="closing-inner anim-item">
        <div class="closing-line"></div>
        <p class="closing-phrase">
          Éire Lore is an invitation<br/>
          <em>to return.</em>
        </p>
        <div class="closing-cta">
          <a href="/myths" class="btn-primary">Explore Legends</a>

        </div>
      </div>
    </section>

  </main>
</Layout>

<style>
  :root {
    --dark:       #003830;
    --teal:       #106B66;
    --gold:       #D8A91B;
    --gold-dim:   rgba(216, 169, 27, 0.35);
    --gold-glow:  rgba(216, 169, 27, 0.12);
    --sand:       #F1D298;
    --sand-dim:   rgba(241, 210, 152, 0.65);
    --sand-muted: rgba(241, 210, 152, 0.40);
    --font-title: "Playfair Display", Georgia, serif;
    --font-body:  "Montserrat", "Segoe UI", sans-serif;
    --ease:       cubic-bezier(0.22, 1, 0.36, 1);
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  .about-page {
    min-height: 100vh;
    overflow-x: hidden;
  }

  /* ── SHARED TOKENS ── */
  .section-eyebrow {
    font-family: var(--font-body);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 0.9rem;
  }

  .section-title {
    font-family: var(--font-title);
    font-weight: 700;
    font-size: clamp(2.2rem, 4.5vw, 3.2rem);
    line-height: 1.1;
    color: var(--sand);
    margin-top: 0.4rem;
  }

  /* ── HERO ── */
  .about-hero {
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: clamp(5rem, 14vh, 9rem) clamp(1.25rem, 5vw, 3rem) clamp(3rem, 6vh, 5rem);
    position: relative;
    background: radial-gradient(
      ellipse 70% 55% at 50% 42%,
      rgba(16, 107, 102, 0.22) 0%,
      transparent 70%
    );
  }

  .about-hero-inner {
    max-width: min(800px, 100%);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

 .hero-logo {
  height: clamp(8rem, 22vw, 16rem);
  width: auto;
  margin-top: clamp(2.5rem, 5vh, 4rem);
  opacity: 0.95;
}

.hero-title {
  font-family: var(--font-title);
  font-weight: 700;
  font-size: clamp(1.4rem, 3.5vw, 2.4rem);
  line-height: 1.25;
  color: var(--sand);
  letter-spacing: -0.01em;
}

  .hero-eyebrow {
    font-family: var(--font-body);
    font-size: clamp(0.58rem, 1.5vw, 0.65rem);
    font-weight: 700;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: clamp(0.75rem, 2vh, 1.25rem);
    position: relative;
    padding-bottom: 0.9rem;
  }
  .hero-eyebrow::after {
    content: "";
    position: absolute;
    bottom: 0; left: 50%;
    transform: translateX(-50%);
    width: 24px; height: 1px;
    background: var(--gold);
    opacity: 0.5;
  }

  .hero-title {
    font-family: var(--font-title);
    font-weight: 700;
    font-size: clamp(2rem, 5.5vw, 4rem);
    line-height: 1.15;
    color: var(--sand);
    letter-spacing: -0.01em;
  }

  .hero-title-accent {
    font-style: italic;
    color: var(--gold);
    text-shadow: 0 0 60px rgba(216, 169, 27, 0.25);
  }

  .hero-fade {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 140px;
    background: linear-gradient(to bottom, transparent, rgba(0, 30, 24, 0.65));
    pointer-events: none;
  }

  /* ── SHARED BLOCK ── */
  .about-block {
    padding: clamp(5rem, 10vh, 8rem) clamp(1.25rem, 5vw, 3rem);
  }

  /* ── INTRO ── */
  .intro-block {
    display: flex;
    justify-content: center;
  }

  .intro-card {
    max-width: 680px;
    text-align: center;
    border: 1px solid rgba(255,255,255,0.07);
    background: rgba(0, 30, 24, 0.35);
    border-radius: 2rem;
    padding: clamp(2.5rem, 5vw, 4rem) clamp(2rem, 4vw, 3.5rem);
    backdrop-filter: blur(8px);
  }

  .intro-body {
    font-family: var(--font-body);
    font-size: clamp(1rem, 2.2vw, 1.2rem);
    line-height: 1.85;
    color: var(--sand-dim);
  }

  .intro-key {
    margin-top: 2rem;
    font-family: var(--font-title);
    font-size: clamp(1.3rem, 3vw, 1.9rem);
    line-height: 1.4;
    color: var(--sand);
  }
  .intro-key em {
    color: var(--gold);
    font-style: italic;
  }

  /* ── GOALS ── */
  .goals-block {
    background: radial-gradient(
      ellipse 80% 50% at 50% 50%,
      rgba(16, 107, 102, 0.12) 0%,
      transparent 70%
    );
  }

  .goals-inner {
    max-width: 1100px;
    margin: 0 auto;
  }

  .goals-header {
    text-align: center;
    margin-bottom: clamp(3rem, 6vh, 5rem);
  }

  .goals-grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  }

  .goal-card {
    border: 1px solid rgba(255,255,255,0.07);
    background: rgba(0, 30, 24, 0.35);
    border-radius: 1.6rem;
    padding: 2.5rem 2rem;
    backdrop-filter: blur(6px);
    transition: transform 0.3s var(--ease), background 0.3s;
  }
  .goal-card:hover {
    transform: translateY(-4px);
    background: rgba(0, 40, 30, 0.5);
  }

  .goal-num {
    font-family: var(--font-body);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(216, 169, 27, 0.6);
  }

  .goal-title {
    font-family: var(--font-title);
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 700;
    color: var(--sand);
    margin-top: 1rem;
    font-style: italic;
  }

  .goal-body {
    font-family: var(--font-body);
    font-size: 0.9rem;
    line-height: 1.75;
    color: var(--sand-muted);
    margin-top: 1rem;
  }

  .culture-block {
  display: flex;
  justify-content: center;
}

.culture-inner {
  max-width: 680px;
  text-align: center;
}

.culture-title {
  font-size: clamp(2rem, 4vw, 3rem);
}

.culture-body {
  font-family: var(--font-body);
  font-size: clamp(0.9rem, 1.8vw, 1rem);
  line-height: 1.85;
  color: var(--sand-dim);
  margin-top: 1.5rem;
}
  /* ── CLOSING ── */
  .closing-block {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 55vh;
  }

  .closing-inner {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.5rem;
  }

  .closing-line {
    width: 1px;
    height: clamp(36px, 5vh, 56px);
    background: linear-gradient(var(--gold), transparent);
    opacity: 0.4;
  }

  .closing-phrase {
    font-family: var(--font-title);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 700;
    line-height: 1.2;
    color: var(--sand);
  }
  .closing-phrase em {
    color: var(--gold);
    font-style: italic;
  }

  .closing-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(0.6rem, 2vw, 1rem);
    flex-wrap: wrap;
  }

  /* ── BUTTONS (same as index) ── */
  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--gold);
    color: var(--dark);
    font-family: var(--font-body);
    font-size: clamp(0.65rem, 1.5vw, 0.72rem);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 0.8rem 1.75rem;
    border-radius: 100px;
    min-height: 44px;
    white-space: nowrap;
    -webkit-tap-highlight-color: transparent;
    transition: background 0.25s var(--ease), transform 0.25s var(--ease), box-shadow 0.25s;
    box-shadow: 0 4px 24px rgba(216, 169, 27, 0.25);
  }
  @media (hover: hover) {
    .btn-primary:hover {
      background: var(--sand);
      transform: translateY(-3px);
      box-shadow: 0 8px 32px rgba(216, 169, 27, 0.35);
    }
  }
  .btn-primary:active { transform: translateY(-1px); }

  .btn-ghost {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--gold-dim);
    border-radius: 100px;
    padding: 0.78rem 1.5rem;
    font-family: var(--font-body);
    font-size: clamp(0.63rem, 1.5vw, 0.7rem);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--sand-muted);
    text-decoration: none;
    white-space: nowrap;
    min-height: 44px;
    -webkit-tap-highlight-color: transparent;
    transition: color 0.2s, border-color 0.2s, background 0.2s, transform 0.2s;
  }
  @media (hover: hover) {
    .btn-ghost:hover {
      color: var(--sand);
      border-color: rgba(216, 169, 27, 0.6);
      background: var(--gold-glow);
      transform: translateY(-2px);
    }
  }
  .btn-ghost:active { transform: translateY(0); }

  /* ── ENTRANCE ANIMATIONS ── */
  .anim-item {
    opacity: 0;
    transform: translateY(40px) scale(0.97);
    filter: blur(6px);
    transition:
      opacity   0.8s var(--ease),
      transform 0.8s var(--ease),
      filter    0.8s var(--ease);
  }
  .anim-item.is-visible {
    opacity: 1;
    transform: translateY(0) scale(1);
    filter: blur(0);
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 600px) {
    .hero-title { font-size: clamp(1.7rem, 8vw, 2.4rem); }
    .closing-cta { flex-direction: column; align-items: stretch; }
    .btn-primary, .btn-ghost { width: 100%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .anim-item { opacity: 1; transform: none; filter: none; transition: none; }
    .btn-primary:hover, .btn-ghost:hover { transform: none; }
    .goal-card:hover, .culture-marker:hover { transform: none; }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  // Hero items staggered on load
  document.querySelectorAll(".about-hero .anim-item").forEach((el, i) => {
    gsap.fromTo(el,
      { opacity: 0, y: 40, scale: 0.97, filter: "blur(6px)" },
      {
        opacity: 1, y: 0, scale: 1, filter: "blur(0px)",
        duration: 1, delay: 0.15 + i * 0.15, ease: "power3.out",
      }
    );
  });

  // Scroll-triggered reveals for everything else
  document.querySelectorAll(".about-block .anim-item").forEach((el, i) => {
    gsap.fromTo(el,
      { opacity: 0, y: 50, scale: 0.96, filter: "blur(6px)" },
      {
        opacity: 1, y: 0, scale: 1, filter: "blur(0px)",
        duration: 1,
        delay: (i % 3) * 0.1,
        ease: "power3.out",
        scrollTrigger: {
          trigger: el,
          start: "top 78%",
          toggleActions: "play none none reverse",
        },
      }
    );
  });
</script>
