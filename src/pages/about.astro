
---
import Layout from "../layouts/Layout.astro";

---

<Layout title="Éire Lore — About">

  <img
    src="/assets/candle-1.gif"
    alt=""
    class="fixed inset-0 -z-20 h-full w-full object-cover"
  />
  <div class="fixed inset-0 -z-10 bg-black/60"></div>

  <main class="about-page">

    <!-- VIDEO BANNER -->
    <section class="about-video-section">
      <div class="video-frame anim-item">
        <!-- Cambiá src por tu video -->
        <video
          src="/about/about-banner.mp4"
          autoplay
          muted
          loop
          playsinline
        ></video>

        <div class="video-overlay"></div>

        <div class="video-content">
          <p class="about-eyebrow">Video content</p>
        </div>
      </div>
    </section>

    <!-- INTRO TEXT -->
    <section class="about-intro">
      <div class="about-intro-inner">
        <p class="about-main-text anim-item">
          Éire Lore is an interactive digital heritage project that brings Irish
          legends out of the archive and into the everyday.
        </p>

        <p class="about-quote anim-item">
          The legends were always here.<br />
          <span>We just built a key.</span>
        </p>
      </div>
    </section>


    
<!-- GOALS -->
<section class="goals-section">
  <div class="goals-layout">

    <div class="goals-copy anim-item">

      <p>
        Our goal is to make Irish folklore easier to discover, more engaging to
        experience, and more meaningful for new audiences.
      </p>
    </div>

    <div class="goals-cards">

      <!-- ENGAGE -->
      <article class="goal-flip-card anim-item">
        <div class="goal-flip-inner">

          <div class="goal-card-face goal-card-front">
            <div class="goal-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z"/>
                <path d="M20 2v4"/>
                <path d="M22 4h-4"/>
                <circle cx="4" cy="20" r="2"/>
              </svg>
            </div>

            <h3>Engage</h3>
          </div>

          <div class="goal-card-face goal-card-back">
            <p>
              We use design, narration, and visual storytelling to make every
              legend something you don't just read — you feel.
            </p>
          </div>

        </div>
      </article>

      <!-- PRESERVE -->
      <article class="goal-flip-card anim-item">
        <div class="goal-flip-inner">

          <div class="goal-card-face goal-card-front">
            <div class="goal-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M10.638 20H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3.9a2 2 0 0 1 1.69.9l.81 1.2a2 2 0 0 0 1.67.9H20a2 2 0 0 1 2 2v3.417"/>
                <path d="M14.62 18.8A2.25 2.25 0 1 1 18 15.836a2.25 2.25 0 1 1 3.38 2.966l-2.626 2.856a.998.998 0 0 1-1.507 0z"/>
              </svg>
            </div>

            <h3>Preserve</h3>
          </div>

          <div class="goal-card-face goal-card-back">
            <p>
              Folklore lives in the telling. We give it a digital home.
            </p>
          </div>

        </div>
      </article>

      <!-- ACCESS -->
      <article class="goal-flip-card anim-item">
        <div class="goal-flip-inner">

          <div class="goal-card-face goal-card-front">
            <div class="goal-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M2 20h20"/>
                <path d="m9 10 2 2 4-4"/>
                <rect x="3" y="4" width="18" height="12" rx="2"/>
              </svg>
            </div>

            <h3>Access</h3>
          </div>

          <div class="goal-card-face goal-card-back">
            <p>
              We shaped every format and channel so nothing stands between you
              and the lore.
            </p>
          </div>

        </div>
      </article>

    </div>
  </div>
</section>
    <!-- CULTURE BANNER -->
    <section class="culture-banner anim-item">
      <div>
        <p class="about-eyebrow">Culture & Nostalgia</p>
        <h2>Stories carried through memory</h2>
        <p>
          Most people met these stories as children — in classrooms, in bedtime
          retellings, in the half-remembered names of places we passed on long drives.
        </p>
      </div>
    </section>

  </main>
</Layout>
<style>
  :root {
    --dark: #003830;
    --teal: #106B66;
    --gold: #D8A91B;
    --sand: #F1D298;
    --font-title: "Playfair Display", Georgia, serif;
    --font-body: "Montserrat", "Segoe UI", sans-serif;
    --ease: cubic-bezier(0.22, 1, 0.36, 1);
  }

  .about-page {
    min-height: 100vh;
    overflow-x: hidden;
  }

  .about-video-section {
    padding: clamp(7rem, 14vh, 9rem) clamp(1.25rem, 5vw, 3rem) 4rem;
  }

  .video-frame {
    position: relative;
    min-height: 68vh;
    overflow: hidden;
    border-radius: 2rem;
    border: 1px solid rgba(216, 169, 27, 0.18);
    background: rgba(0, 44, 35, 0.6);
    box-shadow: 0 30px 80px -45px rgba(0, 0, 0, 0.8);
  }

  .video-frame video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .video-overlay {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 70% 30%, rgba(216, 169, 27, 0.15), transparent 35%),
      linear-gradient(to top, rgba(0, 30, 24, 0.95), rgba(0, 30, 24, 0.2));
  }

  .video-content {
    position: absolute;
    left: 50%;
    bottom: 12%;
    transform: translateX(-50%);
    width: min(900px, 90%);
    text-align: center;
  }

  .about-eyebrow {
    font-family: var(--font-body);
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--gold);
  }

  .about-intro {
    padding: 3rem clamp(1.5rem, 6vw, 3rem) 5rem;
  }

  .about-intro-inner {
    max-width: 900px;
    margin: 0 auto;
    text-align: center;
  }

  .about-main-text {
    font-family: var(--font-body);
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    line-height: 1.85;
    color: rgba(241, 210, 152, 0.72);
  }

  .about-quote {
    margin-top: 2.5rem;
    font-family: var(--font-title);
    font-size: clamp(2rem, 5vw, 4rem);
    line-height: 1.08;
    color: var(--sand);
  }

  .about-quote span {
    color: var(--gold);
    font-style: italic;
  }

  /* GOALS */
  .goals-section {
    padding: 9rem clamp(1.5rem, 6vw, 3rem) 7rem;
    max-width: 1280px;
    margin: 0 auto;
  }

  .goals-layout {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 4rem;
  }

  .goals-copy {
    max-width: 760px;
  }

  .goals-copy p {
    max-width: 34ch;
    margin: 0 auto;
    font-family: var(--font-body);
    font-size: clamp(1.4rem, 2.4vw, 2rem);
    line-height: 1.9;
    color: rgba(241, 210, 152, 0.78);
  }

  .goals-copy p::first-line {
    color: var(--sand);
    font-weight: 600;
  }

  .goals-cards {
  width: 100%;
  max-width: 980px;
  }

  .goals-cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.4rem;
  }

  .goal-flip-card {
    aspect-ratio: 1 / 1;
    perspective: 1200px;
    -webkit-perspective: 1200px;
    cursor: pointer;
  }

  .goal-flip-inner {
    position: relative;
    height: 100%;
    transform-style: preserve-3d;
    -webkit-transform-style: preserve-3d;
    transition: transform 0.8s var(--ease);
  }

  .goal-flip-card:hover .goal-flip-inner,
  .goal-flip-card.is-flipped .goal-flip-inner {
    transform: rotateY(180deg);
    -webkit-transform: rotateY(180deg);
  }

  .goal-card-face {
    position: absolute;
    inset: 0;
    border-radius: 1.5rem;
    border: 1px solid rgba(216, 169, 27, 0.28);
    background: rgba(0, 44, 35, 0.18);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    box-shadow: 0 24px 60px -35px rgba(0, 0, 0, 0.7);
    padding: 2rem 1.4rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .goal-card-back {
    transform: rotateY(180deg);
    -webkit-transform: rotateY(180deg);
  }

  .goal-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--gold);
    margin-bottom: 1.4rem;
  }

  .goal-icon svg {
    width: 48px;
    height: 48px;
    stroke-width: 1.7;
  }

  .goal-card-front h3 {
    font-family: var(--font-title);
    font-size: clamp(2rem, 3vw, 2.8rem);
    color: var(--sand);
    line-height: 1;
  }

  .goal-card-back p {
    max-width: 20ch;
    font-family: var(--font-body);
    font-size: clamp(0.9rem, 1.2vw, 1rem);
    line-height: 1.7;
    color: rgba(241, 210, 152, 0.8);
  }

  /* CULTURE */
  .culture-banner {
    margin: 4rem clamp(1.5rem, 6vw, 3rem) 7rem;
    padding: clamp(2.5rem, 6vw, 5rem);
    border-radius: 2rem;
    border: 1px solid rgba(216, 169, 27, 0.16);
    background:
      radial-gradient(circle at 20% 20%, rgba(216, 169, 27, 0.12), transparent 30%),
      linear-gradient(135deg, rgba(0, 68, 53, 0.9), rgba(16, 107, 102, 0.65));
  }

  .culture-banner h2 {
    margin-top: 0.8rem;
    font-family: var(--font-title);
    font-size: clamp(2.2rem, 5vw, 4rem);
    line-height: 1.05;
    color: var(--sand);
  }

  .culture-banner p {
    margin-top: 1.3rem;
    max-width: 70ch;
    font-family: var(--font-body);
    font-size: clamp(1rem, 1.8vw, 1.18rem);
    line-height: 1.9;
    color: rgba(241, 210, 152, 0.72);
  }

  .anim-item {
    opacity: 0;
    transform: translateY(40px) scale(0.97);
    filter: blur(6px);
  }

  @media (max-width: 950px) {
    .goals-layout {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .goals-copy {
      padding-top: 0;
    }

    .goals-copy p {
      margin: 0 auto;
    }

    .goals-cards {
      max-width: 760px;
      margin: 0 auto;
    }
  }

  @media (max-width: 700px) {
    .goals-section {
      padding-top: 6rem;
    }

    .goals-cards {
      grid-template-columns: 1fr;
    }

    .goal-flip-card {
      max-width: 320px;
      width: 100%;
      margin: 0 auto;
    }

    .video-frame {
      min-height: 58vh;
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  document.querySelectorAll(".anim-item").forEach((el, i) => {
    gsap.fromTo(
      el,
      { opacity: 0, y: 45, scale: 0.97, filter: "blur(6px)" },
      {
        opacity: 1,
        y: 0,
        scale: 1,
        filter: "blur(0px)",
        duration: 1,
        delay: (i % 3) * 0.12,
        ease: "power3.out",
        scrollTrigger: {
          trigger: el,
          start: "top 78%",
          once: true,
        },
      }
    );
  });

  const goalFlipCards = document.querySelectorAll(".goal-flip-card");

goalFlipCards.forEach((card) => {
  card.addEventListener("click", () => {
    card.classList.toggle("is-flipped");
  });
});
</script>