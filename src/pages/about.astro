
---
import Layout from "../layouts/Layout.astro";

---

<Layout title="Éire Lore — About">

  <img
    src="/assets/candle-1.gif"
    alt=""
    class="fixed inset-0 -z-20 h-full w-full object-cover"
  />
  <div class="fixed inset-0 -z-10 bg-black/60"></div>

  <main class="about-page">

    <!-- VIDEO BANNER -->
    <section class="about-video-section">
      <div class="video-frame anim-item">
        <!-- Cambiá src por tu video -->
        <video
          src="/about/about-banner.mp4"
          autoplay
          muted
          loop
          playsinline
        ></video>

        <div class="video-overlay"></div>

        <div class="video-content">
          <p class="about-eyebrow">Video content</p>
        </div>
      </div>
    </section>

    <!-- INTRO TEXT -->
    <section class="about-intro">
      <div class="about-intro-inner">
        <p class="about-main-text anim-item">
          Éire Lore is an interactive digital heritage project that brings Irish
          legends out of the archive and into the everyday.
        </p>

        <p class="about-quote anim-item">
          The legends were always here.<br />
          <span>We just built a key.</span>
        </p>
      </div>
    </section>


    
<!-- GOALS -->
<section class="goals-section">
  <div class="goals-layout">

    <div class="goals-copy anim-item">

      <p>
        Our goal is to make Irish folklore easier to discover, more engaging to
        experience, and more meaningful for new audiences.
      </p>
    </div>

    <div class="goals-cards">

      <!-- ENGAGE -->
      <article class="goal-flip-card anim-item">
        <div class="goal-flip-inner">

          <div class="goal-card-face goal-card-front">
            <div class="goal-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z"/>
                <path d="M20 2v4"/>
                <path d="M22 4h-4"/>
                <circle cx="4" cy="20" r="2"/>
              </svg>
            </div>

            <h3>Engage</h3>
          </div>

          <div class="goal-card-face goal-card-back">
            <p>
              We use design, narration, and visual storytelling to make every
              legend something you don't just read — you feel.
            </p>
          </div>

        </div>
      </article>

      <!-- PRESERVE -->
      <article class="goal-flip-card anim-item">
        <div class="goal-flip-inner">

          <div class="goal-card-face goal-card-front">
            <div class="goal-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M10.638 20H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3.9a2 2 0 0 1 1.69.9l.81 1.2a2 2 0 0 0 1.67.9H20a2 2 0 0 1 2 2v3.417"/>
                <path d="M14.62 18.8A2.25 2.25 0 1 1 18 15.836a2.25 2.25 0 1 1 3.38 2.966l-2.626 2.856a.998.998 0 0 1-1.507 0z"/>
              </svg>
            </div>

            <h3>Preserve</h3>
          </div>

          <div class="goal-card-face goal-card-back">
            <p>
              Folklore lives in the telling. We give it a digital home.
            </p>
          </div>

        </div>
      </article>

      <!-- ACCESS -->
      <article class="goal-flip-card anim-item">
        <div class="goal-flip-inner">

          <div class="goal-card-face goal-card-front">
            <div class="goal-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M2 20h20"/>
                <path d="m9 10 2 2 4-4"/>
                <rect x="3" y="4" width="18" height="12" rx="2"/>
              </svg>
            </div>

            <h3>Access</h3>
          </div>

          <div class="goal-card-face goal-card-back">
            <p>
              We shaped every format and channel so nothing stands between you
              and the lore.
            </p>
          </div>

        </div>
      </article>

    </div>
  </div>
</section>
    <!-- CULTURE BANNER -->
    <section class="culture-banner anim-item">
      <div>
        <p class="about-eyebrow">Culture & Nostalgia</p>
        <h2>Stories carried through memory</h2>
        <p>
          Most people met these stories as children in classrooms, in bedtime
          retellings, in the names of places we passed on long drives.
        </p>
      </div>
    </section>

  </main>
</Layout>
<style>
  :root {
    --dark: #003830;
    --teal: #106B66;
    --gold: #D8A91B;
    --sand: #F1D298;
    --font-title: "Playfair Display", Georgia, serif;
    --font-body: "Montserrat", "Segoe UI", sans-serif;
    --ease: cubic-bezier(0.22, 1, 0.36, 1);
  }

  .about-page {
    min-height: 100vh;
    overflow-x: hidden;
  }

  .about-video-section {
    padding: clamp(7rem, 14vh, 9rem) clamp(1.25rem, 5vw, 3rem) 4rem;
  }

  .video-frame {
    position: relative;
    min-height: 68vh;
    overflow: hidden;
    border-radius: 2rem;
    border: 1px solid rgba(216, 169, 27, 0.18);
    background: rgba(0, 44, 35, 0.6);
    box-shadow: 0 30px 80px -45px rgba(0, 0, 0, 0.8);
  }

  .video-frame video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .video-overlay {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 70% 30%, rgba(216, 169, 27, 0.15), transparent 35%),
      linear-gradient(to top, rgba(0, 30, 24, 0.95), rgba(0, 30, 24, 0.2));
  }

  .video-content {
    position: absolute;
    left: 50%;
    bottom: 12%;
    transform: translateX(-50%);
    width: min(900px, 90%);
    text-align: center;
  }

  .about-eyebrow {
    font-family: var(--font-body);
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--gold);
  }

  .about-intro {
    padding: 3rem clamp(1.5rem, 6vw, 3rem) 5rem;
  }

  .about-intro-inner {
    max-width: 900px;
    margin: 0 auto;
    text-align: center;
  }

  .about-main-text {
    font-family: var(--font-body);
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    line-height: 1.85;
    color: rgba(241, 210, 152, 0.72);
  }

  .about-quote {
    margin-top: 2.5rem;
    font-family: var(--font-title);
    font-size: clamp(2rem, 5vw, 4rem);
    line-height: 1.08;
    color: var(--sand);
  }

  .about-quote span {
    color: var(--gold);
    font-style: italic;
  }

  /* GOALS */
  .goals-section {
    padding: 9rem clamp(1.5rem, 6vw, 3rem) 7rem;
    max-width: 1280px;
    margin: 0 auto;
  }

  .goals-layout {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 4rem;
  }

  .goals-copy {
    max-width: 760px;
  }

  .goals-copy p {
    max-width: 34ch;
    margin: 0 auto;
    font-family: var(--font-body);
    font-size: clamp(1.4rem, 2.4vw, 2rem);
    line-height: 1.9;
    color: rgba(241, 210, 152, 0.78);
  }

  .goals-copy p::first-line {
    color: var(--sand);
    font-weight: 600;
  }

  .goals-cards {
  width: 100%;
  max-width: 980px;
  }

  .goals-cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.4rem;
  }

  .goal-flip-card {
    aspect-ratio: 1 / 1;
    perspective: 1200px;
    -webkit-perspective: 1200px;
    cursor: pointer;
  }

  .goal-flip-inner {
    position: relative;
    height: 100%;
    transform-style: preserve-3d;
    -webkit-transform-style: preserve-3d;
    transition: transform 0.8s var(--ease);
  }

  .goal-flip-card:hover .goal-flip-inner,
  .goal-flip-card.is-flipped .goal-flip-inner {
    transform: rotateY(180deg);
    -webkit-transform: rotateY(180deg);
  }

  .goal-card-face {
    position: absolute;
    inset: 0;
    border-radius: 1.5rem;
    border: 1px solid rgba(216, 169, 27, 0.28);
    background: rgba(0, 44, 35, 0.18);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    box-shadow: 0 24px 60px -35px rgba(0, 0, 0, 0.7);
    padding: 2rem 1.4rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .goal-card-back {
    transform: rotateY(180deg);
    -webkit-transform: rotateY(180deg);
  }

  .goal-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--gold);
    margin-bottom: 1.4rem;
  }

  .goal-icon svg {
    width: 48px;
    height: 48px;
    stroke-width: 1.7;
  }

  .goal-card-front h3 {
    font-family: var(--font-title);
    font-size: clamp(2rem, 3vw, 2.8rem);
    color: var(--sand);
    line-height: 1;
  }

  .goal-card-back p {
    max-width: 20ch;
    font-family: var(--font-body);
    font-size: clamp(0.9rem, 1.2vw, 1rem);
    line-height: 1.7;
    color: rgba(241, 210, 152, 0.8);
  }

  /* CULTURE */
 .culture-banner {
  width: 100%;
  min-height: 100vh;

  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;

  padding: clamp(4rem, 8vw, 7rem) clamp(1.5rem, 5vw, 3rem);

  background: #d8a91b;

  border: none;
  border-radius: 0;
  margin: 0;
}

.culture-banner > div {
  max-width: 950px;
}

.culture-banner .about-eyebrow {
  color: #003830;
  margin-bottom: 1.2rem;

  font-size: 0.72rem;
  font-weight: 800;
  letter-spacing: 0.32em;
}

.culture-banner h2 {
  margin-top: 0;

  font-family: var(--font-title);
  font-size: clamp(3rem, 7vw, 6rem);
  line-height: 0.98;
  color: #003830;
}

.culture-banner p {
  margin: 2rem auto 0;
  max-width: 42ch;

  font-family: var(--font-body);
  font-size: clamp(1.05rem, 2vw, 1.3rem);
  line-height: 1.9;

  color: rgba(0, 56, 48, 0.85);
}
  .anim-item {
    opacity: 0;
    transform: translateY(40px) scale(0.97);
    filter: blur(6px);
  }

  @media (max-width: 950px) {
    .goals-layout {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .goals-copy {
      padding-top: 0;
    }

    .goals-copy p {
      margin: 0 auto;
    }

    .goals-cards {
      max-width: 760px;
      margin: 0 auto;
    }
  }

  @media (max-width: 700px) {
    .goals-section {
      padding-top: 6rem;
    }

    .goals-cards {
      grid-template-columns: 1fr;
    }

    .goal-flip-card {
      max-width: 320px;
      width: 100%;
      margin: 0 auto;
    }

    .video-frame {
      min-height: 58vh;
    }
  }
</style>

<style>
  :root {
    --dark:       #003830;
    --teal:       #106B66;
    --gold:       #D8A91B;
    --gold-dim:   rgba(216, 169, 27, 0.35);
    --gold-glow:  rgba(216, 169, 27, 0.12);
    --sand:       #F1D298;
    --sand-dim:   rgba(241, 210, 152, 0.65);
    --sand-muted: rgba(241, 210, 152, 0.40);
    --font-title: "Playfair Display", Georgia, serif;
    --font-body:  "Montserrat", "Segoe UI", sans-serif;
    --ease:       cubic-bezier(0.22, 1, 0.36, 1);
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  .about-page {
    min-height: 100vh;
    overflow-x: hidden;
  }

  /* ── SHARED TOKENS ── */
  .section-eyebrow {
    font-family: var(--font-body);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 0.9rem;
  }

  .section-title {
    font-family: var(--font-title);
    font-weight: 700;
    font-size: clamp(2.2rem, 4.5vw, 3.2rem);
    line-height: 1.1;
    color: var(--sand);
    margin-top: 0.4rem;
  }

  /* ── HERO ── */
  .about-hero {
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: clamp(5rem, 14vh, 9rem) clamp(1.25rem, 5vw, 3rem) clamp(3rem, 6vh, 5rem);
    position: relative;
    background: radial-gradient(
      ellipse 70% 55% at 50% 42%,
      rgba(16, 107, 102, 0.22) 0%,
      transparent 70%
    );
  }

  .about-hero-inner {
    max-width: min(800px, 100%);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

 .hero-logo {
  height: clamp(8rem, 22vw, 16rem);
  width: auto;
  margin-top: clamp(2.5rem, 5vh, 4rem);
  opacity: 0.95;
}

.hero-title {
  font-family: var(--font-title);
  font-weight: 700;
  font-size: clamp(1.4rem, 3.5vw, 2.4rem);
  line-height: 1.25;
  color: var(--sand);
  letter-spacing: -0.01em;
}

  .hero-eyebrow {
    font-family: var(--font-body);
    font-size: clamp(0.58rem, 1.5vw, 0.65rem);
    font-weight: 700;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: clamp(0.75rem, 2vh, 1.25rem);
    position: relative;
    padding-bottom: 0.9rem;
  }
  .hero-eyebrow::after {
    content: "";
    position: absolute;
    bottom: 0; left: 50%;
    transform: translateX(-50%);
    width: 24px; height: 1px;
    background: var(--gold);
    opacity: 0.5;
  }

  .hero-title {
    font-family: var(--font-title);
    font-weight: 700;
    font-size: clamp(2rem, 5.5vw, 4rem);
    line-height: 1.15;
    color: var(--sand);
    letter-spacing: -0.01em;
  }

  .hero-title-accent {
    font-style: italic;
    color: var(--gold);
    text-shadow: 0 0 60px rgba(216, 169, 27, 0.25);
  }

  .hero-fade {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 140px;
    background: linear-gradient(to bottom, transparent, rgba(0, 30, 24, 0.65));
    pointer-events: none;
  }

  /* ── SHARED BLOCK ── */
  .about-block {
    padding: clamp(5rem, 10vh, 8rem) clamp(1.25rem, 5vw, 3rem);
  }

  /* ── INTRO ── */
  .intro-block {
    display: flex;
    justify-content: center;
  }

  .intro-card {
    max-width: 680px;
    text-align: center;
    border: 1px solid rgba(255,255,255,0.07);
    background: rgba(0, 30, 24, 0.35);
    border-radius: 2rem;
    padding: clamp(2.5rem, 5vw, 4rem) clamp(2rem, 4vw, 3.5rem);
    backdrop-filter: blur(8px);
  }

  .intro-body {
    font-family: var(--font-body);
    font-size: clamp(1rem, 2.2vw, 1.2rem);
    line-height: 1.85;
    color: var(--sand-dim);
  }

  .intro-key {
    margin-top: 2rem;
    font-family: var(--font-title);
    font-size: clamp(1.3rem, 3vw, 1.9rem);
    line-height: 1.4;
    color: var(--sand);
  }
  .intro-key em {
    color: var(--gold);
    font-style: italic;
  }

  /* ── GOALS ── */
  .goals-block {
    background: radial-gradient(
      ellipse 80% 50% at 50% 50%,
      rgba(16, 107, 102, 0.12) 0%,
      transparent 70%
    );
  }

  .goals-inner {
    max-width: 1100px;
    margin: 0 auto;
  }

  .goals-header {
    text-align: center;
    margin-bottom: clamp(3rem, 6vh, 5rem);
  }

  .goals-grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  }

  .goal-card {
    border: 1px solid rgba(255,255,255,0.07);
    background: rgba(0, 30, 24, 0.35);
    border-radius: 1.6rem;
    padding: 2.5rem 2rem;
    backdrop-filter: blur(6px);
    transition: transform 0.3s var(--ease), background 0.3s;
  }
  .goal-card:hover {
    transform: translateY(-4px);
    background: rgba(0, 40, 30, 0.5);
  }

  .goal-num {
    font-family: var(--font-body);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(216, 169, 27, 0.6);
  }

  .goal-title {
    font-family: var(--font-title);
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 700;
    color: var(--sand);
    margin-top: 1rem;
    font-style: italic;
  }

  .goal-body {
    font-family: var(--font-body);
    font-size: 0.9rem;
    line-height: 1.75;
    color: var(--sand-muted);
    margin-top: 1rem;
  }

  .culture-block {
  display: flex;
  justify-content: center;
}

.culture-inner {
  max-width: 680px;
  text-align: center;
}

.culture-title {
  font-size: clamp(2rem, 4vw, 3rem);
}

.culture-body {
  font-family: var(--font-body);
  font-size: clamp(0.9rem, 1.8vw, 1rem);
  line-height: 1.85;
  color: var(--sand-dim);
  margin-top: 1.5rem;
}
  /* ── CLOSING ── */
  .closing-block {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 55vh;
  }

  .closing-inner {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.5rem;
  }

  .closing-line {
    width: 1px;
    height: clamp(36px, 5vh, 56px);
    background: linear-gradient(var(--gold), transparent);
    opacity: 0.4;
  }

  .closing-phrase {
    font-family: var(--font-title);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 700;
    line-height: 1.2;
    color: var(--sand);
  }
  .closing-phrase em {
    color: var(--gold);
    font-style: italic;
  }

  .closing-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(0.6rem, 2vw, 1rem);
    flex-wrap: wrap;
  }

  /* ── BUTTONS (same as index) ── */
  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--gold);
    color: var(--dark);
    font-family: var(--font-body);
    font-size: clamp(0.65rem, 1.5vw, 0.72rem);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 0.8rem 1.75rem;
    border-radius: 100px;
    min-height: 44px;
    white-space: nowrap;
    -webkit-tap-highlight-color: transparent;
    transition: background 0.25s var(--ease), transform 0.25s var(--ease), box-shadow 0.25s;
    box-shadow: 0 4px 24px rgba(216, 169, 27, 0.25);
  }
  @media (hover: hover) {
    .btn-primary:hover {
      background: var(--sand);
      transform: translateY(-3px);
      box-shadow: 0 8px 32px rgba(216, 169, 27, 0.35);
    }
  }
  .btn-primary:active { transform: translateY(-1px); }

  .btn-ghost {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--gold-dim);
    border-radius: 100px;
    padding: 0.78rem 1.5rem;
    font-family: var(--font-body);
    font-size: clamp(0.63rem, 1.5vw, 0.7rem);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--sand-muted);
    text-decoration: none;
    white-space: nowrap;
    min-height: 44px;
    -webkit-tap-highlight-color: transparent;
    transition: color 0.2s, border-color 0.2s, background 0.2s, transform 0.2s;
  }
  @media (hover: hover) {
    .btn-ghost:hover {
      color: var(--sand);
      border-color: rgba(216, 169, 27, 0.6);
      background: var(--gold-glow);
      transform: translateY(-2px);
    }
  }
  .btn-ghost:active { transform: translateY(0); }

  /* ── ENTRANCE ANIMATIONS ── */
  .anim-item {
    opacity: 0;
    transform: translateY(40px) scale(0.97);
    filter: blur(6px);
    transition:
      opacity   0.8s var(--ease),
      transform 0.8s var(--ease),
      filter    0.8s var(--ease);
  }
  .anim-item.is-visible {
    opacity: 1;
    transform: translateY(0) scale(1);
    filter: blur(0);
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 600px) {
    .hero-title { font-size: clamp(1.7rem, 8vw, 2.4rem); }
    .closing-cta { flex-direction: column; align-items: stretch; }
    .btn-primary, .btn-ghost { width: 100%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .anim-item { opacity: 1; transform: none; filter: none; transition: none; }
    .btn-primary:hover, .btn-ghost:hover { transform: none; }
    .goal-card:hover, .culture-marker:hover { transform: none; }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  document.querySelectorAll(".anim-item").forEach((el, i) => {
    gsap.fromTo(
      el,
      { opacity: 0, y: 45, scale: 0.97, filter: "blur(6px)" },
      {
        opacity: 1,
        y: 0,
        scale: 1,
        filter: "blur(0px)",
        duration: 1,
        delay: (i % 3) * 0.12,
        ease: "power3.out",
        scrollTrigger: {
          trigger: el,
          start: "top 78%",
          once: true,
        },
      }
    );
  });

  const goalFlipCards = document.querySelectorAll(".goal-flip-card");

goalFlipCards.forEach((card) => {
  card.addEventListener("click", () => {
    card.classList.toggle("is-flipped");
  });
});
</script>
