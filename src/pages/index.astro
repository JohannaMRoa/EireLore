---
// src/pages/index.astro
import Layout from "../layouts/Layout.astro";
---

<Layout title="Éire Lore — Irish Legends">

  <img
    src="/assets/candle-2.gif"
    alt=""
    class="fixed inset-0 -z-20 h-full w-full object-cover"
  />
  <div class="fixed inset-0 -z-10 bg-black/55"></div>

  <main class="index-page">

    <section class="hero">
      <div class="hero-inner">

        <p class="hero-eyebrow anim-item">Where legends never died</p>

        <h1 class="hero-title anim-item">
          Irish mythology<br/>
          <span class="hero-title-accent">unlocked</span>
        </h1>

        <p class="hero-lead anim-item">
          Heroes, creatures, and ancient lore that shaped Ireland <br>and still live in its hills and its people
        </p>

        <div class="hero-cta anim-item">
          <a href="/myths" class="btn-primary">
            <span>Explore Legends</span>
          </a>
          <a href="/about" class="btn-ghost">About the Project</a>
        </div>

      </div>

      <div class="hero-fade"></div>
    </section>

  </main>
</Layout>


<style>

  :root {
    --dark:       #003830;
    --teal:       #106B66;
    --gold:       #D8A91B;
    --gold-dim:   rgba(216, 169, 27, 0.35);
    --gold-glow:  rgba(216, 169, 27, 0.12);
    --sand:       #F1D298;
    --sand-dim:   rgba(241, 210, 152, 0.65);
    --sand-muted: rgba(241, 210, 152, 0.40);
    --font-title: "Playfair Display", Georgia, serif;
    --font-body:  "Montserrat", "Segoe UI", sans-serif;
    --ease:       cubic-bezier(0.22, 1, 0.36, 1);
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  .index-page {
    min-height: 100vh;
    overflow-x: hidden;
  }

  /* ── HERO ───────────────────────────── */
  .hero {
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: clamp(5rem, 14vh, 9rem) clamp(1.25rem, 5vw, 3rem) clamp(3rem, 6vh, 5rem);
    position: relative;
    background: radial-gradient(
      ellipse 70% 55% at 50% 42%,
      rgba(16, 107, 102, 0.22) 0%,
      transparent 70%
    );
  }

  .hero-inner {
    max-width: min(800px, 100%);
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-eyebrow {
    font-family: var(--font-body);
    font-size: clamp(0.58rem, 1.5vw, 0.65rem);
    font-weight: 700;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: clamp(0.75rem, 2vh, 1.25rem);
    position: relative;
    padding-bottom: 0.9rem;
  }
  .hero-eyebrow::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 24px;
    height: 1px;
    background: var(--gold);
    opacity: 0.5;
  }

  .hero-title {
    font-family: var(--font-title);
    font-weight: 700;
    font-size: clamp(2.6rem, 9vw, 6.5rem);
    line-height: 1.04;
    color: var(--sand);
    letter-spacing: -0.01em;
    margin-bottom: clamp(1.25rem, 3vh, 2rem);
  }
  .hero-title-accent {
    font-style: italic;
    color: var(--gold);
    text-shadow: 0 0 60px rgba(216, 169, 27, 0.25);
  }

  .hero-lead {
    font-family: var(--font-body);
    font-size: clamp(0.88rem, 2vw, 1.05rem);
    line-height: 1.85;
    color: var(--sand-dim);
    max-width: 50ch;
    margin-bottom: clamp(2rem, 5vh, 3.5rem);
  }

  /* ── CTA row ───*/
  .hero-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(0.6rem, 2vw, 1rem);
    flex-wrap: wrap;
    width: 100%;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;   /* centres text since arrow is gone */
    background: var(--gold);
    color: var(--dark);
    font-family: var(--font-body);
    font-size: clamp(0.65rem, 1.5vw, 0.72rem);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 0.8rem 1.75rem;
    border-radius: 100px;
    min-height: 44px;
    white-space: nowrap;
    -webkit-tap-highlight-color: transparent;
    transition: background 0.25s var(--ease), transform 0.25s var(--ease), box-shadow 0.25s;
    box-shadow: 0 4px 24px rgba(216, 169, 27, 0.25);
  }
  @media (hover: hover) {
    .btn-primary:hover {
      background: var(--sand);
      transform: translateY(-3px);
      box-shadow: 0 8px 32px rgba(216, 169, 27, 0.35);
    }
  }
  .btn-primary:active { transform: translateY(-1px); }

  .btn-ghost {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--gold-dim);
    border-radius: 100px;
    padding: 0.78rem 1.5rem;
    font-family: var(--font-body);
    font-size: clamp(0.63rem, 1.5vw, 0.7rem);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--sand-muted);
    text-decoration: none;
    white-space: nowrap;
    min-height: 44px;
    -webkit-tap-highlight-color: transparent;
    transition: color 0.2s, border-color 0.2s, background 0.2s, transform 0.2s;
  }
  @media (hover: hover) {
    .btn-ghost:hover {
      color: var(--sand);
      border-color: rgba(216, 169, 27, 0.6);
      background: var(--gold-glow);
      transform: translateY(-2px);
    }
  }
  .btn-ghost:active { transform: translateY(0); }

  /* Bottom fade */
  .hero-fade {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 140px;
    background: linear-gradient(to bottom, transparent, rgba(0, 30, 24, 0.65));
    pointer-events: none;
  }

  /* ── ENTRANCE ANIMATIONS ── */
  .anim-item {
    opacity: 0;
    transform: translateY(40px) scale(0.97);
    filter: blur(6px);
    transition:
      opacity   0.8s var(--ease),
      transform 0.8s var(--ease),
      filter    0.8s var(--ease);
  }
  .anim-item.is-visible {
    opacity: 1;
    transform: translateY(0) scale(1);
    filter: blur(0);
  }

  /* ── RESPONSIVE ─────────────────────── */
  @media (max-width: 600px) {
    .hero {
      padding-top: clamp(4.5rem, 18vh, 7rem);
      background: radial-gradient(
        ellipse 120% 45% at 50% 38%,
        rgba(16, 107, 102, 0.2) 0%,
        transparent 70%
      );
    }
    .hero-title { font-size: clamp(2.2rem, 11vw, 3rem); }
    .hero-lead  { max-width: 100%; font-size: 0.9rem; }
    .hero-cta   { flex-direction: column; align-items: stretch; }
    .btn-primary,
    .btn-ghost  { width: 100%; padding: 0.85rem 1.5rem; }
  }

  @media (max-width: 380px) {
    .hero-title   { font-size: clamp(1.9rem, 12vw, 2.4rem); }
    .hero-eyebrow { letter-spacing: 0.2em; }
  }

  /* ── REDUCE MOTION ──────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .anim-item { opacity: 1; transform: none; filter: none; transition: none; }
    .btn-primary:hover,
    .btn-ghost:hover { transform: none; }
  }
</style>


<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  // Hero items staggered entrance on load
  document.querySelectorAll(".hero .anim-item").forEach((el, i) => {
    gsap.fromTo(el,
      { opacity: 0, y: 40, scale: 0.97, filter: "blur(6px)" },
      {
        opacity: 1, y: 0, scale: 1, filter: "blur(0px)",
        duration: 1, delay: 0.15 + i * 0.13, ease: "power3.out",
      }
    );
  });
</script>
