---
// src/pages/index.astro
// EireLore — Legends landing page
import Layout from "../layouts/Layout.astro";

const legends = [
  {
    slug:     "/GiantsCauseway",
    title:    "The Giant's Causeway",
    subtitle: "Finn McCool & Benandonner",
    tag:      "Giants",
    excerpt:  "Along the wild Antrim coast, a giant built a bridge of basalt to challenge his Scottish rival — and his wife's cunning saved him.",
    icon:     "🪨",
  },
];
---

<Layout title="Éire Lore — Irish Legends">

  <img
    src="/assets/candle-1.gif"
    alt=""
    class="fixed inset-0 -z-20 h-full w-full object-cover"
  />
  <div class="fixed inset-0 -z-10 bg-black/55"></div>

  <main class="index-page">

    <!-- ══════════════════════════════════════
         HERO
    ══════════════════════════════════════ -->
    <section class="hero">
      <div class="hero-inner">

        <p class="hero-eyebrow anim-item">Irish Legends</p>

        <h1 class="hero-title anim-item">
          Enter the world<br/>
          <span class="hero-title-accent">of Irish myths</span>
        </h1>

        <p class="hero-lead anim-item">
          Discover heroes, creatures, and ancient stories through
          immersive scrollytelling — brought to life through
          illustration, narration, and interactive design.
        </p>

        <div class="hero-cta anim-item">
          <a href="#legends" class="btn-primary">
            <span>Explore Legends</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="1.8"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="12" y1="5" x2="12" y2="19"/>
              <polyline points="19 12 12 19 5 12"/>
            </svg>
          </a>
          <a href="/about" class="btn-ghost">About the Project</a>
        </div>

        <div class="scroll-hint anim-item" aria-hidden="true">
          <div class="scroll-tick"></div>
        </div>
      </div>

      <div class="hero-fade"></div>
    </section>


    <!-- ══════════════════════════════════════
         LEGENDS GRID
    ══════════════════════════════════════ -->
    <section id="legends" class="legends-section">

      <div class="section-header anim-item">
        <div class="section-divider-line"></div>
        <p class="section-eyebrow">The Collection</p>
        <h2 class="section-title">Choose Your <span class="accent">Legend</span></h2>
      </div>

      <div class="legends-grid">
        {legends.map((legend, i) => (
          <a
            href={legend.slug}
            class="legend-card anim-item"
            style={`animation-delay: ${i * 0.1}s`}
          >
            <div class="card-tag">{legend.tag}</div>
            <h3 class="card-title">{legend.title}</h3>
            <p class="card-subtitle">{legend.subtitle}</p>
            <div class="card-rule"></div>
            <p class="card-excerpt">{legend.excerpt}</p>
            <span class="card-cta">
              Read the legend
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                   stroke="currentColor" stroke-width="2"
                   stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12"/>
                <polyline points="12 5 19 12 12 19"/>
              </svg>
            </span>
          </a>
        ))}

        <div class="legend-card legend-card--soon anim-item">
          <div class="card-tag">Coming Soon</div>
          <h3 class="card-title">More Legends</h3>
          <p class="card-subtitle">In development</p>
          <div class="card-rule"></div>
          <p class="card-excerpt">
            New stories from Irish mythology are being added — selkies,
            banshees, the Tuatha Dé Danann, and more.
          </p>
          <span class="card-cta card-cta--muted">Stay tuned</span>
        </div>
      </div>

    </section>


    <!-- ══════════════════════════════════════
         ABOUT STRIP
    ══════════════════════════════════════ -->
    <section class="about-strip anim-item">
      <div class="about-strip-inner">
        <div class="about-strip-text">
          <p class="section-eyebrow">The Project</p>
          <h2 class="strip-title">What is <span class="accent">Éire Lore?</span></h2>
          <p class="strip-body">
            An interactive digital heritage project that brings Irish legends
            to life through illustrated scrollytelling, narration, and
            3D-printed collectible figures connected via QR codes.
          </p>
          <a href="/about" class="btn-ghost" style="margin-top:1.5rem">
            Learn more about the project
          </a>
        </div>
        <div class="about-strip-tags">
          <span class="tag">Digital Heritage</span>
          <span class="tag">Irish Mythology</span>
          <span class="tag">Scrollytelling</span>
          <span class="tag">3D Figures</span>
          <span class="tag">QR Storytelling</span>
        </div>
      </div>
    </section>

  </main>
</Layout>


<style>
  /* ══════════════════════════════════════════
     DESIGN TOKENS
  ══════════════════════════════════════════ */
  :root {
    --dark:        #003830;
    --dark-mid:    #00473d;
    --teal:        #106B66;
    --teal-light:  #1a8078;
    --gold:        #D8A91B;
    --gold-dim:    rgba(216, 169, 27, 0.35);
    --gold-glow:   rgba(216, 169, 27, 0.12);
    --sand:        #F1D298;
    --sand-dim:    rgba(241, 210, 152, 0.65);
    --sand-muted:  rgba(241, 210, 152, 0.40);
    --white-glass: rgba(255, 255, 255, 0.04);
    --font-title:  "Playfair Display", Georgia, serif;
    --font-body:   "Montserrat", "Segoe UI", sans-serif;
    --ease:        cubic-bezier(0.22, 1, 0.36, 1);
    --radius-lg:   1.6rem;
    --radius-sm:   0.8rem;
    /* Spacing scale */
    --space-xs:  clamp(0.5rem,  1vw,  0.75rem);
    --space-sm:  clamp(0.75rem, 2vw,  1.25rem);
    --space-md:  clamp(1.25rem, 3vw,  2rem);
    --space-lg:  clamp(2rem,    5vw,  3.5rem);
    --space-xl:  clamp(3rem,    8vh,  5.5rem);
    --space-2xl: clamp(4rem,    10vh, 7rem);
  }

  /* ══════════════════════════════════════════
     BASE RESET
  ══════════════════════════════════════════ */
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  .index-page {
    min-height: 100vh;
    overflow-x: hidden;
  }


  /* ══════════════════════════════════════════
     HERO
  ══════════════════════════════════════════ */
  .hero {
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: clamp(5rem, 14vh, 9rem) var(--space-md) clamp(3rem, 6vh, 5rem);
    position: relative;
    /* Subtle radial glow behind text */
    background: radial-gradient(
      ellipse 70% 55% at 50% 42%,
      rgba(16, 107, 102, 0.22) 0%,
      transparent 70%
    );
  }

  .hero-inner {
    max-width: min(800px, 100%);
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Eyebrow */
  .hero-eyebrow {
    font-family: var(--font-body);
    font-size: clamp(0.58rem, 1.5vw, 0.65rem);
    font-weight: 700;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: var(--space-sm);
    /* Subtle gold underline rule */
    position: relative;
    padding-bottom: 0.9rem;
  }
  .hero-eyebrow::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 24px;
    height: 1px;
    background: var(--gold);
    opacity: 0.5;
  }

  /* Main title */
  .hero-title {
    font-family: var(--font-title);
    font-weight: 700;
    font-size: clamp(2.6rem, 9vw, 6.5rem);
    line-height: 1.04;
    color: var(--sand);
    letter-spacing: -0.01em;
    margin-bottom: var(--space-md);
  }
  .hero-title-accent {
    font-style: italic;
    color: var(--gold);
    /* Gentle text shadow for depth */
    text-shadow: 0 0 60px rgba(216, 169, 27, 0.25);
  }

  /* Lead paragraph */
  .hero-lead {
    font-family: var(--font-body);
    font-size: clamp(0.88rem, 2vw, 1.05rem);
    line-height: 1.85;
    color: var(--sand-dim);
    max-width: 50ch;
    margin-bottom: var(--space-lg);
  }

  /* CTA row */
  .hero-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
    width: 100%;
  }

  /* ── Buttons ── */
  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    background: var(--gold);
    color: var(--dark);
    font-family: var(--font-body);
    font-size: clamp(0.65rem, 1.5vw, 0.72rem);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 0.8rem 1.75rem;
    border-radius: 100px;
    transition: background 0.25s var(--ease), gap 0.25s var(--ease),
                transform 0.25s var(--ease), box-shadow 0.25s;
    box-shadow: 0 4px 24px rgba(216, 169, 27, 0.25);
    white-space: nowrap;
  }
  .btn-primary:hover {
    background: var(--sand);
    gap: 14px;
    transform: translateY(-3px);
    box-shadow: 0 8px 32px rgba(216, 169, 27, 0.35);
  }
  .btn-primary:active { transform: translateY(-1px); }
  .btn-primary svg { flex-shrink: 0; transition: transform 0.3s var(--ease); }
  .btn-primary:hover svg { transform: translateY(3px); }

  .btn-ghost {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    border: 1px solid var(--gold-dim);
    border-radius: 100px;
    padding: 0.78rem 1.5rem;
    font-family: var(--font-body);
    font-size: clamp(0.63rem, 1.5vw, 0.7rem);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--sand-muted);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.2s, border-color 0.2s, background 0.2s, transform 0.2s;
  }
  .btn-ghost:hover {
    color: var(--sand);
    border-color: rgba(216, 169, 27, 0.6);
    background: var(--gold-glow);
    transform: translateY(-2px);
  }
  .btn-ghost:active { transform: translateY(0); }

  /* Scroll hint */
  .scroll-hint {
    margin-top: clamp(2.5rem, 5vh, 4rem);
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .scroll-tick {
    width: 1px;
    height: 52px;
    background: linear-gradient(to bottom, var(--gold), transparent);
    opacity: 0.45;
    animation: tickPulse 2.2s ease-in-out infinite;
  }
  @keyframes tickPulse {
    0%, 100% { opacity: 0.15; transform: scaleY(0.45) translateY(-8px); }
    55%       { opacity: 0.55; transform: scaleY(1)    translateY(0); }
  }

  /* Bottom fade */
  .hero-fade {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 140px;
    background: linear-gradient(to bottom, transparent, rgba(0, 30, 24, 0.65));
    pointer-events: none;
  }


  /* ══════════════════════════════════════════
     SHARED SECTION CHROME
  ══════════════════════════════════════════ */
  .section-header {
    text-align: center;
    margin-bottom: clamp(2.5rem, 6vh, 4rem);
  }
  .section-divider-line {
    width: 1px;
    height: clamp(36px, 5vh, 56px);
    background: linear-gradient(to bottom, var(--gold), transparent);
    opacity: 0.4;
    margin: 0 auto clamp(1.2rem, 3vh, 2rem);
  }
  .section-eyebrow {
    font-family: var(--font-body);
    font-size: clamp(0.55rem, 1.2vw, 0.62rem);
    font-weight: 700;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 0.65rem;
  }
  .section-title {
    font-family: var(--font-title);
    font-weight: 700;
    font-size: clamp(1.9rem, 5vw, 3.2rem);
    color: var(--sand);
    line-height: 1.1;
  }
  .accent {
    font-style: italic;
    color: var(--gold);
  }

  /* Tag chips */
  .tag {
    display: inline-block;
    border: 1px solid rgba(216, 169, 27, 0.22);
    background: rgba(0, 56, 48, 0.45);
    border-radius: 100px;
    padding: 0.38rem 0.95rem;
    font-family: var(--font-body);
    font-size: clamp(0.6rem, 1.4vw, 0.68rem);
    font-weight: 500;
    color: var(--sand-muted);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    transition: border-color 0.2s, color 0.2s;
  }
  .tag:hover {
    border-color: var(--gold-dim);
    color: var(--sand-dim);
  }


  /* ══════════════════════════════════════════
     LEGENDS SECTION
  ══════════════════════════════════════════ */
  .legends-section {
    padding: var(--space-2xl) var(--space-md);
    max-width: min(1200px, 100%);
    margin: 0 auto;
  }

  .legends-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: var(--space-md);
  }

  /* ── Legend card ── */
  .legend-card {
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-lg);
    border: 1px solid rgba(216, 169, 27, 0.14);
    background: linear-gradient(
      145deg,
      rgba(0, 56, 48, 0.55) 0%,
      rgba(0, 44, 35, 0.45) 100%
    );
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    padding: clamp(1.4rem, 3.5vw, 2.1rem);
    text-decoration: none;
    color: inherit;
    position: relative;
    overflow: hidden;
    transition:
      transform    0.4s var(--ease),
      border-color 0.35s,
      box-shadow   0.4s;
  }
  /* Inner top highlight */
  .legend-card::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(
      135deg,
      rgba(255,255,255,0.04) 0%,
      transparent 50%
    );
    pointer-events: none;
  }
  .legend-card:hover {
    transform: translateY(-7px);
    border-color: rgba(216, 169, 27, 0.38);
    box-shadow:
      0 22px 52px -18px rgba(0,0,0,0.55),
      0 0 0 1px rgba(216, 169, 27, 0.08) inset;
  }
  .legend-card--soon {
    opacity: 0.48;
    cursor: default;
    pointer-events: none;
  }

  .card-tag {
    font-family: var(--font-body);
    font-size: clamp(0.52rem, 1.2vw, 0.58rem);
    font-weight: 700;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--gold);
    opacity: 0.85;
    margin-bottom: 0.7rem;
  }
  .card-title {
    font-family: var(--font-title);
    font-weight: 700;
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    color: var(--sand);
    line-height: 1.18;
    margin-bottom: 0.35rem;
  }
  .card-subtitle {
    font-family: var(--font-body);
    font-size: clamp(0.72rem, 1.5vw, 0.79rem);
    color: var(--sand-muted);
    margin-bottom: var(--space-sm);
  }
  .card-rule {
    width: 28px;
    height: 1px;
    background: var(--gold);
    opacity: 0.38;
    margin-bottom: var(--space-sm);
    transition: width 0.35s var(--ease), opacity 0.35s;
  }
  .legend-card:hover .card-rule { width: 48px; opacity: 0.6; }

  .card-excerpt {
    font-family: var(--font-body);
    font-size: clamp(0.8rem, 1.6vw, 0.87rem);
    line-height: 1.75;
    color: rgba(241, 210, 152, 0.58);
    flex: 1;
    margin-bottom: var(--space-md);
  }
  .card-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-body);
    font-size: clamp(0.6rem, 1.3vw, 0.68rem);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gold);
    margin-top: auto;
    transition: gap 0.3s var(--ease), opacity 0.2s;
  }
  .legend-card:hover .card-cta { gap: 11px; }
  .card-cta svg { flex-shrink: 0; }
  .card-cta--muted { color: var(--sand-muted); opacity: 0.55; }


  /* ══════════════════════════════════════════
     ABOUT STRIP
  ══════════════════════════════════════════ */
  .about-strip {
    border-top: 1px solid rgba(216, 169, 27, 0.1);
    /* Inner glow line */
    box-shadow: 0 -1px 0 rgba(216, 169, 27, 0.04) inset;
    padding: var(--space-2xl) var(--space-md);
    /* Subtle gradient to distinguish from above */
    background: linear-gradient(
      to bottom,
      rgba(0, 40, 32, 0.35) 0%,
      transparent 100%
    );
  }
  .about-strip-inner {
    max-width: min(1160px, 100%);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: clamp(2rem, 6vw, 5rem);
  }

  .strip-title {
    font-family: var(--font-title);
    font-weight: 700;
    font-size: clamp(1.7rem, 4.5vw, 2.8rem);
    color: var(--sand);
    line-height: 1.1;
    margin: 0.5rem 0 var(--space-sm);
  }
  .strip-body {
    font-family: var(--font-body);
    font-size: clamp(0.85rem, 1.6vw, 0.97rem);
    line-height: 1.85;
    color: var(--sand-dim);
    max-width: 52ch;
  }

  .about-strip-tags {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    flex-shrink: 0;
  }


  /* ══════════════════════════════════════════
     ENTRANCE ANIMATIONS
  ══════════════════════════════════════════ */
  .anim-item {
    opacity: 0;
    transform: translateY(40px) scale(0.97);
    filter: blur(6px);
    transition:
      opacity   0.8s var(--ease),
      transform 0.8s var(--ease),
      filter    0.8s var(--ease);
  }
  .anim-item.is-visible {
    opacity: 1;
    transform: translateY(0) scale(1);
    filter: blur(0);
  }
  .hero .anim-item { transition-delay: calc(var(--i, 0) * 0.12s); }


  /* ══════════════════════════════════════════
     RESPONSIVE — TABLET  (≤ 900px)
  ══════════════════════════════════════════ */
  @media (max-width: 900px) {
    .legends-grid {
      grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    }
    .about-strip-inner {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }
    .about-strip-tags {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.5rem;
    }
  }


  /* ══════════════════════════════════════════
     RESPONSIVE — MOBILE  (≤ 600px)
  ══════════════════════════════════════════ */
  @media (max-width: 600px) {

    /* Hero */
    .hero {
      padding-top: clamp(4.5rem, 18vh, 7rem);
      padding-bottom: clamp(2.5rem, 6vh, 4rem);
      /* Keep radial glow centred on narrow screens */
      background: radial-gradient(
        ellipse 120% 45% at 50% 38%,
        rgba(16, 107, 102, 0.2) 0%,
        transparent 70%
      );
    }

    .hero-title {
      font-size: clamp(2.2rem, 11vw, 3rem);
      letter-spacing: -0.015em;
    }

    .hero-lead {
      font-size: 0.9rem;
      line-height: 1.8;
      /* Full width on small screens */
      max-width: 100%;
    }

    /* Stack CTA buttons vertically on very small screens */
    .hero-cta {
      flex-direction: column;
      align-items: stretch;
      gap: 0.75rem;
    }
    .btn-primary,
    .btn-ghost {
      justify-content: center;
      width: 100%;
      padding: 0.85rem 1.5rem;
    }

    /* Reduce scroll-hint spacing */
    .scroll-hint { margin-top: 2rem; }
    .scroll-tick  { height: 40px; }

    /* Legends */
    .legends-section {
      padding: clamp(3rem, 8vh, 5rem) var(--space-sm);
    }
    .legends-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .legend-card {
      /* Remove hover lift on touch — feels snappy */
      transition: border-color 0.3s, box-shadow 0.3s;
    }
    .legend-card:hover {
      transform: none;
    }

    /* About strip */
    .about-strip {
      padding: clamp(3rem, 8vh, 5rem) var(--space-sm);
    }
    .about-strip-inner {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }
    .about-strip-tags {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.45rem;
    }
    .strip-body { max-width: 100%; }
  }


  /* ══════════════════════════════════════════
     RESPONSIVE — TINY  (≤ 380px)
  ══════════════════════════════════════════ */
  @media (max-width: 380px) {
    .hero-title { font-size: clamp(1.9rem, 12vw, 2.4rem); }
    .hero-eyebrow { letter-spacing: 0.2em; }
    .section-title { font-size: clamp(1.6rem, 7vw, 2rem); }
  }


  /* ══════════════════════════════════════════
     REDUCE MOTION
  ══════════════════════════════════════════ */
  @media (prefers-reduced-motion: reduce) {
    .anim-item {
      opacity: 1;
      transform: none;
      filter: none;
      transition: none;
    }
    .scroll-tick { animation: none; opacity: 0.35; }
    .btn-primary:hover,
    .btn-ghost:hover,
    .legend-card:hover {
      transform: none;
    }
  }
</style>


<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  // ── Hero items: staggered entrance on load ──────────────────
  const heroItems = document.querySelectorAll(".hero .anim-item");
  heroItems.forEach((el, i) => {
    gsap.fromTo(
      el,
      { opacity: 0, y: 40, scale: 0.97, filter: "blur(6px)" },
      {
        opacity: 1, y: 0, scale: 1, filter: "blur(0px)",
        duration: 1, delay: 0.15 + i * 0.13, ease: "power3.out",
      }
    );
  });

  // ── All other .anim-item: scroll-triggered ──────────────────
  const scrollItems = document.querySelectorAll(
    ".legends-section .anim-item, .about-strip.anim-item, .section-header.anim-item"
  );
  scrollItems.forEach((el, i) => {
    gsap.fromTo(
      el,
      { opacity: 0, y: 50, scale: 0.93, filter: "blur(8px)" },
      {
        opacity: 1, y: 0, scale: 1, filter: "blur(0px)",
        duration: 1, delay: (i % 4) * 0.1, ease: "power3.out",
        scrollTrigger: { trigger: el, start: "top 72%" },
      }
    );
  });

  // ── Legend cards: staggered on scroll ──────────────────────
  const cards = document.querySelectorAll(".legend-card");
  cards.forEach((card, i) => {
    gsap.fromTo(
      card,
      { opacity: 0, y: 60, scale: 0.93, filter: "blur(8px)" },
      {
        opacity: 1, y: 0, scale: 1, filter: "blur(0px)",
        duration: 1, delay: i * 0.12, ease: "power3.out",
        scrollTrigger: { trigger: card, start: "top 75%" },
      }
    );
  });

  // ── Smooth scroll for anchor links ──────────────────────────
  document.querySelectorAll('a[href^="#"]').forEach((link) => {
    link.addEventListener("click", (e) => {
      const target = document.querySelector(
        (e.currentTarget as HTMLAnchorElement).getAttribute("href")!
      );
      if (target) {
        e.preventDefault();
        target.scrollIntoView({ behavior: "smooth" });
      }
    });
  });
</script>
