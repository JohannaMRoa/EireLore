---
// src/pages/GiantsCauseway.astro
import Layout from "../layouts/Layout.astro";

const scenes = [
  {
    body: "On the wild north coast of Ireland lived the mighty giant Fionn mac Cumhaill. He was strong, proud, and known across the land for his courage.",
    imageSrc: "/assets/scenes-GC/scene-01.png",
    imageAlt: "The wild Irish coast",
    bg: "#003828",
  },
  {
    body: "Across the sea in Scotland lived another giant, Benandonner. He boasted loudly and challenged Fionn again and again.",
    imageSrc: "/assets/scenes-GC/scene-02.png",
    imageAlt: "Finn McCool standing on the Antrim cliffs",
    bg: "#002E22",
  },
  {
    body: "Fionn decided he would meet Benandonner face to face. He began tearing great chunks of stone from the earth and throwing them into the sea.",
    imageSrc: "/assets/scenes-GC/scene-03.png",
    imageAlt: "Stormy sea between Ireland and Scotland",
    bg: "#1A3A10",
  },
  {
    body: "Piece by piece, a mighty causeway stretched from Ireland toward Scotland. It looked like a road made for giants alone.",
    imageSrc: "/assets/scenes-GC/scene-04.png",
    imageAlt: "Finn hurling basalt columns into the sea",
    bg: "#2A3800",
  },
  {
    body: "Fionn marched along the causeway, ready for battle. But when he saw Benandonner in the distance, he realized the Scottish giant was far bigger than he expected.",
    imageSrc: "/assets/scenes-GC/scene-05.png",
    imageAlt: "Finn frozen in dread at Benandonner's shadow",
    bg: "#3D2800",
  },
  {
    body: "Fionn rushed home in fear and told his clever wife, Oonagh, what he had seen.",
    imageSrc: "/assets/scenes-GC/scene-06.png",
    imageAlt: "Oonagh with a clever smile disguising Finn",
    bg: "#3D340D",
  },
  {
    body: "Oonagh quickly made a plan to protect him. She dressed Fionn like a baby and placed him in a giant cradle. She covered him with blankets just before Benandonner arrived.",
    imageSrc: "/assets/scenes-GC/scene-07.png",
    imageAlt: "Benandonner staring in horror at Finn in the cradle",
    bg: "#2D1A00",
  },
  {
    body: "When Benandonner entered the house, Oonagh welcomed him and pointed to the cradle: 'Welcome, but please keep your voice down' she whispered. 'The baby is finally asleep'. He stared in amazement at the enormous baby sleeping there — if this is the size of his child, how gigantic must Finn be?",
    imageSrc: "/assets/scenes-GC/scene-08.png",
    imageAlt: "Benandonner staring in the cottage",
    bg: "#1A1200",
  },
  {
    body: "Benandonner thought: if this is the child, then the father must be terrifying. Suddenly afraid, he lost all desire to fight Fionn.",
    imageSrc: "/assets/scenes-GC/scene-09.png",
    imageAlt: "Benandonner realising his mistake",
    bg: "#001A2E",
  },
  {
    body: "Benandonner fled back to Scotland, tearing up the causeway behind him as he ran. That is why only the end of the giant's road remains today, known as the Giant's Causeway.",
    imageSrc: "/assets/scenes-GC/scene-10.png",
    imageAlt: "The Giant's Causeway today",
    bg: "#004435",
  },
];
---

<Layout title="The Giant's Causeway — Éire Lore">
  <main class="giants-page" id="giants-page">

    <!-- BACK BUTTON -->
    <a href="/myths" class="floating-back-btn">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="2"
           stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="19" y1="12" x2="5" y2="12"/>
        <polyline points="12 19 5 12 12 5"/>
      </svg>
      <span>Back to all legends</span>
    </a>

    <!-- SCENE PROGRESS SIDEBAR -->
    <nav class="scene-nav" id="scene-nav" aria-label="Story progress">
      <div class="scene-nav-track">
        <div class="scene-nav-fill" id="scene-nav-fill"></div>
        {scenes.map((_, i) => (
          <button
            class="scene-nav-dot"
            data-target={i}
            aria-label={`Go to scene ${i + 1}`}
          />
        ))}
      </div>
      <span class="scene-counter">
        <span class="scene-counter-current" id="scene-counter-current">01</span>
        <span class="scene-counter-sep">/</span>
        <span class="scene-counter-total">{String(scenes.length).padStart(2, "0")}</span>
      </span>
    </nav>

    <!-- AUDIO -->
    <audio id="story-audio" preload="metadata" style="display:none">
      <source src="/assets/audio/giants.mp3" type="audio/mpeg" />
    </audio>
    <audio id="ambient-audio" preload="metadata" loop style="display:none">
      <source src="/assets/audio/ambient-ocean1.mp3" type="audio/mpeg" />
    </audio>

    <!-- TITLE SECTION -->
    <section class="title-section">

      <div class="hero-banner" aria-hidden="true">
        <img src="/assets/giants-banner.png" alt="" />
      </div>

      <div class="title-inner">

        <p class="title-eyebrow">
          <span class="eyebrow-char" aria-hidden="true">✦</span>
          Irish Legend
          <span class="eyebrow-char" aria-hidden="true">✦</span>
        </p>

        <h1 class="title-heading">
          <span class="title-line" data-line="0">The Giant's</span>
          <em class="title-line title-line--em" data-line="1">Causeway</em>
        </h1>
        <br>
        <div class="title-ctas">
          <button class="cta-primary" id="btn-read">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2.5"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="12" y1="5" x2="12" y2="19"/>
              <polyline points="19 12 12 19 5 12"/>
            </svg>
            <span>Read the story</span>
          </button>

          <button class="cta-secondary" id="btn-play">
            <svg class="icon-play" width="14" height="14" viewBox="0 0 24 24"
                 fill="currentColor" aria-hidden="true">
              <polygon points="5 3 19 12 5 21 5 3"/>
            </svg>
            <svg class="icon-pause" width="14" height="14" viewBox="0 0 24 24"
                 fill="currentColor" aria-hidden="true" style="display:none">
              <rect x="6" y="4" width="4" height="16"/>
              <rect x="14" y="4" width="4" height="16"/>
            </svg>
            <span class="btn-play-label">Play the story</span>
          </button>

          <button class="cta-ambient" id="btn-ambient" title="Toggle ambient sound">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M9 18V5l12-2v13"/>
              <circle cx="6" cy="18" r="3"/>
              <circle cx="18" cy="16" r="3"/>
            </svg>
          </button>
        </div>

        <div class="story-progress" id="story-progress" aria-hidden="true">
          <div class="progress-track" id="progress-track">
            <div class="progress-fill" id="progress-fill"></div>
          </div>
          <span class="progress-time" id="progress-time">0:00</span>
        </div>

        <div class="scroll-hint" aria-hidden="true">
          <div class="scroll-tick"></div>
        </div>

      </div>
    </section>

    <!-- STORY-->
    <section id="story" class="story-section">
      <div class="scenes-wrapper">
        {scenes.map((scene, i) => {
          const flip   = i % 2 !== 0;
          const padded = String(i + 1).padStart(2, "0");

          return (
            <article
              class:list={["scene", { "scene--flip": flip }]}
              data-scene={i}
              data-bg={scene.bg}
              id={`scene-${i}`}
            >
              <div class="scene-image" data-anim="image">
                <img
                  src={scene.imageSrc}
                  alt={scene.imageAlt ?? `Scene ${padded}`}
                  width="800"
                  height="600"
                  loading={i === 0 ? "eager" : "lazy"}
                  decoding="async"
                />
              </div>

              <div class="scene-text">
                <div class="scene-rule" data-anim="rule"></div>
                <p class="scene-body" data-anim="body">{scene.body}</p>
              </div>
            </article>
          );
        })}
      </div>

      <div id="story-outro" class="story-outro"></div>
    </section>


    <section class="outro-section">
      <div class="outro-inner" id="outro-inner">
        <div class="outro-ornament" aria-hidden="true">
          <svg viewBox="0 0 120 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <line x1="0" y1="12" x2="44" y2="12" stroke="#D8A91B" stroke-opacity="0.4" stroke-width="1"/>
            <circle cx="60" cy="12" r="8" stroke="#D8A91B" stroke-opacity="0.5" stroke-width="1"/>
            <circle cx="60" cy="12" r="3" fill="#D8A91B" fill-opacity="0.6"/>
            <line x1="76" y1="12" x2="120" y2="12" stroke="#D8A91B" stroke-opacity="0.4" stroke-width="1"/>
          </svg>
        </div>

        <p class="outro-eyebrow">This legend ends here</p>


        <div class="outro-links">
          <a href="https://open.spotify.com/artist/5n89lGrulTQx7XoN3usNl3?si=LUTK2lIAT7WAzZC1uGWSHA"
             target="_blank" rel="noopener noreferrer"
             class="outro-link" aria-label="Listen to the music">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 18V5l12-2v13"/>
              <circle cx="6" cy="18" r="3"/>
              <circle cx="18" cy="16" r="3"/>
            </svg>
            <span>Listen to<br>the Music</span>
          </a>

          <a href="https://www.lisarichardsagency.com/actors/suzie-seweify/"
             target="_blank" rel="noopener noreferrer"
             class="outro-link" aria-label="Meet the narrator">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/>
              <path d="M19 10v2a7 7 0 0 1-14 0v-2"/>
              <line x1="12" y1="19" x2="12" y2="23"/>
              <line x1="8" y1="23" x2="16" y2="23"/>
            </svg>
            <span>Meet the<br>Narrator</span>
          </a>

          <a href="https://www.hodgesfiggis.ie/book/the-tall-tale-of-the-giants-causeway/lari-don/9781782508151"
             target="_blank" rel="noopener noreferrer"
             class="outro-link" aria-label="Find the book">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
              <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
            </svg>
            <span>Full<br>Story</span>
          </a>
        </div>
        <br>
        <h2 class="outro-heading">More stories <em>await</em></h2>
        <a href="/myths" class="outro-cta">
          <span>Explore all legends</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2"
               stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"/>
            <polyline points="12 5 19 12 12 19"/>
          </svg>
        </a>
      </div>
    </section>

  </main>
</Layout>

<style>

  :root {
    --dark:       #004435;
    --teal:       #106B66;
    --gold:       #D8A91B;
    --sand:       #F1D298;
    --font-title: "Playfair Display", serif;
    --font-body:  "Montserrat", sans-serif;
    --ease:       cubic-bezier(0.22, 1, 0.36, 1);
    --page-bg:    #566409;
    --footer-bg:  #566409;
  }

  :global(html),
  :global(body) {
    overflow-x: hidden;
    background: var(--page-bg);
  }
  :global(footer) { background: var(--footer-bg) !important; }


  .giants-page {
    position: relative;
    overflow-x: hidden;
    background: var(--page-bg);
    transition: background-color 1.4s ease;
  }


  .floating-back-btn {
    position: fixed;
    left: clamp(1rem, 3vw, 2rem);
    bottom: clamp(1rem, 3vw, 2rem);
    z-index: 50;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 1px solid rgba(216,169,27,0.36);
    border-radius: 100px;
    padding: 0.78rem 1.25rem;
    font-family: var(--font-body);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(241,210,152,0.88);
    text-decoration: none;
    background: rgba(0,44,35,0.62);
    backdrop-filter: blur(12px);
    box-shadow: 0 14px 34px rgba(0,0,0,0.38);
    min-height: 44px;
    -webkit-tap-highlight-color: transparent;
    transition: color 0.2s, border-color 0.2s, background 0.2s, transform 0.2s;
  }
  @media (hover: hover) {
    .floating-back-btn:hover {
      color: var(--sand);
      border-color: rgba(216,169,27,0.65);
      background: rgba(0,44,35,0.82);
      transform: translateY(-2px);
    }
  }
  @media (max-width: 520px) {
    .floating-back-btn { padding: 0.72rem 0.9rem; font-size: 0.58rem; max-width: calc(100vw - 2rem); }
  }


  .scene-nav {
    position: fixed;
    right: clamp(0.75rem, 1.8vw, 1.4rem);
    top: 50%;
    transform: translateY(-50%);
    z-index: 40;
    display: flex; flex-direction: column; align-items: center; gap: 0.6rem;
    opacity: 0; pointer-events: none;
    transition: opacity 0.5s ease;
  }
  .scene-nav.visible { opacity: 1; pointer-events: auto; }
  .scene-nav-track {
    position: relative;
    display: flex; flex-direction: column; align-items: center;
    width: 2px; background: rgba(216,169,27,0.15); border-radius: 2px;
  }
  .scene-nav-fill {
    position: absolute; top: 0; left: 0;
    width: 100%; height: 0%;
    background: var(--gold); border-radius: 2px;
    transition: height 0.45s var(--ease);
  }
  .scene-nav-dot {
    position: relative; width: 22px; height: 22px;
    display: flex; align-items: center; justify-content: center;
    background: none; border: none; cursor: pointer; padding: 0;
    -webkit-tap-highlight-color: transparent;
  }
  .scene-nav-dot::after {
    content: ''; display: block; width: 5px; height: 5px;
    border-radius: 50%; background: rgba(216,169,27,0.25);
    transition: background 0.3s, transform 0.3s var(--ease);
  }
  .scene-nav-dot.active::after { background: var(--gold); transform: scale(1.5); }
  .scene-counter {
    display: flex; align-items: baseline; gap: 2px;
    font-family: var(--font-body); font-size: 0.52rem; font-weight: 700;
    letter-spacing: 0.04em; color: rgba(216,169,27,0.5);
  }
  .scene-counter-current { font-size: 0.7rem; color: var(--gold); }
  .scene-counter-sep { opacity: 0.4; }
  @media (max-width: 600px) { .scene-nav { display: none; } }


  .title-section {
    position: relative;
    overflow: hidden;
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: clamp(6rem, 16vh, 10rem) clamp(1.25rem, 5vw, 4rem) clamp(3rem, 6vh, 5rem);
    background: var(--page-bg);
  }


  .title-section::before {
    content: '';
    position: absolute; inset: 0; z-index: 2;
    background:
      radial-gradient(ellipse 80% 60% at 50% 50%, rgba(0,0,0,0.38) 0%, rgba(0,0,0,0.18) 50%, transparent 80%),
      linear-gradient(to bottom, rgba(0,25,16,0.45) 0%, transparent 40%, transparent 60%, rgba(0,25,16,0.55) 100%);
    pointer-events: none;
  }

  .hero-banner {
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .hero-banner img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    display: block;
  }
  @media (max-width: 699px) {
    .hero-banner img { object-position: center top; }
  }

  .title-inner {
    position: relative; z-index: 10;
    display: flex; flex-direction: column; align-items: center;
    gap: clamp(1rem, 2.5vh, 1.8rem); width: 100%;
  }

  .title-eyebrow {
    font-family: var(--font-body);
    font-size: clamp(0.58rem, 2vw, 0.72rem);
    font-weight: 700; letter-spacing: 0.4em; text-transform: uppercase;
    color: var(--gold);
    display: flex; align-items: center; gap: 0.6em;
    opacity: 0; transform: translateY(14px);
    animation: fadeUp 0.9s 0.15s var(--ease) forwards;
    text-shadow: 0 2px 8px rgba(0,0,0,0.75), 0 0 18px rgba(216,169,27,0.45);
  }
  .eyebrow-char { font-size: 0.5em; opacity: 0.55; }

  .title-heading {
    font-family: var(--font-title);
    font-weight: 700; font-size: clamp(2.8rem, 13vw, 9rem);
    line-height: 1.0; color: var(--sand); letter-spacing: -0.01em;
    display: flex; flex-direction: column; align-items: center;
    text-shadow:
      0 6px 0 rgba(0,44,35,0.38),
      0 16px 35px rgba(0,0,0,0.75),
      0 0 42px rgba(0,0,0,0.55);
  }
  .title-line {
    display: block; opacity: 0;
    transform: translateY(32px) skewX(-4deg);
  }
  .title-line[data-line="0"] { animation: titleSlide 1.1s 0.3s  var(--ease) forwards; }
  .title-line[data-line="1"] { animation: titleSlide 1.1s 0.52s var(--ease) forwards; }
  .title-line--em {
    font-style: italic; color: var(--gold);
    text-shadow:
      0 6px 0 rgba(0,44,35,0.35),
      0 16px 36px rgba(0,0,0,0.78),
      0 0 32px rgba(216,169,27,0.42);
  }
  @keyframes titleSlide { to { opacity: 1; transform: translateY(0) skewX(0deg); } }

  /* CTAs */
  .title-ctas {
    display: flex; align-items: center; gap: 0.65rem;
    flex-wrap: wrap; justify-content: center;
    opacity: 0; transform: translateY(14px);
    animation: fadeUp 1s 0.72s var(--ease) forwards;
  }
  .cta-primary, .cta-secondary, .cta-ambient {
    display: inline-flex; align-items: center; gap: 7px;
    border-radius: 100px; font-family: var(--font-body);
    font-size: clamp(0.65rem, 2.5vw, 0.78rem);
    font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase;
    cursor: pointer; border: none;
    transition: background 0.2s, color 0.2s, border-color 0.2s, transform 0.2s;
    min-height: 44px; -webkit-tap-highlight-color: transparent;
  }
  .cta-primary {
    background: var(--gold); color: var(--dark);
    padding: clamp(0.65rem, 2vw, 0.75rem) clamp(1.1rem, 4vw, 1.5rem);
    box-shadow: 0 12px 28px rgba(0,0,0,0.35);
  }
  .cta-secondary {
    background: rgba(0,44,35,0.34); color: rgba(241,210,152,0.9);
    border: 1px solid rgba(216,169,27,0.38); backdrop-filter: blur(8px);
    padding: clamp(0.65rem, 2vw, 0.75rem) clamp(1.1rem, 4vw, 1.5rem);
  }
  .cta-ambient {
    background: rgba(0,44,35,0.34); color: rgba(241,210,152,0.45);
    border: 1px solid rgba(216,169,27,0.2); backdrop-filter: blur(8px);
    padding: 0.75rem 0.9rem;
  }
  .cta-ambient.is-on { color: var(--gold); border-color: rgba(216,169,27,0.5); }
  @media (hover: hover) {
    .cta-primary:hover  { background: var(--sand); transform: translateY(-1px); }
    .cta-secondary:hover { background: rgba(216,169,27,0.08); color: var(--sand); border-color: rgba(216,169,27,0.6); }
    .cta-ambient:hover  { color: var(--gold); border-color: rgba(216,169,27,0.4); }
  }
  .cta-secondary.is-playing { background: rgba(216,169,27,0.1); color: var(--gold); border-color: rgba(216,169,27,0.5); }

  /* Progress bar */
  .story-progress {
    display: flex; align-items: center; gap: 10px;
    opacity: 0; transform: translateY(6px);
    transition: opacity 0.4s ease, transform 0.4s ease;
    pointer-events: none; width: min(90vw, 360px);
  }
  .story-progress.visible { opacity: 1; transform: translateY(0); pointer-events: auto; }
  .progress-track {
    flex: 1; height: 4px; background: rgba(216,169,27,0.18);
    border-radius: 4px; cursor: pointer; position: relative;
    overflow: visible; padding: 8px 0; margin: -8px 0;
  }
  .progress-fill {
    position: absolute; top: 0; left: 0;
    height: 4px; width: 0%; background: var(--gold);
    border-radius: 4px; transition: width 0.25s linear; pointer-events: none;
  }
  .ap-marker {
    position: absolute; top: 0; transform: translate(-50%, 0);
    width: 5px; height: 4px; border-radius: 50%;
    background: rgba(216,169,27,0.45); pointer-events: none;
  }
  .progress-time {
    font-family: var(--font-body); font-size: 0.6rem; font-weight: 600;
    color: rgba(241,210,152,0.6); letter-spacing: 0.05em;
    white-space: nowrap; min-width: 3ch;
  }


  .scroll-hint { opacity: 0; animation: fadeUp 1s 1.1s ease forwards; }
  .scroll-tick {
    width: 1px; height: clamp(24px, 4vh, 40px);
    background: linear-gradient(var(--gold), transparent);
    opacity: 0.4; animation: tickPulse 1.9s ease-in-out infinite;
  }
  @keyframes fadeUp { to { opacity: 1; transform: translateY(0); } }
  @keyframes tickPulse {
    0%, 100% { opacity: 0.12; transform: scaleY(0.5); }
    50%       { opacity: 0.45; transform: scaleY(1); }
  }


  .story-section {
    position: relative; z-index: 2;
    background: transparent;
    padding-top: clamp(3rem, 6vh, 5rem);
  }
  .scenes-wrapper {
    max-width: 1300px; margin: 0 auto;
    padding: 0 clamp(1.25rem, 5vw, 4rem) clamp(3rem, 6vh, 5rem);
  }

  .scene {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-areas: "image" "text";
    gap: clamp(1.25rem, 4vw, 2rem);
    margin-bottom: clamp(3.5rem, 10vh, 7rem);
    position: relative;
  }
  @media (min-width: 700px) {
    .scene {
      grid-template-columns: 30% 1fr;
      grid-template-areas: "image text";
      gap: clamp(2rem, 5vw, 6rem);
      margin-bottom: clamp(5rem, 12vh, 10rem);
      align-items: center;
    }
    .scene--flip { grid-template-columns: 1fr 30%; grid-template-areas: "text image"; }
  }

  .scene.audio-dim    { opacity: 0.28; transition: opacity 0.5s ease; }
  .scene.audio-active { opacity: 1 !important; transition: opacity 0.5s ease; }

  .scene-image { grid-area: image; position: relative; aspect-ratio: 1 / 1; opacity: 0; }
  .scene-image img { width: 100%; height: 100%; object-fit: contain; display: block; }

  .scene-text {
    grid-area: text;
    padding: 0 clamp(1rem, 2vw, 0.5rem);
    text-align: center; display: flex; flex-direction: column; align-items: center;
  }
  .scene-rule {
    width: 250px; height: 2px; background: var(--gold); border-radius: 2px;
    margin-bottom: clamp(0.75rem, 2vh, 1.2rem);
    transform-origin: center center; opacity: 0;
  }
  .scene-body {
    font-family: var(--font-body); font-size: clamp(0.95rem, 2.2vw, 1.25rem);
    line-height: 1.85; color: rgba(241,210,152,0.9); max-width: 44ch;
    text-shadow: 0 2px 20px rgba(0,0,0,0.55); opacity: 0;
  }
  @media (max-width: 699px) { .scene-body { max-width: 100%; } }
  .story-outro { height: 2rem; }


  .outro-section {
    position: relative; z-index: 2;
    background: rgba(0,25,16,0.75);
    padding: clamp(5rem, 12vh, 9rem) clamp(1.5rem, 6vw, 5rem);
    text-align: center; border-top: 1px solid rgba(216,169,27,0.1);
  }
  .outro-inner {
    max-width: 560px; margin: 0 auto;
    display: flex; flex-direction: column; align-items: center;
    gap: clamp(0.9rem, 2vh, 1.4rem);
    opacity: 0; transform: translateY(36px);
    transition: opacity 1s var(--ease), transform 1s var(--ease);
  }
  .outro-inner.visible { opacity: 1; transform: translateY(0); }
  .outro-ornament { width: 110px; opacity: 0.85; }
  .outro-eyebrow {
    font-family: var(--font-body); font-size: 0.63rem; font-weight: 700;
    letter-spacing: 0.35em; text-transform: uppercase; color: var(--gold); opacity: 0.65;
  }
  .outro-heading {
    font-family: var(--font-title); font-size: clamp(2.2rem, 7vw, 4.5rem);
    font-weight: 700; color: var(--sand); line-height: 1.1;
    text-shadow: 0 8px 32px rgba(0,0,0,0.5);
  }
  .outro-heading em { font-style: italic; color: var(--gold); }

  .outro-links {
    display: flex; align-items: center;
    gap: clamp(1.5rem, 5vw, 3rem);
    margin-top: 0.8rem; padding-top: 1.4rem;
  }
  .outro-link {
    display: flex; flex-direction: column; align-items: center; gap: 0.5rem;
    color: rgba(241,210,152,0.45); text-decoration: none;
    font-family: var(--font-body); font-size: 0.58rem; font-weight: 700;
    letter-spacing: 0.18em; text-transform: uppercase;
    transition: color 0.25s ease, transform 0.25s ease;
  }
  .outro-link svg { width: 22px; height: 22px; }
  @media (hover: hover) { .outro-link:hover { color: var(--gold); transform: translateY(-3px); } }

  .outro-cta {
    display: inline-flex; align-items: center; gap: 10px;
    margin-top: 0.4rem; background: var(--gold); color: var(--dark);
    text-decoration: none; font-family: var(--font-body);
    font-size: 0.76rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
    padding: 0.9rem 1.8rem; border-radius: 100px;
    box-shadow: 0 12px 32px rgba(0,0,0,0.35);
    transition: background 0.2s, transform 0.2s; min-height: 44px;
  }
  @media (hover: hover) { .outro-cta:hover { background: var(--sand); transform: translateY(-2px); } }

  @media (max-width: 699px) {
    .title-section { padding-top: clamp(5rem, 14vh, 8rem); padding-bottom: clamp(2rem, 5vh, 4rem); }
    .scenes-wrapper { padding: 0 1.1rem clamp(2rem, 5vh, 4rem); }
    .scene { gap: 0.9rem; margin-bottom: clamp(2.8rem, 8vh, 4.5rem); }
    .scene-image { aspect-ratio: 1 / 1; max-width: 60%; margin: 0 auto; }
    .scene-body { font-size: clamp(0.92rem, 4.2vw, 1.05rem); line-height: 1.75; }
    .scene-text { padding: 0; }
    .story-progress { width: min(85vw, 320px); }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const isTouch = window.matchMedia("(pointer: coarse)").matches;
  const SECONDS_PER_SCENE = 10;

  const page           = document.getElementById("giants-page")           as HTMLElement;
  const audio          = document.getElementById("story-audio")           as HTMLAudioElement;
  const ambientAudio   = document.getElementById("ambient-audio")         as HTMLAudioElement;
  const btnRead        = document.getElementById("btn-read")              as HTMLButtonElement;
  const btnPlay        = document.getElementById("btn-play")              as HTMLButtonElement;
  const btnAmbient     = document.getElementById("btn-ambient")           as HTMLButtonElement;
  const progressWrap   = document.getElementById("story-progress")        as HTMLDivElement;
  const progressTrack  = document.getElementById("progress-track")        as HTMLDivElement;
  const progressFill   = document.getElementById("progress-fill")         as HTMLDivElement;
  const progressTime   = document.getElementById("progress-time")         as HTMLSpanElement;
  const sceneNav       = document.getElementById("scene-nav")             as HTMLElement;
  const navFill        = document.getElementById("scene-nav-fill")        as HTMLElement;
  const counterCurrent = document.getElementById("scene-counter-current") as HTMLElement;
  const outroInner     = document.getElementById("outro-inner")           as HTMLElement;

  const scenes  = document.querySelectorAll<HTMLElement>(".scene");
  const navDots = document.querySelectorAll<HTMLButtonElement>(".scene-nav-dot");
  const TOTAL   = scenes.length;
  const DURATION = SECONDS_PER_SCENE * TOTAL;

  if (!isTouch) {
    const cursorEl = document.createElement("div");
    cursorEl.className = "cursor";
    cursorEl.setAttribute("aria-hidden", "true");
    cursorEl.innerHTML = '<div class="cursor-dot"></div><div class="cursor-ring"></div>';
    document.body.appendChild(cursorEl);
    const cursorDot  = cursorEl.querySelector<HTMLElement>(".cursor-dot")!;
    const cursorRing = cursorEl.querySelector<HTMLElement>(".cursor-ring")!;
    let mx = 0, my = 0, rx = 0, ry = 0;
    document.addEventListener("mousemove", (e) => {
      mx = e.clientX; my = e.clientY;
      cursorDot.style.left = `${mx}px`; cursorDot.style.top = `${my}px`;
    });
    (function lerp() {
      rx += (mx - rx) * 0.11; ry += (my - ry) * 0.11;
      cursorRing.style.left = `${rx}px`; cursorRing.style.top = `${ry}px`;
      requestAnimationFrame(lerp);
    })();
    document.querySelectorAll("a, button, .progress-track").forEach((el) => {
      el.addEventListener("mouseenter", () => cursorEl.classList.add("cursor--hover"));
      el.addEventListener("mouseleave", () => cursorEl.classList.remove("cursor--hover"));
    });
  }

  scenes.forEach((scene) => {
    const bg = scene.dataset.bg;
    if (!bg) return;
    ScrollTrigger.create({
      trigger: scene,
      start: "top 58%",
      onEnter:     () => gsap.to(page, { backgroundColor: bg, duration: 1.4, ease: "power2.out" }),
      onEnterBack: () => gsap.to(page, { backgroundColor: bg, duration: 1.4, ease: "power2.out" }),
    });
  });

  scenes.forEach((_, i) => {
    if (i === 0) return;
    const dot = document.createElement("div");
    dot.className = "ap-marker";
    dot.style.left = `${(i / TOTAL) * 100}%`;
    progressTrack.appendChild(dot);
  });


  ScrollTrigger.create({
    trigger: "#story", start: "top 80%",
    onEnter:     () => sceneNav.classList.add("visible"),
    onLeaveBack: () => sceneNav.classList.remove("visible"),
  });


  function setActive(i: number) {
    navDots.forEach((d, idx) => d.classList.toggle("active", idx === i));
    navFill.style.height = `${TOTAL > 1 ? (i / (TOTAL - 1)) * 100 : 100}%`;
    counterCurrent.textContent = String(i + 1).padStart(2, "0");
  }
  scenes.forEach((scene, i) => {
    ScrollTrigger.create({
      trigger: scene, start: "top 55%", end: "bottom 45%",
      onEnter: () => setActive(i), onEnterBack: () => setActive(i),
    });
  });
  navDots.forEach((dot, i) => {
    dot.addEventListener("click", () => {
      document.getElementById(`scene-${i}`)?.scrollIntoView({ behavior: "smooth", block: "center" });
    });
  });


  scenes.forEach((scene) => {
    const isFlip = scene.classList.contains("scene--flip");
    const img    = scene.querySelector<HTMLElement>("[data-anim='image']");
    const rule   = scene.querySelector<HTMLElement>("[data-anim='rule']");
    const body   = scene.querySelector<HTMLElement>("[data-anim='body']");
    const st: ScrollTrigger.Vars = { trigger: scene, start: "top 82%", toggleActions: "play none none none" };

    if (img) {
      gsap.fromTo(img,
        isTouch ? { opacity: 0, scale: 0.93, y: 32 } : { opacity: 0, scale: 0.9, x: isFlip ? 70 : -70 },
        { opacity: 1, scale: 1, x: 0, y: 0, duration: isTouch ? 0.75 : 1.1, ease: "expo.out", scrollTrigger: st }
      );
    }
    if (rule) {
      gsap.fromTo(rule,
        { opacity: 0, scaleX: 0, transformOrigin: "center center" },
        { opacity: 0.65, scaleX: 1, duration: 3.5, ease: "power3.inOut", scrollTrigger: st, delay: isTouch ? 0.22 : 0.3 }
      );
    }
    if (body) {
      gsap.fromTo(body,
        isTouch ? { opacity: 0, y: 24 } : { opacity: 0, y: 28, rotateX: 8, transformOrigin: "top center" },
        { opacity: 1, y: 0, rotateX: 0, duration: isTouch ? 0.65 : 0.95, ease: "expo.out", scrollTrigger: st, delay: isTouch ? 0.3 : 0.42 }
      );
    }
  });


  if (outroInner) {
    ScrollTrigger.create({
      trigger: outroInner, start: "top 82%",
      onEnter: () => outroInner.classList.add("visible"),
    });
  }

  btnRead.addEventListener("click", () => {
    const target = document.getElementById("story");
    if (!target) return;
    window.scrollTo({ top: target.getBoundingClientRect().top + window.scrollY - 80, behavior: "smooth" });
  });

  const fmt = (s: number) => `${Math.floor(s / 60)}:${Math.floor(s % 60).toString().padStart(2, "0")}`;
  let isPlaying = false, elapsed = 0, rafId: number, lastTick = 0, lastNarrScene = -1;

  function goToScene(index: number) {
    const el = document.getElementById(`scene-${index}`);
    if (!el) return;
    el.scrollIntoView({ behavior: "smooth", block: "center" });
    scenes.forEach((s) => s.classList.remove("audio-active"));
    el.classList.add("audio-active");
  }

  function tick(now: number) {
    if (!isPlaying) return;
    elapsed += (now - lastTick) / 1000; lastTick = now;
    const pct = Math.min((elapsed / DURATION) * 100, 100);
    progressFill.style.width = `${pct}%`;
    progressTime.textContent = fmt(elapsed);
    const idx = Math.min(Math.floor(elapsed / SECONDS_PER_SCENE), TOTAL - 1);
    if (idx !== lastNarrScene) { lastNarrScene = idx; goToScene(idx); }
    if (elapsed >= DURATION) { stop(true); return; }
    rafId = requestAnimationFrame(tick);
  }

  function startNarration() {
    isPlaying = true; lastTick = performance.now();
    audio.play().catch(() => {});
    progressWrap.classList.add("visible");
    progressWrap.setAttribute("aria-hidden", "false");
    btnPlay.classList.add("is-playing");
    (btnPlay.querySelector(".icon-play")  as SVGElement).style.display = "none";
    (btnPlay.querySelector(".icon-pause") as SVGElement).style.display = "";
    (btnPlay.querySelector(".btn-play-label") as HTMLElement).textContent = "Pause";
    scenes.forEach((s) => s.classList.add("audio-dim"));
    const target = document.getElementById("story");
    if (target) window.scrollTo({ top: target.getBoundingClientRect().top + window.scrollY - 80, behavior: "smooth" });
    setTimeout(() => { rafId = requestAnimationFrame(tick); }, 700);
  }

  function stop(finished = false) {
    isPlaying = false; cancelAnimationFrame(rafId); audio.pause();
    scenes.forEach((s) => { s.classList.remove("audio-dim"); s.classList.remove("audio-active"); });
    btnPlay.classList.remove("is-playing");
    (btnPlay.querySelector(".icon-play")  as SVGElement).style.display = "";
    (btnPlay.querySelector(".icon-pause") as SVGElement).style.display = "none";
    (btnPlay.querySelector(".btn-play-label") as HTMLElement).textContent = "Play the story";
    if (finished) progressFill.style.width = "100%";
  }

  btnPlay.addEventListener("click", () => { isPlaying ? stop() : startNarration(); });

  function seekTo(clientX: number) {
    const rect = progressTrack.getBoundingClientRect();
    const pct = Math.max(0, Math.min(1, (clientX - rect.left) / rect.width));
    elapsed = pct * DURATION;
    if (isPlaying) lastTick = performance.now();
    if (audio.duration) audio.currentTime = pct * audio.duration;
    progressFill.style.width = `${pct * 100}%`;
    progressTime.textContent = fmt(elapsed);
    lastNarrScene = -1;
  }
  progressTrack.addEventListener("click", (e) => seekTo(e.clientX));
  progressTrack.addEventListener("touchstart", (e) => { e.preventDefault(); seekTo(e.touches[0].clientX); }, { passive: false });
  progressTrack.addEventListener("touchmove",  (e) => { e.preventDefault(); seekTo(e.touches[0].clientX); }, { passive: false });

  let ambientOn = false;
  btnAmbient.addEventListener("click", () => {
    ambientOn = !ambientOn;
    if (ambientOn) {
      ambientAudio.volume = 0; ambientAudio.play().catch(() => {});
      gsap.to(ambientAudio, { volume: 0.18, duration: 2 });
      btnAmbient.classList.add("is-on");
    } else {
      gsap.to(ambientAudio, { volume: 0, duration: 1.5, onComplete: () => ambientAudio.pause() });
      btnAmbient.classList.remove("is-on");
    }
  });


  window.addEventListener("orientationchange", () => {
    setTimeout(() => ScrollTrigger.refresh(), 300);
  }, { passive: true });
</script>
