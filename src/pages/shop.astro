---
import Layout from "../layouts/Layout.astro";

const collections = [
  "All",
  "T-Shirts",
  "Tote Bags",
  "Figures",
  "Keychains",
  "Posters",
];

const products = [
  {
    title: "Children of Lir Art Tee",
    category: "T-Shirts",
    price: "€24.99",
    image: "/shop/lir-tee.png",
    tag: "New",
  },
  {
    title: "Giant’s Causeway Figure",
    category: "Figures",
    price: "€34.99",
    image: "/shop/giant-figure.png",
    tag: "Featured",
  },
  {
    title: "Banshee Night Poster",
    category: "Posters",
    price: "€14.99",
    image: "/shop/banshee-poster.png",
    tag: "New",
  },
  {
    title: "Éire Lore Tote Bag",
    category: "Tote Bags",
    price: "€18.99",
    image: "/shop/tote-bag.png",
    tag: "Best Pick",
  },
  {
    title: "Fionn Keychain",
    category: "Keychains",
    price: "€8.99",
    image: "/shop/keychain.png",
    tag: "Mini",
  },
];
---

<Layout title="Éire Lore — Shop">
  <main class="shop-page">

    <!-- HERO CAROUSEL -->
    <section class="shop-hero-carousel">
  <div class="shop-slide is-active">
    <div class="shop-slide-content">
      <p class="shop-eyebrow">First Collection</p>
      <h1>The Legends<br /><span>Collection</span></h1>
      <p class="shop-lead">
        Merch inspired by The Children of Lir, The Giant’s Causeway, and The Banshee.
      </p>
      <a href="#products" class="shop-btn">Shop Collection</a>
    </div>

    <div class="shop-slide-art">
      <img src="/myths/children-of-lir.jpeg" alt="Children of Lir" />
      <img src="/myths/giants-causeway.png" alt="Giant's Causeway" />
      <img src="/myths/banshee.jpeg" alt="The Banshee" />
    </div>
  </div>

  <div class="shop-slide">
    <div class="shop-slide-content">
      <p class="shop-eyebrow">Collectible Figures</p>
      <h1>Bring myths<br /><span>to your shelf</span></h1>
      <p class="shop-lead">
        Display small fantasy figures inspired by Irish folklore and legendary characters.
      </p>
      <a href="#products" class="shop-btn">View Figures</a>
    </div>
  </div>

  <div class="shop-slide">
    <div class="shop-slide-content">
      <p class="shop-eyebrow">Posters & Prints</p>
      <h1>Frame the<br /><span>Otherworld</span></h1>
      <p class="shop-lead">
        Illustrated prints and posters designed for folklore lovers and digital heritage fans.
      </p>
      <a href="#products" class="shop-btn">Explore Prints</a>
    </div>
  </div>

  <div class="shop-carousel-controls">
    <button id="shop-prev" type="button" aria-label="Previous slide">‹</button>

    <div class="shop-dots">
      <button class="shop-dot is-active" data-slide="0" aria-label="Slide 1"></button>
      <button class="shop-dot" data-slide="1" aria-label="Slide 2"></button>
      <button class="shop-dot" data-slide="2" aria-label="Slide 3"></button>
    </div>

    <button id="shop-next" type="button" aria-label="Next slide">›</button>
  </div>
</section>

    <!-- COLLECTION FILTERS -->
    <section id="products" class="shop-section">
      <div class="section-header">
        <div class="section-divider-line"></div>
        <p class="shop-eyebrow">Éire Lore Shop</p>
        <h2>Fan favourites</h2>
      </div>

      <div class="shop-filters">
        {collections.map((item) => (
          <button class="shop-filter-btn" data-filter={item}>
            {item}
          </button>
        ))}
      </div>

      <div class="product-grid">
        {products.map((product) => (
          <article class="product-card" data-category={product.category}>
            <div class="product-image">
              <span class="product-tag">{product.tag}</span>
              <img src={product.image} alt={product.title} />
            </div>

            <div class="product-info">
              <p>{product.category}</p>
              <h3>{product.title}</h3>
              <span>{product.price}</span>

              <button type="button">
                Add to cart
              </button>
            </div>
          </article>
        ))}
      </div>
    </section>

  </main>
</Layout>

<style>
  .shop-page {
    min-height: 100vh;
    padding-top: 7rem;
  }

  .shop-hero {
    min-height: 78vh;
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    align-items: center;
    gap: 3rem;
    padding: clamp(3rem, 8vw, 6rem);
    background:
      radial-gradient(circle at 80% 20%, rgba(216, 169, 27, 0.18), transparent 35%),
      linear-gradient(135deg, rgba(0, 68, 53, 0.95), rgba(16, 107, 102, 0.8));
    overflow: hidden;
  }

  .shop-eyebrow {
    font-family: var(--font-body);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-gold);
  }

  .shop-hero h1 {
    margin-top: 1rem;
    font-family: var(--font-title);
    font-size: clamp(3rem, 7vw, 6rem);
    line-height: 0.95;
    color: var(--color-sand);
  }

  .shop-hero h1 span {
    font-style: italic;
    color: var(--color-gold);
  }

  .shop-lead {
    margin-top: 1.5rem;
    max-width: 48ch;
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.8;
    color: rgba(241, 210, 152, 0.72);
  }

  .shop-btn {
    margin-top: 2rem;
    display: inline-flex;
    border-radius: 999px;
    background: var(--color-gold);
    color: var(--color-dark);
    padding: 0.8rem 1.5rem;
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    transition: 0.25s ease;
  }

  .shop-btn:hover {
    background: var(--color-sand);
    transform: translateY(-2px);
  }

  .shop-hero-art {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
  }

  .shop-hero-art img {
    width: min(28vw, 260px);
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: 1.6rem;
    border: 1px solid rgba(216, 169, 27, 0.18);
    box-shadow: 0 30px 70px -35px rgba(0, 0, 0, 0.7);
  }

  .shop-hero-art img:nth-child(1) {
    transform: rotate(-5deg) translateY(20px);
  }

  .shop-hero-art img:nth-child(2) {
    transform: scale(1.08);
  }

  .shop-hero-art img:nth-child(3) {
    transform: rotate(5deg) translateY(20px);
  }

  .shop-section {
    padding: 5rem clamp(1.5rem, 6vw, 3rem) 6rem;
    max-width: 1280px;
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .section-divider-line {
    width: 1px;
    height: 54px;
    background: linear-gradient(var(--color-gold), transparent);
    opacity: 0.45;
    margin: 0 auto 1.5rem;
  }

  .section-header h2 {
    margin-top: 0.6rem;
    font-family: var(--font-title);
    font-size: clamp(2.2rem, 4vw, 3.3rem);
    color: var(--color-sand);
  }

  .shop-filters {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 3rem;
  }

  .shop-filter-btn {
    border: 1px solid rgba(216, 169, 27, 0.25);
    border-radius: 999px;
    background: rgba(0, 44, 35, 0.35);
    padding: 0.55rem 1rem;
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(241, 210, 152, 0.75);
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .shop-filter-btn:hover,
  .shop-filter-btn.is-active {
    background: var(--color-gold);
    color: var(--color-dark);
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .product-card {
    overflow: hidden;
    border-radius: 1.6rem;
    border: 1px solid rgba(216, 169, 27, 0.14);
    background: rgba(0, 44, 35, 0.55);
    box-shadow: 0 20px 48px -28px rgba(0, 0, 0, 0.6);
  }

  .product-image {
    position: relative;
    aspect-ratio: 1 / 1;
    background: rgba(241, 210, 152, 0.08);
  }

  .product-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product-tag {
    position: absolute;
    left: 1rem;
    top: 1rem;
    z-index: 2;
    border-radius: 999px;
    background: var(--color-gold);
    color: var(--color-dark);
    padding: 0.35rem 0.7rem;
    font-family: var(--font-body);
    font-size: 0.62rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .product-info {
    padding: 1.3rem;
  }

  .product-info p {
    font-family: var(--font-body);
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-gold);
  }

  .product-info h3 {
    margin-top: 0.5rem;
    min-height: 3rem;
    font-family: var(--font-title);
    font-size: 1.45rem;
    line-height: 1.1;
    color: var(--color-sand);
  }

  .product-info span {
    display: block;
    margin-top: 1rem;
    font-family: var(--font-body);
    color: rgba(241, 210, 152, 0.8);
  }

  .product-info button {
    margin-top: 1.3rem;
    width: 100%;
    border: 0;
    border-radius: 999px;
    background: rgba(241, 210, 152, 0.1);
    color: var(--color-sand);
    padding: 0.8rem 1rem;
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    transition: 0.25s ease;
  }

  .product-info button:hover {
    background: var(--color-gold);
    color: var(--color-dark);
  }

  @media (max-width: 1050px) {
    .shop-hero {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .shop-lead {
      margin-left: auto;
      margin-right: auto;
    }

    .product-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .product-grid {
      grid-template-columns: 1fr;
    }

    .shop-hero-art {
      flex-direction: column;
    }

    .shop-hero-art img {
      width: 70vw;
      transform: none !important;
    }
  }

  .shop-hero-carousel {
  position: relative;
  min-height: 78vh;
  margin: 0 clamp(1rem, 3vw, 2rem);
  overflow: hidden;
  border-radius: 1.6rem;
  background:
    radial-gradient(circle at 80% 20%, rgba(216, 169, 27, 0.18), transparent 35%),
    linear-gradient(135deg, rgba(0, 68, 53, 0.95), rgba(16, 107, 102, 0.8));
}

.shop-slide {
  position: absolute;
  inset: 0;
  display: grid;
  grid-template-columns: 0.9fr 1.1fr;
  align-items: center;
  gap: 3rem;
  padding: clamp(3rem, 8vw, 6rem);
  opacity: 0;
  pointer-events: none;
  transform: scale(1.02);
  transition: opacity 0.6s ease, transform 0.6s ease;
}

.shop-slide.is-active {
  opacity: 1;
  pointer-events: auto;
  transform: scale(1);
}

.shop-slide-content {
  z-index: 2;
}

.shop-slide h1 {
  margin-top: 1rem;
  font-family: var(--font-title);
  font-size: clamp(3rem, 7vw, 6rem);
  line-height: 0.95;
  color: var(--color-sand);
}

.shop-slide h1 span {
  font-style: italic;
  color: var(--color-gold);
}

.shop-slide-art {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 1rem;
}

.shop-slide-art img {
  width: min(28vw, 260px);
  aspect-ratio: 3 / 4;
  object-fit: cover;
  border-radius: 1.6rem;
  border: 1px solid rgba(216, 169, 27, 0.18);
  box-shadow: 0 30px 70px -35px rgba(0, 0, 0, 0.7);
}

.shop-slide-art img:nth-child(1) {
  transform: rotate(-5deg) translateY(20px);
}

.shop-slide-art img:nth-child(2) {
  transform: scale(1.08);
}

.shop-slide-art img:nth-child(3) {
  transform: rotate(5deg) translateY(20px);
}

.shop-carousel-controls {
  position: absolute;
  left: 50%;
  bottom: 1.6rem;
  z-index: 5;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  gap: 1.2rem;
}

.shop-carousel-controls button {
  border: 0;
  background: transparent;
  color: var(--color-sand);
  cursor: pointer;
}

#shop-prev,
#shop-next {
  font-size: 2.5rem;
  line-height: 1;
  transition: color 0.25s ease, transform 0.25s ease;
}

#shop-prev:hover,
#shop-next:hover {
  color: var(--color-gold);
  transform: scale(1.1);
}

.shop-dots {
  display: flex;
  align-items: center;
  gap: 0.6rem;
}

.shop-dot {
  width: 9px;
  height: 9px;
  border-radius: 999px;
  background: rgba(241, 210, 152, 0.45);
  transition: all 0.25s ease;
}

.shop-dot.is-active {
  width: 13px;
  height: 13px;
  background: var(--color-gold);
}

@media (max-width: 900px) {
  .shop-slide {
    grid-template-columns: 1fr;
    text-align: center;
  }

  .shop-lead {
    margin-left: auto;
    margin-right: auto;
  }

  .shop-slide-art img {
    width: 28vw;
  }
}
</style>


<script>
  const slides = document.querySelectorAll(".shop-slide");
  const dots = document.querySelectorAll(".shop-dot");
  const prevBtn = document.getElementById("shop-prev");
  const nextBtn = document.getElementById("shop-next");

  let currentSlide = 0;

  function showSlide(index) {
    currentSlide = (index + slides.length) % slides.length;

    slides.forEach((slide) => slide.classList.remove("is-active"));
    dots.forEach((dot) => dot.classList.remove("is-active"));

    slides[currentSlide]?.classList.add("is-active");
    dots[currentSlide]?.classList.add("is-active");
  }

  prevBtn?.addEventListener("click", () => {
    showSlide(currentSlide - 1);
  });

  nextBtn?.addEventListener("click", () => {
    showSlide(currentSlide + 1);
  });

  dots.forEach((dot) => {
    dot.addEventListener("click", () => {
      showSlide(Number(dot.dataset.slide));
    });
  });
</script>
